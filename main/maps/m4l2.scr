$kar98sniper remove
$t162 remove
$t163 remove
$trainswitch1_pulsating remove
// $trainswitch1 remove
$leftgate01 remove
$rightgate01 remove
$engine remove
$car01 remove
$car02 remove
$car03 remove
$car04 remove
$car05 remove
$car06 remove
$trainkill_trigger nottriggerable
$bunkerdoor1 unlock
$bunkerdoor2 unlock
$trainclip remove
$getawaytruckclip remove

$elevator_switch remove

	// call additional stuff for playing this map round based is needed
	if(level.roundbased)
		thread roundbasedthread

	// load support gun sounds
	waitthread global/support/support.scr::soundcache
	
// exec global/spotlight.scr

	level waittill prespawn

	exec global/loadout.scr "maps/m4l2.scr"
	exec global/DMprecache.scr
	exec global/jv_sound.scr
	exec global/door_locked.scr
	exec global/shutter.scr

	exec global/ambient.scr m4l1

	level.script = maps/m4l2.scr

	thread global/exploder.scr::main
	thread global/door_locked.scr::lock
	thread global/barrel.scr::explosive_barrel

	if(int(getcvar "hold") != 0)  
	{
		//setup
		local.o = ( -2015 1160 70 ) // your trigger origin -2085 1160 120
		local.sa = ( -659 -242 50 )  // your trigger setsize minus -589 -242 -1 
		local.sb = ( 510 242 60 )  // your trigger setsize plus 589 242 50
		local.mes[1] = "Capture and hold the Bunker" //global message 1
		local.mes[2] = "the Bunker is west of the train tunnel" //global message 2
		local.mes[3] = "Bunker" // "xteam occupies the" local.mes[3]
		local.mes[4] = "Hold the Bunker"  //objective and title - "Capture and" local.mes[4]
		local.mes[5] = "by <TWL>ViPER"  //for scoreboard
		local.mes[6] = "Hold the Bunker" //abv. title for hud
		local.mes[7] = "at tunnel" //for hud
		local.tp[1] = 15  //time for point - hold
		local.tp[2] = 12   //time for point - point mode    (local.tp[4]*local.tp[2]must exceed 60 sec)
		local.tp[3] = 90  //time for win - imperative mode (minimum 60 sec)
		local.tp[4] = 20   //points for win - point mode
		local.tp[5] = 18  //timelimit for point mode (mins//.1 = off)
		local.tp[6] = 22  //timelimit for imperative mode (mins//.1 = off)
		local.tp[7] = 15  //timelimit for hold (mins)

		local.cinversion = 15 //reset default

		setcvar cinversion local.cinversion
	}                                    //           Thats it!
	
	//$world farplane 2000
	exec global/random_fog.scr
	
	////////////////////////////
	level waittill spawn ///////
	////////////////////////////

	level.squadmaker_areaname = "in the station"

	// start support gunner scripts
	exec global/support/support.scr

	// start squadmaker
	exec global/squadmaker/squadmaker.scr
	
	if(int(getcvar "hold") != 0)   
	{
		exec global/strategic.scr local.o local.sa local.sb local.mes local.tp
		thread fix
	}

	exec global/Strategic_common.scr

local.origin = $spotguy01.origin
local.angles = $spotguy01.angles

// exec global/spotlight.scr::corona $camptruck "light left" 	// Turn on camptruck coronas
// exec global/spotlight.scr::corona $camptruck "light right"

$fakecamptruck_spot.origin = ( 7226 1943 -323 )

