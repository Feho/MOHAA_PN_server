// step 1..9: allies go alh->al9, axis go ax9->axh (same geographic direction)
// 2 consecutive groups active per team at each step for enough spawn points
// level.reversed=1 flips: allies go al9->alh, axis go axh->ax9
setup:

	// disable all spawn groups
	$alh disablespawn
	$al2 disablespawn
	$al3 disablespawn
	$al4 disablespawn
	$al5 disablespawn
	$al6 disablespawn
	$al7 disablespawn
	$al8 disablespawn
	$al9 disablespawn
	$axh disablespawn
	$ax2 disablespawn
	$ax3 disablespawn
	$ax4 disablespawn
	$ax5 disablespawn
	$ax6 disablespawn
	$ax7 disablespawn
	$ax8 disablespawn
	$ax9 disablespawn

	level.step = 1
	level.gain_ground_interval = 150

	// 50% chance of reversed direction
	if (randomint(2) == 0)
	{
		level.reversed = 0
		// step 1 normal: allies = alh+al2 (step 1), axis = ax6+ax5 (step 4)
		$alh enablespawn
		$al2 enablespawn
		$ax6 enablespawn
		$ax5 enablespawn
		iprintlnbold "Front line advancing from Allied side !"
	}
	else
	{
		level.reversed = 1
		// step 1 reversed: axis = axh+ax2 (step 1), allies = al6+al5 (step 4)
		$axh enablespawn
		$ax2 enablespawn
		$al6 enablespawn
		$al5 enablespawn
		iprintlnbold "Front line advancing from Axis side !"
	}

end


// Advance level.step from 1 to 6 every gain_ground_interval seconds
timer:

while(1)
{
	wait level.gain_ground_interval
	if (level.step < 6)
	{
		level.step++
	}
}

end


// Apply spawn groups for current step, accounting for direction
// Normal:   allies step N (alh..al9), axis step N+3 capped (ax9..axh)
// Reversed: axis step N (axh..ax9),   allies step N+3 capped (al9..alh)
// Gap of 3 steps keeps teams apart on the map
spawnswitch:

local.last_step = 0
while(1)
{
	if (level.step != local.last_step)
	{
	local.last_step = level.step
	if (level.reversed == 0)
	{
		switch(level.step)
		{
		case 1:
			// allies: step 1 = alh+al2  |  axis: step 4 = ax6+ax5
			$alh enablespawn
			$al2 enablespawn
			$al3 disablespawn
			$al4 disablespawn
			$al5 disablespawn
			$al6 disablespawn
			$al7 disablespawn
			$al8 disablespawn
			$al9 disablespawn
			$ax9 disablespawn
			$ax8 disablespawn
			$ax7 disablespawn
			$ax6 enablespawn
			$ax5 enablespawn
			$ax4 disablespawn
			$ax3 disablespawn
			$ax2 disablespawn
			$axh disablespawn
			;break
		case 2:
			// allies: step 2 = al2+al3  |  axis: step 5 = ax5+ax4
			$alh disablespawn
			$al2 enablespawn
			$al3 enablespawn
			$al4 disablespawn
			$al5 disablespawn
			$al6 disablespawn
			$al7 disablespawn
			$al8 disablespawn
			$al9 disablespawn
			$ax9 disablespawn
			$ax8 disablespawn
			$ax7 disablespawn
			$ax6 disablespawn
			$ax5 enablespawn
			$ax4 enablespawn
			$ax3 disablespawn
			$ax2 disablespawn
			$axh disablespawn
			;break
		case 3:
			// allies: step 3 = al3+al4  |  axis: step 6 = ax4+ax3
			$alh disablespawn
			$al2 disablespawn
			$al3 enablespawn
			$al4 enablespawn
			$al5 disablespawn
			$al6 disablespawn
			$al7 disablespawn
			$al8 disablespawn
			$al9 disablespawn
			$ax9 disablespawn
			$ax8 disablespawn
			$ax7 disablespawn
			$ax6 disablespawn
			$ax5 disablespawn
			$ax4 enablespawn
			$ax3 enablespawn
			$ax2 disablespawn
			$axh disablespawn
			;break
		case 4:
			// allies: step 4 = al4+al5  |  axis: step 7 = ax3+ax2
			$alh disablespawn
			$al2 disablespawn
			$al3 disablespawn
			$al4 enablespawn
			$al5 enablespawn
			$al6 disablespawn
			$al7 disablespawn
			$al8 disablespawn
			$al9 disablespawn
			$ax9 disablespawn
			$ax8 disablespawn
			$ax7 disablespawn
			$ax6 disablespawn
			$ax5 disablespawn
			$ax4 disablespawn
			$ax3 enablespawn
			$ax2 enablespawn
			$axh disablespawn
			;break
		case 5:
			// allies: step 5 = al5+al6  |  axis: step 8 = ax2+axh
			$alh disablespawn
			$al2 disablespawn
			$al3 disablespawn
			$al4 disablespawn
			$al5 enablespawn
			$al6 enablespawn
			$al7 disablespawn
			$al8 disablespawn
			$al9 disablespawn
			$ax9 disablespawn
			$ax8 disablespawn
			$ax7 disablespawn
			$ax6 disablespawn
			$ax5 disablespawn
			$ax4 disablespawn
			$ax3 disablespawn
			$ax2 enablespawn
			$axh enablespawn
			;break
		case 6:
			// allies: step 6 = al6+al7  |  axis: step 9 (cap) = ax2+axh
			$alh disablespawn
			$al2 disablespawn
			$al3 disablespawn
			$al4 disablespawn
			$al5 disablespawn
			$al6 enablespawn
			$al7 enablespawn
			$al8 disablespawn
			$al9 disablespawn
			$ax9 disablespawn
			$ax8 disablespawn
			$ax7 disablespawn
