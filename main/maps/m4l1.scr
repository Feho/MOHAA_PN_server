			$ax5 disablespawn
			$ax4 disablespawn
			$ax3 disablespawn
			$ax2 enablespawn
			$axh enablespawn
			;break
		}
	}
	else
	{
		// reversed: axis step N (axh..ax9), allies step N+3 capped (al9..alh)
		switch(level.step)
		{
		case 1:
			// axis: step 1 = axh+ax2  |  allies: step 4 = al6+al5
			$al9 disablespawn
			$al8 disablespawn
