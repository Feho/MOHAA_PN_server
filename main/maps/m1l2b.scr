			$ax6 disablespawn
			$ax5 disablespawn
			$ax4 disablespawn
			$ax3 disablespawn
			$ax2 enablespawn
			$axh enablespawn
			;break
		}
	}
	else
	{
		// reversed: axis step N (axh..ax9), allies step N+3 capped (al9..alh)
		switch(level.step)
		{
		case 1:
			// axis: step 1 = axh+ax2  |  allies: step 4 = al6+al5
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 enablespawn
			$al5 enablespawn
			$al4 disablespawn
			$al3 disablespawn
			$al2 disablespawn
			$alh disablespawn
			$axh enablespawn
			$ax2 enablespawn
			$ax3 disablespawn
			$ax4 disablespawn
			$ax5 disablespawn
			$ax6 disablespawn
			$ax7 disablespawn
			$ax8 disablespawn
			$ax9 disablespawn
			;break
		case 2:
			// axis: step 2 = ax2+ax3  |  allies: step 5 = al5+al4
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 disablespawn
			$al5 enablespawn
			$al4 enablespawn
			$al3 disablespawn
			$al2 disablespawn
			$alh disablespawn
			$axh disablespawn
			$ax2 enablespawn
			$ax3 enablespawn
			$ax4 disablespawn
			$ax5 disablespawn
			$ax6 disablespawn
			$ax7 disablespawn
			$ax8 disablespawn
			$ax9 disablespawn
			;break
		case 3:
			// axis: step 3 = ax3+ax4  |  allies: step 6 = al4+al3
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 disablespawn
			$al5 disablespawn
			$al4 enablespawn
			$al3 enablespawn
			$al2 disablespawn
			$alh disablespawn
			$axh disablespawn
			$ax2 disablespawn
			$ax3 enablespawn
			$ax4 enablespawn
			$ax5 disablespawn
			$ax6 disablespawn
			$ax7 disablespawn
			$ax8 disablespawn
			$ax9 disablespawn
			;break
		case 4:
			// axis: step 4 = ax4+ax5  |  allies: step 7 = al3+al2
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 disablespawn
			$al5 disablespawn
			$al4 disablespawn
			$al3 enablespawn
			$al2 enablespawn
			$alh disablespawn
			$axh disablespawn
			$ax2 disablespawn
			$ax3 disablespawn
			$ax4 enablespawn
			$ax5 enablespawn
			$ax6 disablespawn
			$ax7 disablespawn
			$ax8 disablespawn
			$ax9 disablespawn
			;break
		case 5:
			// axis: step 5 = ax5+ax6  |  allies: step 8 = al2+alh
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 disablespawn
			$al5 disablespawn
			$al4 disablespawn
			$al3 disablespawn
			$al2 enablespawn
			$alh enablespawn
			$axh disablespawn
			$ax2 disablespawn
			$ax3 disablespawn
			$ax4 disablespawn
			$ax5 enablespawn
			$ax6 enablespawn
			$ax7 disablespawn
			$ax8 disablespawn
			$ax9 disablespawn
			;break
		case 6:
			// axis: step 6 = ax6+ax7  |  allies: step 9 (cap) = al2+alh
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 disablespawn
			$al5 disablespawn
			$al4 disablespawn
			$al3 disablespawn
			$al2 enablespawn
			$alh enablespawn
			$axh disablespawn
			$ax2 disablespawn
			$ax3 disablespawn
			$ax4 disablespawn
			$ax5 disablespawn
			$ax6 enablespawn
			$ax7 enablespawn
			$ax8 disablespawn
			$ax9 disablespawn
			;break
		case 7:
			// axis: step 7 = ax7+ax8  |  allies: step 9 (cap) = al2+alh
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 disablespawn
			$al5 disablespawn
			$al4 disablespawn
			$al3 disablespawn
			$al2 enablespawn
			$alh enablespawn
			$axh disablespawn
			$ax2 disablespawn
			$ax3 disablespawn
			$ax4 disablespawn
			$ax5 disablespawn
			$ax6 disablespawn
			$ax7 enablespawn
			$ax8 enablespawn
			$ax9 disablespawn
			;break
		case 8:
			// axis: step 8 = ax8+ax9  |  allies: step 9 (cap) = al2+alh
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 disablespawn
			$al5 disablespawn
			$al4 disablespawn
			$al3 disablespawn
			$al2 enablespawn
			$alh enablespawn
			$axh disablespawn
			$ax2 disablespawn
			$ax3 disablespawn
			$ax4 disablespawn
			$ax5 disablespawn
			$ax6 disablespawn
			$ax7 disablespawn
			$ax8 enablespawn
			$ax9 enablespawn
			;break
		case 9:
			// axis: step 9 (cap) = ax8+ax9  |  allies: step 9 (cap) = al2+alh
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 disablespawn
			$al5 disablespawn
			$al4 disablespawn
			$al3 disablespawn
			$al2 enablespawn
			$alh enablespawn
			$axh disablespawn
			$ax2 disablespawn
			$ax3 disablespawn
			$ax4 disablespawn
			$ax5 disablespawn
			$ax6 disablespawn
			$ax7 disablespawn
			$ax8 enablespawn
			$ax9 enablespawn
			;break
		}
	}
	thread dispatch_bots
	}

	wait 2
}

end

//-----------------------------------------------------------------------------

// Send allied bots toward the leading axis spawn, and axis bots toward the leading allied spawn
dispatch_bots:

local.allies_target = NIL
local.axis_target = NIL

if (level.reversed == 0)
{
	// normal: allies advance alh->al9, axis advance ax9->axh
	// allied bots attack the leading axis spawn (most advanced = lowest ax index active)
	// axis bots attack the leading allied spawn (most advanced = highest al index active)
	switch(level.step)
	{
	case 1:
		local.allies_target = level.spawn_ax6
		local.axis_target = level.spawn_al2
		;break
	case 2:
		local.allies_target = level.spawn_ax5
		local.axis_target = level.spawn_al3
		;break
	case 3:
		local.allies_target = level.spawn_ax4
		local.axis_target = level.spawn_al4
		;break
	case 4:
		local.allies_target = level.spawn_ax3
		local.axis_target = level.spawn_al5
		;break
	case 5:
		local.allies_target = level.spawn_ax2
		local.axis_target = level.spawn_al6
		;break
	case 6:
		local.allies_target = level.spawn_ax2
		local.axis_target = level.spawn_al7
		;break
	case 7:
		local.allies_target = level.spawn_ax2
		local.axis_target = level.spawn_al8
		;break
	case 8:
		local.allies_target = level.spawn_axh
		local.axis_target = level.spawn_al9
		;break
	case 9:
		local.allies_target = level.spawn_axh
		local.axis_target = level.spawn_al9
		;break
	}
}
else
{
	// reversed: axis advance axh->ax9, allies advance al9->alh
	// allied bots attack the leading axis spawn (most advanced = highest ax index active)
	// axis bots attack the leading allied spawn (most advanced = lowest al index active)
	switch(level.step)
	{
	case 1:
		local.allies_target = level.spawn_ax2
		local.axis_target = level.spawn_al6
		;break
	case 2:
		local.allies_target = level.spawn_ax3
		local.axis_target = level.spawn_al5
		;break
	case 3:
		local.allies_target = level.spawn_ax4
		local.axis_target = level.spawn_al4
		;break
	case 4:
		local.allies_target = level.spawn_ax5
		local.axis_target = level.spawn_al3
		;break
	case 5:
		local.allies_target = level.spawn_ax6
		local.axis_target = level.spawn_al2
		;break
	case 6:
		local.allies_target = level.spawn_ax7
		local.axis_target = level.spawn_al2
		;break
	case 7:
		local.allies_target = level.spawn_ax8
		local.axis_target = level.spawn_alh
		;break
	case 8:
		local.allies_target = level.spawn_ax9
		local.axis_target = level.spawn_alh
		;break
	case 9:
		local.allies_target = level.spawn_ax9
		local.axis_target = level.spawn_alh
		;break
	}
}

for (local.i = 1; local.i <= $player.size; local.i++)
{
	if (isBot $player[local.i])
	{
		if ($player[local.i].dmteam == "allies" && local.allies_target != NIL)
			$player[local.i] bot_movenear local.allies_target.origin 128
		else if ($player[local.i].dmteam == "axis" && local.axis_target != NIL)
			$player[local.i] bot_movenear local.axis_target.origin 128
	}
}

end

eventeams:

wait 30

while(1)
   {
   level.allies = 0
   level.axis = 0
   for(local.dude=1;local.dude <= $player.size;local.dude++)
   {
   if ($player[local.dude].dmteam == "axis")
   level.axis++
   if ($player[local.dude].dmteam == "allies")
   level.allies++
   }
	setcvar axiscount level.axis
	setcvar alliescount level.allies

     if((level.allies > ( level.axis + 1 )) || (level.axis > ( level.allies + 1 )))
     {
	huddraw_virtualsize 214 1
	huddraw_align  214 right top
	huddraw_font   214 "verdana-12"
	huddraw_rect   214 -100 40 200 14
	huddraw_color  214 .10 .95 .10
	huddraw_alpha  214 1.0
	huddraw_string 214 "TEAMS"

	huddraw_virtualsize 215 1
	huddraw_shader 215 ("textures/hud/allies")
	huddraw_align  215 right top
	huddraw_rect   215 -60 40 14 14
	huddraw_alpha  215 1.0

	huddraw_virtualsize 216 1
	huddraw_shader 216 ("textures/hud/axis")
	huddraw_align  216 right top
	huddraw_rect   216 -30 40 14 14
	huddraw_alpha  216 1.0

	huddraw_virtualsize 217 1
	huddraw_align  217 right top
	huddraw_font   217 "verdana-12"
	huddraw_rect   217 -45 40 20 14
	huddraw_color  217 .10 .95 .10
	huddraw_alpha  217 1.0
	huddraw_string 217 level.allies

	huddraw_virtualsize 218 1
	huddraw_align  218 right top
	huddraw_font   218 "verdana-12"
	huddraw_rect   218 -15 40 20 14
	huddraw_color  218 .10 .95 .10
	huddraw_alpha  218 1.0
	huddraw_string 218 level.axis

     }

   wait 2
	huddraw_alpha  214 0
	huddraw_alpha  215 0
	huddraw_alpha  216 0
	huddraw_alpha  217 0
	huddraw_alpha  218 0
   wait 1
   }
end
