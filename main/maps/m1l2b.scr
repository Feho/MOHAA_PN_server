//
// M1L2B - Sabotage the Motorpool
// Time-based Gain Ground variant: front line advances in same direction each round
// 50% chance of reversed direction each game
//


main:

	setcvar "timelimit" "15"

	setcvar "g_gametype" "2"

	if ((getcvar("g_gametype") == "1"))
	{
		waitthread ffatype
		end
	}
	else
	{
		waitthread tdmtype
		end
	}
end



tdmtype:

	setcvar "g_obj_alliedtext1" "Map Name: M1L2B"
	setcvar "g_obj_alliedtext2" ""
	setcvar "g_obj_alliedtext3" "Sabotage the Motorpool"

	setcvar "g_obj_axistext1" ""
	setcvar "g_obj_axistext2" ""
	setcvar "g_obj_axistext3" ""

	setcvar "g_scoreboardpic" "textures/mohmenu/briefing/briefing1a.tga"

	setcvar "g_gametype" "4"
	setcvar "g_gametypestring" "Team-Match"
		// load support gun sounds
	waitthread global/support/support.scr::soundcache

	waitthread tdm_spawns
	waitthread set_da_stuff_up

	level waittill prespawn

	exec global/door_locked.scr
	exec global/ambient.scr m1l2b
	exec global/DMprecache.scr

	thread global/barrel.scr::explosive_barrel

	local.info = makeArray
		( -21 2197 -253 ) ( 0 0 0 ) "random" 1
 	endArray

	thread global/AIR_gold.scr::treasure_spawn local.info

	local.mur = spawn script_object
	local.mur.origin = ( 2408 -2489 -125)
	local.mur.angle = 180
	local.mur setsize ( -1 -10 -96) ( 1 200 96)
	local.mur solid	level waittill spawn

	level.squadmaker_areaname = "sabotaging the motorpool"
	level.squadmaker_config = "afrika"

	// start support gunner scripts
	exec global/support/support.scr

	// start squadmaker
	exec global/squadmaker/squadmaker.scr

	thread setup
	thread timer
	thread eventeams
	thread spawnswitch

	// start tickets mode
	exec global/feho/tickets.scr

	level.clockside = kills

	// Fix bots spawn
	wait 1

	for (local.i = 1; local.i <= $player.size; local.i++)
	{
		if (isBot $player[local.i])
		{
			$player[local.i] respawn
			wait 0.2
		}
	}

	wait 4
	thread dispatch_bots

end




ffatype:

	setcvar "g_obj_alliedtext1" "Map Name: M1L2B"
	setcvar "g_obj_alliedtext2" ""
	setcvar "g_obj_alliedtext3" "Sabotage the Motorpool"

	setcvar "g_obj_axistext1" ""
	setcvar "g_obj_axistext2" ""
	setcvar "g_obj_axistext3" "Visit www.Mods-R-us.net"

	setcvar "g_scoreboardpic" "textures/mohmenu/briefing/briefing1a.tga"

	setcvar "g_gametype" "1"
	setcvar "g_gametypestring" "Free-For-All"	waitthread ffa_spawns
	waitthread set_da_stuff_up

	// load support gun sounds
	waitthread global/support/support.scr::soundcache

	level waittill prespawn

	exec global/door_locked.scr
	exec global/ambient.scr m1l2b
	exec global/DMprecache.scr
		level waittill spawn

	level.squadmaker_areaname = "sabotaging the motorpool"

	// start support gunner scripts
	exec global/support/support.scr

	// start squadmaker
	exec global/squadmaker/squadmaker.scr

	// start tickets mode
	exec global/feho/tickets.scr

	level.clockside = kills

end




