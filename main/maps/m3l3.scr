scrollMsg local.messagetosay:

	huddraw_align 223 left center
	huddraw_font 223 facfont-20
	huddraw_alpha 223 1

	huddraw_color 223 1 1 1

	huddraw_rect 223 20 150 200 40
	huddraw_string 223 local.messagetosay

	for(local.i=1;local.i<=local.messagetosay.size;local.i++)
	{
	local.x = ""
	for(local.z=1;local.z<=(local.messagetosay.size - local.i);local.z++)
	{
	local.x = (local.x + " ")
	}
	local.tmpstring4 = ""
	for (local.o=0;local.o<local.i;local.o++) local.tmpstring4 = local.tmpstring4 + local.messagetosay[local.o]
	huddraw_string 223 (local.x + local.tmpstring4)
	wait .03
	}
	wait 3
	for (local.o=1;local.o>0;local.o=local.o - 0.01)
	{
	huddraw_alpha 223 local.o
	wait 0.05
	}
	huddraw_alpha 223 0
end

// step 1..6: allies go alh->al6+al7, axis go ax6+ax5->ax2+axh (same geographic direction)
// 2 consecutive groups active per team, gap of 3 between teams
// level.reversed=1 flips: allies go al9->alh, axis go axh->ax9
setup:

	// disable all spawn groups
	$alh disablespawn
	$al2 disablespawn
	$al3 disablespawn
	$al4 disablespawn
	$al5 disablespawn
	$al6 disablespawn
	$al7 disablespawn
	$al8 disablespawn
	$al9 disablespawn
	$axh disablespawn
	$ax2 disablespawn
	$ax3 disablespawn
	$ax4 disablespawn
	$ax5 disablespawn
	$ax6 disablespawn
	$ax7 disablespawn
	$ax8 disablespawn
	$ax9 disablespawn

	level.step = 1
	level.gain_ground_interval = 240

	// 50% chance of reversed direction
	if (randomint(2) == 0)
	{
		level.reversed = 0
		// step 1 normal: allies = alh+al2, axis = ax6+ax5 (gap of 3)
		$alh enablespawn
		$al2 enablespawn
		$ax6 enablespawn
		$ax5 enablespawn
		iprintlnbold "Front line advancing from Allied side !"
	}
	else
	{
		level.reversed = 1
		// step 1 reversed: axis = axh+ax2, allies = al6+al5 (gap of 3)
		$axh enablespawn
		$ax2 enablespawn
		$al6 enablespawn
		$al5 enablespawn
		iprintlnbold "Front line advancing from Axis side !"
	}

end


// Advance level.step from 1 to 6 every gain_ground_interval seconds
timer:

while(1)
{
	wait level.gain_ground_interval
	if (level.step < 6)
	{
		level.step++
	}
}

end


// Apply spawn groups for current step, accounting for direction
// Normal:   allies step N (alh..al7), axis step N+3 capped (ax6..axh)
// Reversed: axis step N (axh..ax7),   allies step N+3 capped (al6..alh)
// Gap of 3 steps keeps teams apart on the map
spawnswitch:

local.last_step = 0
while(1)
{
	if (level.step != local.last_step)
	{
	local.last_step = level.step
	if (level.reversed == 0)
	{
		switch(level.step)
		{
		case 1:
			// allies: alh+al2  |  axis: ax6+ax5
			$alh enablespawn
			$al2 enablespawn
			$al3 disablespawn
			$al4 disablespawn
			$al5 disablespawn
			$al6 disablespawn
			$al7 disablespawn
			$al8 disablespawn
			$al9 disablespawn
			$ax9 disablespawn
			$ax8 disablespawn
			$ax7 disablespawn
			$ax6 enablespawn
			$ax5 enablespawn
			$ax4 disablespawn
			$ax3 disablespawn
			$ax2 disablespawn
			$axh disablespawn
			;break
		case 2:
			// allies: al2+al3  |  axis: ax5+ax4
			$alh disablespawn
			$al2 enablespawn
			$al3 enablespawn
			$al4 disablespawn
			$al5 disablespawn
			$al6 disablespawn
			$al7 disablespawn
			$al8 disablespawn
			$al9 disablespawn
			$ax9 disablespawn
			$ax8 disablespawn
			$ax7 disablespawn
			$ax6 disablespawn
			$ax5 enablespawn
			$ax4 enablespawn
			$ax3 disablespawn
			$ax2 disablespawn
			$axh disablespawn
			;break
		case 3:
			// allies: al3+al4  |  axis: ax4+ax3
			$alh disablespawn
			$al2 disablespawn
			$al3 enablespawn
			$al4 enablespawn
			$al5 disablespawn
			$al6 disablespawn
			$al7 disablespawn
			$al8 disablespawn
			$al9 disablespawn
			$ax9 disablespawn
			$ax8 disablespawn
			$ax7 disablespawn
			$ax6 disablespawn
			$ax5 disablespawn
			$ax4 enablespawn
			$ax3 enablespawn
			$ax2 disablespawn
			$axh disablespawn
			;break
		case 4:
			// allies: al4+al5  |  axis: ax3+ax2
			$alh disablespawn
			$al2 disablespawn
			$al3 disablespawn
			$al4 enablespawn
			$al5 enablespawn
			$al6 disablespawn
			$al7 disablespawn
			$al8 disablespawn
			$al9 disablespawn
			$ax9 disablespawn
			$ax8 disablespawn
			$ax7 disablespawn
			$ax6 disablespawn
			$ax5 disablespawn
			$ax4 disablespawn
			$ax3 enablespawn
			$ax2 enablespawn
			$axh disablespawn
			;break
		case 5:
			// allies: al5+al6  |  axis: ax2+axh
			$alh disablespawn
			$al2 disablespawn
			$al3 disablespawn
			$al4 disablespawn
			$al5 enablespawn
			$al6 enablespawn
			$al7 disablespawn
			$al8 disablespawn
			$al9 disablespawn
			$ax9 disablespawn
			$ax8 disablespawn
			$ax7 disablespawn
			$ax6 disablespawn
			$ax5 disablespawn
			$ax4 disablespawn
			$ax3 disablespawn
			$ax2 enablespawn
			$axh enablespawn
			;break
		case 6:
			// allies: al6+al7 (cap)  |  axis: ax2+axh (cap)
			$alh disablespawn
			$al2 disablespawn
			$al3 disablespawn
			$al4 disablespawn
			$al5 disablespawn
			$al6 enablespawn
			$al7 enablespawn
			$al8 disablespawn
			$al9 disablespawn
			$ax9 disablespawn
			$ax8 disablespawn
			$ax7 disablespawn
			$ax6 disablespawn
			$ax5 disablespawn
			$ax4 disablespawn
			$ax3 disablespawn
			$ax2 enablespawn
			$axh enablespawn
			;break
		}
	}
	else
	{
		// reversed: axis step N (axh..ax7), allies step N+3 capped (al6..alh)
		switch(level.step)
		{
		case 1:
			// axis: axh+ax2  |  allies: al6+al5
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 enablespawn
			$al5 enablespawn
			$al4 disablespawn
			$al3 disablespawn
			$al2 disablespawn
			$alh disablespawn
			$axh enablespawn
			$ax2 enablespawn
			$ax3 disablespawn
			$ax4 disablespawn
			$ax5 disablespawn
			$ax6 disablespawn
			$ax7 disablespawn
			$ax8 disablespawn
			$ax9 disablespawn
			;break
		case 2:
			// axis: ax2+ax3  |  allies: al5+al4
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 disablespawn
			$al5 enablespawn
			$al4 enablespawn
			$al3 disablespawn
			$al2 disablespawn
			$alh disablespawn
			$axh disablespawn
			$ax2 enablespawn
			$ax3 enablespawn
			$ax4 disablespawn
			$ax5 disablespawn
			$ax6 disablespawn
			$ax7 disablespawn
			$ax8 disablespawn
			$ax9 disablespawn
			;break
		case 3:
			// axis: ax3+ax4  |  allies: al4+al3
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 disablespawn
			$al5 disablespawn
			$al4 enablespawn
			$al3 enablespawn
			$al2 disablespawn
			$alh disablespawn
			$axh disablespawn
			$ax2 disablespawn
			$ax3 enablespawn
			$ax4 enablespawn
			$ax5 disablespawn
			$ax6 disablespawn
			$ax7 disablespawn
			$ax8 disablespawn
			$ax9 disablespawn
			;break
		case 4:
			// axis: ax4+ax5  |  allies: al3+al2
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 disablespawn
			$al5 disablespawn
			$al4 disablespawn
			$al3 enablespawn
			$al2 enablespawn
			$alh disablespawn
			$axh disablespawn
			$ax2 disablespawn
			$ax3 disablespawn
			$ax4 enablespawn
			$ax5 enablespawn
			$ax6 disablespawn
			$ax7 disablespawn
			$ax8 disablespawn
			$ax9 disablespawn
			;break
		case 5:
			// axis: ax5+ax6  |  allies: al2+alh
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 disablespawn
			$al5 disablespawn
			$al4 disablespawn
			$al3 disablespawn
			$al2 enablespawn
			$alh enablespawn
			$axh disablespawn
			$ax2 disablespawn
			$ax3 disablespawn
			$ax4 disablespawn
			$ax5 enablespawn
			$ax6 enablespawn
			$ax7 disablespawn
			$ax8 disablespawn
			$ax9 disablespawn
			;break
		case 6:
			// axis: ax6+ax7 (cap)  |  allies: al2+alh (cap)
			$al9 disablespawn
			$al8 disablespawn
			$al7 disablespawn
			$al6 disablespawn
			$al5 disablespawn
			$al4 disablespawn
			$al3 disablespawn
			$al2 enablespawn
			$alh enablespawn
			$axh disablespawn
			$ax2 disablespawn
			$ax3 disablespawn
			$ax4 disablespawn
			$ax5 disablespawn
			$ax6 enablespawn
			$ax7 enablespawn
			$ax8 disablespawn
			$ax9 disablespawn
			;break
		}
	}
	thread dispatch_bots
	}

	wait 2
}

end

//-----------------------------------------------------------------------------

// Send allied bots toward the leading axis spawn, and axis bots toward the leading allied spawn
dispatch_bots:

local.allies_target = NIL
local.axis_target = NIL

if (level.reversed == 0)
{
	switch(level.step)
	{
	case 1:
		local.allies_target = level.spawn_ax6
		local.axis_target = level.spawn_al2
		;break
	case 2:
		local.allies_target = level.spawn_ax5
		local.axis_target = level.spawn_al3
		;break
	case 3:
		local.allies_target = level.spawn_ax4
		local.axis_target = level.spawn_al4
		;break
	case 4:
		local.allies_target = level.spawn_ax3
		local.axis_target = level.spawn_al5
		;break
	case 5:
		local.allies_target = level.spawn_ax2
		local.axis_target = level.spawn_al6
		;break
	case 6:
		local.allies_target = level.spawn_axh
		local.axis_target = level.spawn_al7
		;break
	}
}
else
{
	switch(level.step)
	{
	case 1:
		local.allies_target = level.spawn_ax2
		local.axis_target = level.spawn_al6
		;break
	case 2:
		local.allies_target = level.spawn_ax3
		local.axis_target = level.spawn_al5
		;break
	case 3:
		local.allies_target = level.spawn_ax4
		local.axis_target = level.spawn_al4
		;break
	case 4:
		local.allies_target = level.spawn_ax5
		local.axis_target = level.spawn_al3
		;break
	case 5:
		local.allies_target = level.spawn_ax6
		local.axis_target = level.spawn_al2
		;break
	case 6:
		local.allies_target = level.spawn_ax7
		local.axis_target = level.spawn_alh
		;break
	}
}

for (local.i = 1; local.i <= $player.size; local.i++)
{
	if (isBot $player[local.i])
	{
		if ($player[local.i].dmteam == "allies" && local.allies_target != NIL)
			$player[local.i] bot_movenear local.allies_target.origin 128
		else if ($player[local.i].dmteam == "axis" && local.axis_target != NIL)
			$player[local.i] bot_movenear local.axis_target.origin 128
	}
}

end

eventeams:

wait 30

while(1)
   {
   level.allies = 0
   level.axis = 0
   for(local.dude=1;local.dude <= $player.size;local.dude++)
   {
   if ($player[local.dude].dmteam == "axis")
   level.axis++
   if ($player[local.dude].dmteam == "allies")
   level.allies++
   }
	setcvar axiscount level.axis
	setcvar alliescount level.allies

     if((level.allies > ( level.axis + 1 )) || (level.axis > ( level.allies + 1 )))
     {
	huddraw_virtualsize 214 1
	huddraw_align  214 right top
	huddraw_font   214 "verdana-12"
	huddraw_rect   214 -100 40 200 14
	huddraw_color  214 .10 .95 .10
	huddraw_alpha  214 1.0
	huddraw_string 214 "TEAMS"

	huddraw_virtualsize 215 1
	huddraw_shader 215 ("textures/hud/allies")
	huddraw_align  215 right top
	huddraw_rect   215 -60 40 14 14
	huddraw_alpha  215 1.0

	huddraw_virtualsize 216 1
	huddraw_shader 216 ("textures/hud/axis")
	huddraw_align  216 right top
	huddraw_rect   216 -30 40 14 14
	huddraw_alpha  216 1.0

	huddraw_virtualsize 217 1
	huddraw_align  217 right top
	huddraw_font   217 "verdana-12"
	huddraw_rect   217 -45 40 20 14
	huddraw_color  217 .10 .95 .10
	huddraw_alpha  217 1.0
	huddraw_string 217 level.allies

	huddraw_virtualsize 218 1
	huddraw_align  218 right top
	huddraw_font   218 "verdana-12"
	huddraw_rect   218 -15 40 20 14
	huddraw_color  218 .10 .95 .10
	huddraw_alpha  218 1.0
	huddraw_string 218 level.axis

     }

   wait 2
	huddraw_alpha  214 0
	huddraw_alpha  215 0
	huddraw_alpha  216 0
	huddraw_alpha  217 0
	huddraw_alpha  218 0
   wait 1
   }
end

fadescreen:

	for (local.t = 0; local.t <= 12; local.t++)
	{
		for(local.i = 1; local.i <= $player.size; local.i++)
		{
			local.p = $player[local.i]
			local.p stufftext "ui_hud 0"
		}
		wait 1
	}

	fadein 4 0 0 0 1

	wait 2

	for(local.i = 1; local.i <= $player.size; local.i++)
	{
		local.p = $player[local.i]
		local.p stufftext "ui_hud 1"
	}

end

music:

	wait 949
	local.STUFFSTRING = "tmstart sound/music/mus_10a_action.mp3; seta s_musicvolume 0.3"

	while(1)
	{
		for(local.i = 1; local.i <= $player.size; local.i++)
		{
			local.p = $player[local.i]
			if(local.p.music_handled != 1)
			{
				local.p.music_handled = 1
				local.p stufftext local.STUFFSTRING
			}
		}
		waitframe
	}

end
