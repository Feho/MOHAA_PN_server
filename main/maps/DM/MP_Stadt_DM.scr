// Stadt - Contest Winner by Surgeon
//
// Adapted to the PN server: adds the feho stack (tickets, squadmaker, support)
// and DM standards on top of the map's own script.
// Loose file (capital DM dir) overrides the pk3 copy.

main:

	// Random client crash fix
	removeclass PlayerIntermission

	removeclass trigger
	level.script = maps/dm/MP_Stadt_DM.scr

	setcvar "g_gametype" "4"
	setcvar "timelimit" "15"
	setcvar "fraglimit" "0"

	// set scoreboard messages
	setcvar "g_obj_alliedtext1" "Stadt"
	setcvar "g_obj_alliedtext2" "Contest Winner"
	setcvar "g_obj_alliedtext3" "by Surgeon"
	setcvar "g_obj_axistext1" ""
	setcvar "g_obj_axistext2" ""
	setcvar "g_obj_axistext3" ""

	setcvar "g_scoreboardpic" "mp_Stadt_dm.tga"

	// load support gun sounds
	waitthread global/support/support.scr::soundcache

	// call additional stuff for playing this map round based is needed
	if(level.roundbased)
		thread roundbasedthread

	$world farplane 5250
	//$world farplane_bias -100
	$world farplane_color (.333 .333 .329)

	level waitTill prespawn

	//*** Precache Dm Stuff
	exec global/DMprecache.scr

	//level.music = mp_stadt_dm

	exec global/ambient.scr

	exec global/door_locked.scr::lock

	level waittill spawn

	level.squadmaker_areaname = "in the town"

	// start support gunner scripts
	exec global/support/support.scr

	// start squadmaker
	exec global/squadmaker/squadmaker.scr

	// start tickets mode
	exec global/feho/tickets.scr

end
//-----------------------------------------------------------------------------

roundbasedthread:

	// Can specify different scoreboard messages for round based games here.

	level waitTill prespawn

	// set the parameters for this round based match
	level.dmrespawning = 0 // 1 or 0
	level.dmroundlimit = 5 // round time limit in minutes
	level.clockside = kills // set to axis, allies, kills, or draw

	level waittill roundstart

end
