//Castello
//
// Adapted to the PN server: adds the feho stack (tickets, squadmaker, support)
// and DM standards. Everything the author shipped (rain, fans, flyby, obj->DM
// entity conversion, fire_hurt, collision fixes, creds trigger) is preserved
// verbatim. The feho stack is inserted right after `level waittill spawn`,
// ABOVE the blocking `$creds waittill trigger` line, so it always runs.
// Loose file (capital DM dir) overrides the pk3 copy.

//-------------------------------------------------------------
main:
//-------------------------------------------------------------

	// Random client crash fix
	removeclass PlayerIntermission

	setcvar "g_gametype" "4"
	setcvar "timelimit" "15"
	setcvar "fraglimit" "0"

	$world farplane 6000
	$world farplane_color (.30 .30 .30)

	//snow

	level.rain_speed = "32"
	level.rain_speed_vary = "16"
	level.rain_length = "2"
	level.rain_width = "1"
	level.rain_density = ".2"
	level.rain_slant = "250"
	level.rain_min_dist = "1800"
	//level.rain_min_dist = "512"
	level.rain_numshaders = 12
	level.rain_shader = "textures/snow0"

	// set scoreboard messages

	// set scoreboard messages
	setcvar "g_obj_alliedtext1" "Castello"
	setcvar "g_obj_alliedtext2" ""
	setcvar "g_obj_alliedtext3" ""
	setcvar "g_obj_axistext1" ""
	setcvar "g_obj_axistext2" ""
	setcvar "g_obj_axistext3" ""

	setcvar "g_scoreboardpic" "mp_castello_obj"

	// load support gun sounds
	waitthread global/support/support.scr::soundcache

// call additional stuff for playing this map round based is needed
	if(level.roundbased)
		thread roundbasedthread




	///////////////////////
	level waittill prespawn
	///////////////////////

thread fire_hurt ( -2284 2224 216 )

	exec global/dmprecache.scr
	level.script = maps/dm/mp_castello_dm.scr
	exec global/ambient.scr mp_castello
	exec global/door_locked.scr
	//exec global/exploder.scr //console errors this not needed for tdm
	exec global/bomber.scr

//added
$barntruck_explode remove
   $sdkfz_explode remove
   $radioblocker remove
   $radioblockerdoor remove
   $radio_door_locked remove
   //$radio_door_bomb remove
   $documents_stolen remove
   $barndoorblocker remove
   //$sdkfz remove
   $exploder remove
   $exploderchunk remove

		//we want the blown up gate, and door to be shown correctly
		$explodersmashed show
		$explodersmashed solid

	//setup the fans
	thread init_fans

	//planes go...
	thread flyby

	////////////////////
	level waittill spawn
	////////////////////

	// --- PN feho stack (inserted above the blocking creds trigger) ---
	level.squadmaker_areaname = "at the castle"

	// start support gunner scripts
	exec global/support/support.scr

	// start squadmaker
	exec global/squadmaker/squadmaker.scr

	// start tickets mode
	exec global/feho/tickets.scr
	// --- end feho stack ---

$sdkfz notsolid
$sdkfz nodamage
$sdkfz setcollisionentity $sdkfzmask

$truck1 notsolid
$truck1 nodamage
$truck1 setcollisionentity $truck1col
$truck1 anim stop_wheels

	spawn trigger_multiple "targetname" "creds"
	$creds.origin = ( -1999.13 816.88 160.13 )
	$creds setsize ( -20 20 20 ) ( 20 20 20 )
	$creds waittill trigger
	$creds message "Conversion Work by  ... Cobra {sfx} / Gold {sfx}"

end

//------------------------------------------------------------
flyby:
//------------------------------------------------------------

	//random flyby of planes
    	wait 300
	thread global/bomber.scr::bomb 4
	thread global/bomber.scr::bomb 10
	wait (randomint(120) + 40)  //180 60

	goto flyby

	end



//-------------------------------------------------------------
init_fans:
//-------------------------------------------------------------

	$fanblade1 bind $fanbase1
	$fanblade2 bind $fanbase1
	$fanblade3 bind $fanbase1
	$fanblade4 bind $fanbase1
	$fanbase1 rotatey 250

	$fanblade1a bind $fanbase2
	$fanblade2a bind $fanbase2
	$fanblade3a bind $fanbase2
	$fanblade4a bind $fanbase2
	$fanbase2 rotatey 245

	$fanblade1b bind $fanbase3
	$fanblade2b bind $fanbase3
	$fanblade3b bind $fanbase3
	$fanblade4b bind $fanbase3
	$fanbase3 rotatey 285

	end

	level waittill spawn

end

//-----------------------------------------------------------------------------

roundbasedthread:

	// Can specify different scoreboard messages for round based games here.

	level waitTill prespawn

	level waittill spawn

	// set the parameters for this round based match
	level.dmrespawning = 0 // 1 or 0
//	level.dmroundlimit = 5 // round time limit in minutes
	level.clockside = kills // set to axis, allies, kills, or draw

	level waittill roundstart

end


// -------------------------------------------------------------------------------------
fire_hurt local.origin:
// -------------------------------------------------------------------------------------

   local.trig = spawn trigger_multiple
   local.trig.origin = local.origin
   local.trig setsize ( -10 -10 -10 ) ( 10 10 10 )
   local.trig setthread itburns
   local.trig wait 0.5
   local.trig delay 0

end

itburns:

   local.player = parm.other
   local.player hurt 1

end
