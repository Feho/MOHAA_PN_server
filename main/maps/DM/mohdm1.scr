// SOUTHERN FRANCE
// ARCHITECTURE: SENN
// SCRIPTING: POWZER

main:

	// Stop self closing doors
	removeclass rotatingdoor

	// Create initial doors and link pairs
	waitthread create_door_with_trigger "*2" "door2" ( -264 534 456 ) 180
	waitthread create_door "*3" "door3" ( -264 426 456 ) 180
	waitthread create_door_with_trigger "*4" "door4" ( 712 534 456 ) 0
	waitthread create_door "*5" "door5" ( 712 426 456 ) 0
	$door2 linkdoor $door3
	$door4 linkdoor $door5

	// Random client crash fix
	removeclass PlayerIntermission

	setcvar "g_gametype" "2"
	setcvar "timelimit" "15"
	setcvar "fraglimit" "0"

	// set scoreboard messages
	setcvar "g_obj_alliedtext1" "Southern France"
	setcvar "g_obj_alliedtext2" ""
	setcvar "g_obj_alliedtext3" ""
	setcvar "g_obj_axistext1" ""
	setcvar "g_obj_axistext2" ""
	setcvar "g_obj_axistext3" ""

	setcvar "g_scoreboardpic" "mohdm1"

	// load support gun sounds
	waitthread global/support/support.scr::soundcache
	
	// call additional stuff for playing this map round based is needed
	if(level.roundbased)
		thread roundbasedthread
		
	level waitTill prespawn

	// Create remaining doors with triggers
	waitthread setup_all_doors

	//*** Precache Dm Stuff
	exec global/DMprecache.scr

	level.script = maps/dm/mohdm1.scr
	exec global/ambient.scr mohdm1

	//exec global/ambient.scr mohdm2

	//$world farplane 5000
	//$world farplane_color (.333 .333 .329)

	// Portable 30 cals
	// exec models/create_guns.scr ( -806 -353 48.12 )
	
	// exec global/DETONATOR_SOUND.scr
	// exec global/RB_DETONATORS.scr::DETONATOR ( 1361.71 339.49 304.12 ) ( 0 0 0 )
	// exec global/RB_DETONATORS.scr::DETONATOR ( -838.75 760.46 216.18 ) ( 0 0 0 )
	// exec global/TNT_DETONATORS.scr::DETONATOR ( 1313 403 256.12 ) ( 0 0 0 )
	// exec global/TNT_DETONATORS.scr::DETONATOR ( -435.76 166 434.12 ) ( 0 0 0 )
		
	local.info = makeArray
		( 239 479 385 ) ( 0 0 0 ) "random" 1
	endArray

	thread global/AIR_gold.scr::treasure_spawn local.info
	
	level waittill spawn

	level.squadmaker_areaname = "in southern France"

	// start support gunner scripts
	exec global/support/support.scr

	// start squadmaker
	exec global/squadmaker/squadmaker.scr
	
	wait 120

	stuffsrv "say You can lock or unlock doors by holding the use key for 3 seconds. Use it wisely!"
	
end

create_door local.model local.targetname local.origin local.angle:
	
	local.door = spawn func_rotatingdoor model local.model targetname local.targetname wait "-1" origin local.origin angle ( local.angle ) alwaysaway "1"

end

setup_all_doors:
	// Door definitions: model, targetname, origin, angle
	local.doors = makeArray
		"*1" "door1" ( -482 888 446 ) 90
		"*6" "door6" ( 346 1160 110 ) 270
		"*7" "door7" ( -8 1354 110 ) 0
		"*8" "door8" ( 90 1656 190 ) 270
		"*9" "door9" ( 1336 1434 446 ) 0
		"*10" "door10" ( 1154 8 318 ) 270
		"*11" "door11" ( -1178 264 230 ) 90
		"*12" "door12" ( 1336 2106 574 ) 0
		"*13" "door13" ( -376 1418 446 ) 0
		"*14" "door14" ( 712 1482 446 ) 0
		"*15" "door15" ( -792 546 46 ) 0
		"*16" "door16" ( 1032 2818 446 ) 180
		"*17" "door17" ( -1272 610 230 ) 0
		"*18" "door18" ( -1154 888 230 ) 90
		"*19" "door19" ( 218 1656 446 ) 90
		"*20" "door20" ( 602 1160 446 ) 90
		"*21" "door21" ( 994 2984 622 ) 270
		"*22" "door22" ( 1302 888 446 ) 270
		"*23" "door23" ( 920 770 446 ) 0
		"*24" "door24" ( 920 330 446 ) 0
		"*25" "door25" ( 1400 666 446 ) 0
		"*26" "door26" ( 1442 2344 574 ) 90
	endArray

	// Create doors and triggers
	for (local.i = 1; local.i <= local.doors.size; local.i++)
	{
		local.doorInfo = local.doors[local.i]
		thread create_door_with_trigger local.doorInfo[1] local.doorInfo[2] local.doorInfo[3] local.doorInfo[4]
	}
end

create_door_with_trigger local.model local.targetname local.origin local.angle:

	// Create door
	local.door = spawn func_rotatingdoor model local.model targetname local.targetname wait "-1" origin local.origin angle ( local.angle ) alwaysaway "1"
	
	// Create trigger at same location
	local.trigger = waitthread global/AIRborne_prefabs.scr::create_triggeruse local.origin (local.targetname + "_trigger")
	local.trigger setthread door_trigger
	local.trigger.door = $(local.targetname)

end

// This thread is used to lock or unlock the door when the player holds the use key.
door_trigger:

	local.player = parm.other

	if (self.inUse) end

	local.seconds = 3

	if (self.isLocked)
		local.player iprint ("Door is LOCKED. Hold use key for " + local.seconds + " seconds to unlock.") 1

	self.inUse = 1

	while (local.player.useheld && local.seconds > 0)
	{
		if (local.seconds == 2.5)
			local.player stopwatch (local.seconds + 1) // +1 to prevent the stopwatch from disappearing too early

		wait 0.5
		local.seconds -= 0.5
	}

	self.inUse = 0
	local.player stopwatch 0

	if (!local.player.useheld) end

	if (self.isLocked)
	{
		self.door unlock
		self.isLocked = 0
		local.player iprint "Door UNLOCKED"
	}
	else
	{
		self.door lock
		self.isLocked = 1
		local.player iprint "Door LOCKED"
	}
	
end

//-----------------------------------------------------------------------------

roundbasedthread:

	// Can specify different scoreboard messages for round based games here.
	
	level waitTill prespawn

	level waittill spawn

	// set the parameters for this round based match
	level.dmrespawning = 0 // 1 or 0
	level.dmroundlimit = 5 // round time limit in minutes
	level.clockside = kills // set to axis, allies, kills, or draw

	level waittill roundstart

end
