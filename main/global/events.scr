main:

    event_subscribe "player_spawned" event_player_spawned
    event_subscribe "player_killed" event_player_killed
    event_subscribe "player_damaged" event_player_damaged

end

event_player_spawned:

    if (!isBot self && !self.hitmarker_started)
    {
        self.hitmarker_started = 1
        local.idx = 300

        ihuddraw_font self local.idx "verdana-12"
        ihuddraw_align self local.idx "center" "center"
        ihuddraw_rect self local.idx -9 -19 0 0
        ihuddraw_string self local.idx "\\   /\n\n/   \\"
        ihuddraw_color self local.idx 0.95 0.93 0.85
        ihuddraw_alpha self local.idx 0.0
    }

    wait 0.301
    local.wpn = waitthread global/feho/utils.scr::get_weapon self
    local.wpnclass = waitthread global/feho/utils.scr::get_wpnclass local.wpn
    self.weapon_model = local.wpn

    if (isBot self)
    {
        local.is_art_of_war = (level.squadmaker_config == "art_of_war")

        if (local.wpnclass == "heavy" || local.wpnclass == "shotgun" || local.is_art_of_war)
        {
            // Give the bot a rifle
            self takeall

            if (self.dmteam == "axis")
                local.new_weapon = "models/weapons/kar98.tik"
            else
                local.new_weapon = "models/weapons/m1_garand.tik"

            self giveweapon local.new_weapon
            self.weapon_model = local.new_weapon
        }

        wait 1
        if (!self) end

        if (randomint(100) < 80 && local.wpnclass != "sniper")
        {
            // Increase the spread of the weapon, so that the bots are not too accurate.
            // self weaponcommand dual dmbulletspread 40 40 70 70
            self weaponcommand dual dmbulletdamage 30
        }
    }

end

event_player_killed local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:

    // Spawn a treasure with a 5% probability
    local.origin = self.origin

    if (randomint(100) < 5)
    {
        local.info = makeArray
            local.origin ( 0 0 0 ) "random" 0
        endArray

        thread global/AIR_gold.scr::treasure_spawn local.info
    }

    // Center-screen "ENEMY KILLED — <name>" banner shown to the killer.
    // Default ON; set "kill_banner 0" to disable (e.g. to A/B test whether the
    // banner contributes to a multikill hitch vs. the tickets HUD). An unset cvar
    // reads as "" here (engine default), so we only bail on an explicit "0".
    local.kb_cvar = getcvar "kill_banner"
    if (local.kb_cvar == "0")
        end

    local.victim = self
    if (!local.attacker) end
    if (local.attacker == local.victim) end                       // suicide
    if (local.attacker.dmteam == local.victim.dmteam) end          // teamkill
    if (isBot local.attacker) end                                  // bots have no HUD

    local.attacker thread show_kill_banner (netname local.victim)

end

// One-time static HUD setup for a player's kill banner. Issues the properties
// that never change between kills — fonts, alignments, the backdrop shader, and
// both line colors — so the per-kill hot path only touches the strings, rects,
// and alphas. Drawn hidden (alpha 0). The top-line string (294) is written
// per-kill because it carries the multi-kill suffix ("ENEMY KILLED  x2").
//   293 : dark backdrop panel
//   294 : "ENEMY KILLED [ xN ]" (dimmed white, string set per-kill)
//   295 : victim name (red)
kb_setup:
    // Backdrop panel (293): dark translucent box behind both lines. black.tga can
    // only render black, so we just set its alpha (color stays ~black). align +
    // font/shader are constant; the rect (x/width) is sized per-kill to the name,
    // so it is set in the hot path, not here. Center-aligned so the whole banner
    // stays centered on screen and grows symmetrically as names lengthen.
    ihuddraw_shader self 293 "textures/mohmenu/black.tga"
    ihuddraw_align self 293 "center" "center"
    ihuddraw_color self 293 0.04 0.04 0.04
    ihuddraw_alpha self 293 0.0

    // Accent bar (296): thin red vertical strip at the panel's LEFT edge. Drawn
    // above the panel (296 > 293) so it sits on top. MUST use white.tga, not
    // black.tga — black multiplies any color back to black; white tints to red.
    // white.tga ships in stock Pak2.pk3 (no client download). Center-aligned like
    // everything else; the per-kill rect uses an iX offset to sit at the left edge.
    ihuddraw_shader self 296 "textures/common/white.tga"
    ihuddraw_align self 296 "center" "center"
    ihuddraw_color self 296 0.85 0.20 0.18
    ihuddraw_alpha self 296 0.0

    // Both lines use handle-23 (a wider, blockier stock HUD face). All elements are
    // center-aligned; the two text lines share one iX offset so they line up on a
    // common left edge — no per-line centering drift. font/align never vary, so they
    // are cached here; string + rect are set per-kill.
    // Line 1: ENEMY KILLED (dimmed white).
    ihuddraw_font self 294 "handle-23"
    ihuddraw_align self 294 "center" "center"
    ihuddraw_color self 294 0.85 0.85 0.85
    ihuddraw_alpha self 294 0.0

    // Line 2: victim name (red — matches the ticket-axis red). Color never varies.
    ihuddraw_font self 295 "handle-23"
    ihuddraw_align self 295 "center" "center"
    ihuddraw_color self 295 1.0 0.30 0.25
    ihuddraw_alpha self 295 0.0

    self.kb_setup = 1
end

// Per-player center-screen kill confirmation. Drawn just below the crosshair.
// Interrupt-on-retrigger: a fresh kill bumps self.kb_gen so any in-flight tween
// for this player bails and the newest call owns the HUD indices.
// Time-gated multi-kill: kills within kill_banner_window seconds of each other
// chain, appending "  xN" to the top line. self.* clears between rounds, so a
// new round naturally restarts the count via the NIL branch.
show_kill_banner local.name:
    if (!self) end

    // Issue the static HUD properties once per player; later kills skip them.
    if (self.kb_setup != 1)
        waitthread kb_setup

    if (!self) end

    // Multi-kill counter: increment if within the rolling window, else reset to 1.
    local.window = 3.0

    if (self.kb_count == NIL)
        local.count = 1
    else
    {
        local.dt = level.time - self.kb_last_time
        if (local.dt <= local.window)
            local.count = self.kb_count + 1
        else
            local.count = 1
    }
    self.kb_count = local.count
    self.kb_last_time = level.time

    if (self.kb_gen == NIL)
        self.kb_gen = 0
    self.kb_gen++
    local.gen = self.kb_gen

    // Coalesce same-frame multikills (e.g. a grenade killing 5 players fires
    // player_killed 5 times in one frame, spawning 5 of these threads on the same
    // killer). Yield one frame right after bumping kb_gen and the count, before the
    // heavy prologue (layout, rects, the typewriter). Next frame only the latest
    // thread survives the gen-guard; the earlier 4 bail here, having done nothing
    // but the cheap counter math. Result: one banner reading "ENEMY KILLED  x5"
    // instead of 5 banners racing — no HUD-command flood, no visual fight. The
    // single-kill case just appears 0.05s later, which is imperceptible.
    waitframe
    if (!self || self.kb_gen != local.gen) end

    local.panel = 293
    local.top   = 294
    local.bot   = 295
    local.bar   = 296

    local.y_top = 160
    local.y_bot = 183

    // Top line: bare "ENEMY KILLED", or with an "  xN" suffix for a multi-kill.
    if (local.count >= 2)
        local.topstr = "ENEMY KILLED  x" + local.count
    else
        local.topstr = "ENEMY KILLED"

    // Layout — everything is CENTER-aligned; we offset via iX. With center align the
    // engine draws an element's left edge at (320 + iX - rectWidth/2):
    //   - panel (width box_w): iX 0 -> left edge at 320 - box_w/2, stays centered and
    //     grows symmetric with the name.
    //   - text rects are zero-width, so their left edge is just (320 + iX). To put
    //     both lines on a shared left edge (panel left + inset) we give them the same
    //     iX = -box_w/2 + pad_left — no per-line centering drift.
    //   - the bar has real width, so iX = -box_w/2 + bar_w/2 lands its left edge on
    //     the panel's left edge.
    local.top_w  = waitthread global/feho/hud_lib.scr::handle23_width local.topstr
    local.name_w = waitthread global/feho/hud_lib.scr::handle23_width local.name

    // box_w encloses the wider line plus a left inset (bar + gap) and a right margin.
    local.bar_w   = 4
    local.pad_left = local.bar_w + 18      // text starts past the bar + an 18px gap
    local.pad_right = 12
    local.text_w  = local.name_w
    if (local.top_w > local.text_w)
        local.text_w = local.top_w
    local.box_w  = local.text_w + local.pad_left + local.pad_right

    // Vertical sizing. A text rect's y is the glyph's TOP edge (R_DrawString draws
    // downward from y; for a zero-height rect valign-center is a no-op), so each line
    // of ink spans [y .. y + font_h], NOT y +/- font_h/2. The text block therefore
    // runs from y_top (top of line 1) to y_bot + font_h (bottom of line 2). We wrap
    // it with equal padding top and bottom. Deriving box_h and the panel center from
    // the line positions keeps the padding correct if y_top/y_bot/font ever change.
    local.font_h  = 21                                   // handle-23 glyph height
    local.pad_v   = 9                                    // top & bottom padding
    local.text_lo = local.y_top                          // top of the first line's ink
    local.text_hi = local.y_bot + local.font_h           // bottom of the name's ink
    local.box_h   = (local.text_hi - local.text_lo) + 2 * local.pad_v
    local.box_cy  = (local.text_lo + local.text_hi) / 2  // panel/bar center y

    // Panel: real width, iX 0 (center align subtracts width/2 itself).
    ihuddraw_rect self local.panel 0 local.box_cy local.box_w local.box_h

    // Accent bar: real width, offset so its left edge meets the panel's left edge.
    local.bar_x = (0 - local.box_w / 2) + local.bar_w / 2
    ihuddraw_rect self local.bar local.bar_x local.box_cy local.bar_w local.box_h

    // Text: zero-width rects share an iX one inset past the panel's left edge.
    local.text_x = (0 - local.box_w / 2) + local.pad_left
    ihuddraw_rect self local.top local.text_x local.y_top 0 0
    ihuddraw_rect self local.bot local.text_x local.y_bot 0 0

    // Typewriter reveal. The box/bar are pre-sized to the FULL text width above, so
    // they don't reflow as letters appear — only the strings grow. Each frame adds
    // 2 characters per line (sv_fps 20 -> 2 chars / 0.05s). The two lines advance
    // together; the shorter one finishes and just holds its full string while the
    // longer keeps typing — substr_prefix clamps each line's prefix length to its
    // own size so str[i] is never indexed out of bounds (that throws and would
    // freeze the banner). Text alpha is full from frame 0 (the letters themselves
    // are the reveal); the panel and bar still fade in over the first 5 frames so
    // the backdrop arrives smoothly rather than popping.
    local.cps = 2                                  // characters revealed per frame
    local.top_len  = local.topstr.size
    local.name_len = local.name.size
    local.steps = local.top_len
    if (local.name_len > local.steps)
        local.steps = local.name_len

    ihuddraw_alpha self local.top 1.0
    ihuddraw_alpha self local.bot 1.0

    for (local.n = local.cps; local.n < local.steps; local.n += local.cps)
    {
        if (!self || self.kb_gen != local.gen) end

        local.topsub  = waitthread global/feho/hud_lib.scr::substr_prefix local.topstr local.n
        local.namesub = waitthread global/feho/hud_lib.scr::substr_prefix local.name local.n
        ihuddraw_string self local.top local.topsub
        ihuddraw_string self local.bot local.namesub

        // Backdrop fade-in, concurrent with typing: full by the 5th frame.
        local.a = float(local.n) / 5
        if (local.a > 1.0) local.a = 1.0
        ihuddraw_alpha self local.panel (local.a * 0.3)
        ihuddraw_alpha self local.bar local.a

        waitframe
    }

    // Guarantee the full strings and full backdrop alpha are set, in case steps was
    // short or a clamp rounded down.
    if (!self || self.kb_gen != local.gen) end
    ihuddraw_string self local.top local.topstr
    ihuddraw_string self local.bot local.name
    ihuddraw_alpha self local.panel 0.3
    ihuddraw_alpha self local.bar 1.0

    if (!self || self.kb_gen != local.gen) end

    // Hold, then fade out — bail immediately if a newer kill superseded us.
    wait 2.4
    if (!self || self.kb_gen != local.gen) end

    for (local.s = 10; local.s >= 0; local.s--)
    {
        if (!self || self.kb_gen != local.gen) end
        local.a = float(local.s) / 10

        ihuddraw_alpha self local.panel (local.a * 0.3)
        ihuddraw_alpha self local.bar local.a
        ihuddraw_alpha self local.top local.a
        ihuddraw_alpha self local.bot local.a
        waitframe
    }

    if (!self || self.kb_gen != local.gen) end
    ihuddraw_alpha self local.panel 0.0
    ihuddraw_alpha self local.bar 0.0
    ihuddraw_alpha self local.top 0.0
    ihuddraw_alpha self local.bot 0.0
end

event_player_damaged local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:

    if (local.attacker && local.attacker != self && !isBot local.attacker && !local.attacker.hitmarker)
    {
        local.idx = 300
        local.attacker.hitmarker = 1

        for (local.i = 5; local.i >= 0; local.i--)
        {
            local.x = float(local.i) / 10
            ihuddraw_alpha local.attacker local.idx local.x
            waitframe
        }

        wait 0.5
        local.attacker.hitmarker = 0
    }

    if (randomint(12) != 1 || !isAlive self || self.has_grenade || !isBot self) end

    self.has_grenade = 1

    self takeall

    if (self.dmteam == "axis")
        self item "models/weapons/steilhandgranate.tik"
    else
        self item "models/weapons/m2frag_grenade.tik"

    self ammo grenade -3

    wait 0.2
    if (!self) end

    self weapnext

    while (1)
    {
        wait 1
        if (!self) end

        if (!self.isAlive)
        {
            self.has_grenade = 0
            end
        }

        local.wpn = waitthread global/feho/utils.scr::get_weapon self
        local.wpnclass = waitthread global/feho/utils.scr::get_wpnclass local.wpn

        if (local.wpnclass != "grenade")
        {
            self.has_grenade = 0
            self giveweapon self.weapon_model
            end
        }
    }

    end

    local.left_foot = 9
    local.right_foot = 10
    local.lower_left_leg = 13
    local.lower_right_leg = 14
    local.upper_left_leg = 18
    local.upper_right_leg = 17
    local.general = -1

    // Check if the player was hit in the legs or feet
    if (local.location == local.left_foot || local.location == local.right_foot ||
        local.location == local.lower_left_leg || local.location == local.lower_right_leg ||
        local.location == local.upper_left_leg || local.location == local.upper_right_leg ||
        local.location == local.general)
    {
        // Slow the player down for 5 seconds
        local.start_speed = 0.3
        local.end_speed = 0.85
        local.duration = 3
        local.wait_time = 0.1

        local.current_speed = local.start_speed
        self weaponcommand dual dmmovementspeed local.current_speed
        local.steps = local.duration / local.wait_time
        local.speed_increment = (local.end_speed - local.start_speed) / local.steps

        for (local.i = 0; local.i < local.steps; local.i++)
        {
            wait local.wait_time
            local.current_speed += local.speed_increment

            if (!self || !isAlive self) end

            self weaponcommand dual dmmovementspeed local.current_speed
        }
    }

end
