main:

    event_subscribe "player_connected" event_player_connected
    event_subscribe "player_killed" event_player_killed
    event_subscribe "player_damaged" event_player_damaged

end

event_player_connected:

    // Init variables
    self.deathsWithoutKill = 0
    self.damageReduction = 0

end

event_player_killed local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:

    if (isBot self) end

    // The victim's streak increases
    self.deathsWithoutKill++

    if (self.deathsWithoutKill >= 8)      self.damageReduction = 0.8
    else if (self.deathsWithoutKill >= 5) self.damageReduction = 0.5
    else                                  self.damageReduction = 0

    // The attacker got a kill, reset their streak
    if (local.attacker && local.attacker != self)
    {
        local.attacker.deathsWithoutKill = 0
        local.attacker.damageReduction = 0
    }

end

event_player_damaged local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:

    if (self.damageReduction == 0 || !isAlive self || isBot self)
        end

    // Absorb <damageReduction> % of damage
    local.percent = self.damageReduction * 100
    println (netname self + ": absorb " + local.percent + " percent of " + local.damage + " damage")
    self healthonly (self.health + local.damage * self.damageReduction)

end
