main:
    if (level.messagesMaps == 1)
        end

    level.messagesMaps = 1

    // Subscribe to player spawn for welcome message
    event_subscribe "player_spawned" event_player_spawned

    wait 60

    // stuffsrv "say Press [USE] near enemy grenades to kick them!"
    wait 10
    // stuffsrv "say Right-click with grenade = smoke grenade"
    wait 10
    // stuffsrv "say Right-click with rifle = grenade launcher"

    // At ~13 minutes, broadcast the 2 facts generated by map_facts_daemon.sh
    wait 660

    local.facts = waitexec "configs/map_facts.txt"
    if (local.facts == NIL || local.facts.size == 0)
        end

    for (local.i = 1; local.i <= local.facts.size; local.i++)
    {
        stuffsrv ("say " + local.facts[local.i][1])
        wait 20
    }
end

event_player_spawned:
    local.player = self

    if (!local.player || isBot local.player)
        end

    // Only show once per player session
    if (local.player.tips_welcomed == 1)
        end

    local.player.tips_welcomed = 1

    // Small delay so it doesn't get lost in spawn messages
    wait 3
    local.tips[1] = "Tip: Too many bots? Type 'bots 6' or 'bots 4'"
    local.tips[2] = "Tip: Press [USE] near enemy grenades to kick them!"
    local.tips[3] = "Tip: Right-click with grenade = smoke grenade"
    local.tips[4] = "Tip: Right-click with rifle = grenade launcher"
    local.tips[5] = "Tip: Squad leader? Aim somewhere and press [USE] to order your bots to hold it"
    local.tip = local.tips[randomint(local.tips.size) + 1]

    if (local.player)
        local.player iprint local.tip
end
