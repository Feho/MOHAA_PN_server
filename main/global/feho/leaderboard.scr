// Weekly XP leaderboard for true spectators.
//
// session.* survives map changes but is cleared with the server process. A
// snapshot at each map start restores completed-map scores after a crash; only
// the interrupted map is lost. Completed weeks are archived permanently, and
// the immediately preceding winner remains visible throughout the next week.
// The associative table is keyed by netname because entity references cannot
// be persisted by the session serializer. Renames therefore create a new row
// and duplicate names intentionally share one row.

main:

    if (level.leaderboard_initialized == 1)
        end

    level.leaderboard_initialized = 1

    waitthread restore_leaderboard_once
    waitthread reset_if_new_week
    waitthread normalize_rows
    waitthread purge_connected_bot_rows

    // The script is loaded once per map, so this is the map-change pruning
    // point. Keep more history than the HUD displays, but bound the serialized
    // session payload for long-lived server processes.
    waitthread prune_leaderboard 100
    waitthread save_leaderboard

    event_subscribe "player_killed" event_player_killed
    event_subscribe "player_teamchanged" event_player_teamchanged

    thread refresh_loop

end

event_player_killed local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:

    if (!(waitthread is_enabled))
        end

    local.victim = self
    if (local.victim == NIL || local.victim == NULL)
        end

    if (!(isBot local.victim))
        waitthread add_death local.victim

    if (local.attacker == NIL || local.attacker == NULL)
        end
    if (local.attacker == local.victim)
        end
    if (!(waitthread is_player_entity local.attacker))
        end
    if (isBot local.attacker)
        end

    // Team kills are not scoreboard kills. Only apply this rule to actual team
    // names so the same code remains valid if a free-for-all map is loaded.
    if ((local.victim.dmteam == "allies" || local.victim.dmteam == "axis") && local.attacker.dmteam == local.victim.dmteam)
        end

    waitthread add_kill local.attacker

end


// player_teamchanged fires after dmteam is updated. This closes the timer gap
// and hides the panel at the moment a spectator joins a playing team.
event_player_teamchanged local.old_team local.new_team:

    if (self == NIL || self == NULL)
        end

    if (isBot self)
    {
        if (session.leaderboard != NIL)
        {
            local.name = netname self
            session.leaderboard[local.name] = NIL
        }
        end
    }

    if (local.new_team != "spectator" || !(waitthread is_enabled))
    {
        waitthread hide_player self
        end
    }

    local.names = waitthread sorted_names
    if ((local.names == NIL || local.names.size == 0) && !(waitthread has_last_week_winner))
    {
        waitthread hide_player self
        end
    }

    waitthread draw_player self local.names

end


add_kill local.player:

    local.name = netname local.player
    waitthread ensure_row local.name
    session.leaderboard[local.name]["kills"]++

end


add_death local.player:

    local.name = netname local.player
    waitthread ensure_row local.name
    session.leaderboard[local.name]["deaths"]++

end


// Public entry point used by xp.scr. XP remains independent from engine score;
// this only mirrors an award into the name-keyed weekly persistence table.
add_xp local.player local.amount:

    if (!(waitthread is_player_entity local.player))
        end
    if (isBot local.player)
        end

    local.amount = int(local.amount)
    if (local.amount <= 0)
        end

    waitthread reset_if_new_week
    local.name = netname local.player
    waitthread ensure_row local.name
    session.leaderboard[local.name]["xp"] += local.amount

end


ensure_row local.name:

    if (session.leaderboard[local.name]["xp"] == NIL)
        session.leaderboard[local.name]["xp"] = 0

    if (session.leaderboard[local.name]["kills"] == NIL)
        session.leaderboard[local.name]["kills"] = 0

    if (session.leaderboard[local.name]["deaths"] == NIL)
        session.leaderboard[local.name]["deaths"] = 0

end


// Adds fields introduced by newer snapshot formats to an already-live session
// table when scripts are updated without restarting the server process.
normalize_rows:

    if (session.leaderboard == NIL)
        end

    local.names = getarraykeys session.leaderboard
    if (local.names == NIL)
        end

    for (local.i = 0; local.i < local.names.size; local.i++)
        waitthread ensure_row local.names[local.i]

end


is_player_entity local.entity:

    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        if ($player[local.i] == local.entity)
            end 1
    }

end 0


is_enabled:

    local.value = getcvar "leaderboard_enabled"
    if (local.value == "")
        end 1

end (int(local.value) != 0)


row_limit:

    local.rows = int(getcvar "leaderboard_rows")
    if (local.rows <= 0)
        local.rows = 10

    // 165 backdrop + 166 two-line header + at most 20 row indices = 186.
    if (local.rows > 20)
        local.rows = 20

end local.rows


refresh_interval:

    local.interval = float(getcvar "leaderboard_refresh")
    if (local.interval <= 0)
        local.interval = 3.0
    if (local.interval < 1.0)
        local.interval = 1.0

end local.interval


refresh_loop:

    while (1)
    {
        waitthread refresh_all
        local.interval = waitthread refresh_interval
        wait local.interval
    }

end


refresh_all:

    waitthread reset_if_new_week
    waitthread purge_connected_bot_rows

    local.enabled = waitthread is_enabled
    local.names = NIL

    if (local.enabled)
        local.names = waitthread sorted_names

    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        local.player = $player[local.i]
        if (local.player == NIL || local.player == NULL || isBot local.player)
            continue

        // dmteam is deliberate: isSpectator also includes dead team players
        // waiting for sv_team_spawn_interval and would flash the panel on death.
        if (!local.enabled || local.player.dmteam != "spectator" || ((local.names == NIL || local.names.size == 0) && !(waitthread has_last_week_winner)))
            waitthread hide_player local.player
        else
            waitthread draw_player local.player local.names
    }

end


purge_connected_bot_rows:

    if (session.leaderboard == NIL)
        end

    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        local.player = $player[local.i]
        if (local.player != NIL && local.player != NULL && isBot local.player)
        {
            local.name = netname local.player
            session.leaderboard[local.name] = NIL
        }
    }

end


draw_player local.player local.names:

    if (local.player == NIL || local.player == NULL)
        end
    if (local.player.dmteam != "spectator")
    {
        waitthread hide_player local.player
        end
    }

    local.rows = 0
    if (local.names != NIL)
    {
        local.rows = waitthread row_limit
        if (local.rows > local.names.size)
            local.rows = local.names.size
    }

    if (local.rows <= 0 && !(waitthread has_last_week_winner))
    {
        waitthread hide_player local.player
        end
    }

    local.base = 165
    local.panel_x = -461
    local.panel_y = 65
    local.panel_w = 446
    local.panel_h = 88 + (local.rows * 17)

    waitthread global/feho/hud_lib.scr::draw_rect local.player local.base "right" "top" local.panel_x local.panel_y local.panel_w local.panel_h ( 0.04 0.04 0.04 ) 0.72

    ihuddraw_font local.player (local.base + 1) "courier-16"
    ihuddraw_align local.player (local.base + 1) "right" "top"
    ihuddraw_rect local.player (local.base + 1) -446 74 0 0
    ihuddraw_color local.player (local.base + 1) 0.62 0.78 0.95
    local.last_week_text = "LAST WEEK: No result"
    if (waitthread has_last_week_winner)
    {
        local.winner_name = waitthread global/feho/hud_lib.scr::substr_prefix session.leaderboard_last_winner_name 20
        local.winner_xp = waitthread format_grouped_integer session.leaderboard_last_winner_xp
        local.last_week_text = "LAST WEEK: " + local.winner_name + " - " + local.winner_xp + " XP"
    }
    ihuddraw_string local.player (local.base + 1) ("WEEKLY RANKINGS - Resets Monday\n" + local.last_week_text + "\n\n #        XP KILLS DEATHS   K/D NAME")
    ihuddraw_alpha local.player (local.base + 1) 1.0

    local.viewer_name = netname local.player
    local.viewer_index = -1
    if (local.names != NIL)
        local.viewer_index = waitthread find_name_index local.names local.viewer_name

    for (local.i = 0; local.i < local.rows; local.i++)
    {
        // When the viewer ranks below the visible cutoff, reserve the last row
        // for them while keeping their actual weekly rank in the first column.
        if (local.i == local.rows - 1 && local.viewer_index >= local.rows)
        {
            local.name = local.names[local.viewer_index]
            local.rank = local.viewer_index + 1
        }
        else
        {
            local.name = local.names[local.i]
            local.rank = local.i + 1
        }

        local.xp = session.leaderboard[local.name]["xp"]
        local.kills = session.leaderboard[local.name]["kills"]
        local.deaths = session.leaderboard[local.name]["deaths"]

        local.rank_text = waitthread global/feho/statusb.scr::pad_left local.rank 2
        local.xp_text = waitthread format_grouped_integer local.xp
        local.xp_text = waitthread global/feho/statusb.scr::pad_left local.xp_text 9
        local.kills_text = waitthread global/feho/statusb.scr::pad_left local.kills 5
        local.deaths_text = waitthread global/feho/statusb.scr::pad_left local.deaths 6
        local.kd_text = waitthread format_kd local.kills local.deaths
        local.kd_text = waitthread global/feho/statusb.scr::pad_left local.kd_text 5
        local.name_text = waitthread global/feho/hud_lib.scr::substr_prefix local.name 20

        local.text = local.rank_text + " " + local.xp_text + " " + local.kills_text + " " + local.deaths_text + " " + local.kd_text + " " + local.name_text
        local.idx = local.base + 2 + local.i
        local.y = 145 + (local.i * 17)

        ihuddraw_font local.player local.idx "courier-16"
        ihuddraw_align local.player local.idx "right" "top"
        ihuddraw_rect local.player local.idx -446 local.y 0 0
        // Self-highlight takes precedence so the viewer stays recognizable even
        // when they also occupy a medal position.
        if (local.name == local.viewer_name)
            ihuddraw_color local.player local.idx 0.35 1.0 0.45
        else if (local.rank == 1)
            ihuddraw_color local.player local.idx 1.0 0.78 0.25
        else if (local.rank == 2)
            ihuddraw_color local.player local.idx 0.76 0.82 0.90
        else if (local.rank == 3)
            ihuddraw_color local.player local.idx 0.82 0.50 0.26
        else
            ihuddraw_color local.player local.idx 0.88 0.90 0.92
        ihuddraw_string local.player local.idx local.text
        ihuddraw_alpha local.player local.idx 1.0
    }

    // Clear stale rows after a row-count reduction or after pruning changes the
    // visible table. This also guarantees the system never touches index 187.
    for (local.idx = local.base + 2 + local.rows; local.idx <= 186; local.idx++)
        waitthread global/feho/hud_lib.scr::hide local.player local.idx

end


has_last_week_winner:

    if (session.leaderboard_last_winner_name == NIL)
        end 0
    if (session.leaderboard_last_winner_xp == NIL)
        end 0

end 1


find_name_index local.names local.name:

    if (local.names == NIL)
        end -1

    for (local.i = 0; local.i < local.names.size; local.i++)
    {
        if (local.names[local.i] == local.name)
            end local.i
    }

end -1


hide_player local.player:

    if (local.player == NIL || local.player == NULL)
        end

    for (local.idx = 165; local.idx <= 186; local.idx++)
        waitthread global/feho/hud_lib.scr::hide local.player local.idx

end


format_kd local.kills local.deaths:

    local.divisor = local.deaths
    if (local.divisor <= 0)
        local.divisor = 1

    // Integer hundredths avoids engine-dependent float string formatting.
    local.scaled = int((local.kills * 100) / local.divisor)
    local.whole = int(local.scaled / 100)
    local.fraction = local.scaled - (local.whole * 100)

    if (local.fraction < 10)
        local.fraction_text = "0" + local.fraction
    else
        local.fraction_text = "" + local.fraction

end (local.whole + "." + local.fraction_text)


format_grouped_integer local.value:

    local.text = "" + int(local.value)
    local.formatted = ""

    for (local.i = 0; local.i < local.text.size; local.i++)
    {
        local.remaining = local.text.size - local.i
        if (local.i > 0 && local.remaining % 3 == 0)
            local.formatted += ","

        local.formatted += local.text[local.i]
    }

end local.formatted


// Persist at map boundaries rather than on every kill. Two alternating files
// keep the previous map's valid snapshot if the process dies while the next
// snapshot is being truncated and written. Files live below fs_homepath/main/.
restore_leaderboard_once:

    if (session.leaderboard_persistence_loaded == 1)
        end

    session.leaderboard_persistence_loaded = 1

    local.current_week = waitthread current_week_key
    local.had_session_week = (session.leaderboard_week != NIL)
    local.a = waitthread load_leaderboard_snapshot "leaderboard/weekly_a.dat"
    local.b = waitthread load_leaderboard_snapshot "leaderboard/weekly_b.dat"

    local.latest = NIL
    local.max_sequence = 0

    if (local.a != NIL)
    {
        local.latest = local.a
        local.max_sequence = local.a["sequence"]
    }

    if (local.b != NIL && (local.latest == NIL || local.b["sequence"] > local.latest["sequence"]))
        local.latest = local.b

    if (local.b != NIL && local.b["sequence"] > local.max_sequence)
        local.max_sequence = local.b["sequence"]

    session.leaderboard_snapshot_sequence = local.max_sequence

    // A new version can be loaded on a map change in an already-running
    // process. In that case, prefer its newer in-memory table over disk, but
    // still initialize the previous-winner HUD state added by this version.
    if (local.had_session_week)
    {
        waitthread load_last_week_winner local.current_week
        end
    }

    session.leaderboard = NIL
    session.leaderboard_week = local.current_week

    if (local.latest != NIL && local.latest["week"] == local.current_week)
        session.leaderboard = local.latest["rows"]
    else if (local.latest != NIL && local.latest["week"] < local.current_week)
        waitthread write_week_archive local.latest["week"] local.latest["rows"] local.latest["sequence"]

    waitthread load_last_week_winner local.current_week

end


load_leaderboard_snapshot local.path:

    local.content = fs_read_content local.path
    if (local.content == NIL || local.content == "")
        end NIL

    local.split = waitthread global/strings.scr::split_line local.content 1 "\n"
    if (local.split == NIL || local.split[2] < 2)
        end NIL

    local.lines = local.split[1]
    local.line_count = local.split[2]
    if (local.lines[local.line_count] == NIL || local.lines[local.line_count] == "")
        local.line_count--

    local.header = waitthread global/strings.scr::split_line local.lines[1] 1 "|"
    if (local.header == NIL || local.header[2] != 4)
        end NIL
    local.format = local.header[1][1]
    local.version = 0
    if (local.format == "weekly-leaderboard-v1")
        local.version = 1
    else if (local.format == "weekly-leaderboard-v2")
        local.version = 2
    else if (local.format == "weekly-leaderboard-v3")
        local.version = 3
    else
        end NIL

    local.week = int(local.header[1][2])
    local.sequence = int(local.header[1][3])
    local.count = int(local.header[1][4])

    local.expected_header = local.format + "|" + local.week + "|" + local.sequence + "|" + local.count
    if (local.lines[1] != local.expected_header)
        end NIL
    if (local.week <= 0 || local.sequence <= 0 || local.count < 0 || local.count > 100)
        end NIL
    if (local.line_count != local.count + 2)
        end NIL

    local.expected_footer = "end|" + local.week + "|" + local.sequence + "|" + local.count
    if (local.lines[local.count + 2] != local.expected_footer)
        end NIL

    for (local.i = 0; local.i < local.count; local.i++)
    {
        local.row = waitthread parse_snapshot_row local.lines[local.i + 2] local.version
        if (local.row == NIL)
            end NIL

        local.name = local.row["name"]
        local.rows[local.name]["xp"] = local.row["xp"]
        local.rows[local.name]["kills"] = local.row["kills"]
        local.rows[local.name]["deaths"] = local.row["deaths"]
    }

    local.snapshot["week"] = local.week
    local.snapshot["sequence"] = local.sequence
    local.snapshot["rows"] = local.rows

end local.snapshot


parse_snapshot_row local.line local.version:

    local.first = waitthread find_snapshot_separator local.line 0
    if (local.first <= 0)
        end NIL

    local.second = waitthread find_snapshot_separator local.line (local.first + 1)
    if (local.second <= local.first + 1 || local.second >= local.line.size - 1)
        end NIL

    if (local.version == 1)
    {
        local.xp_text = "0"
        local.kills_text = waitthread global/strings.scr::Mid 1 local.line local.first
        local.deaths_text = waitthread global/strings.scr::Mid (local.first + 2) local.line (local.second - local.first - 1)
        local.name = waitthread global/strings.scr::Mid (local.second + 2) local.line (local.line.size - local.second - 1)
    }
    else
    {
        local.third = waitthread find_snapshot_separator local.line (local.second + 1)
        if (local.third <= local.second + 1 || local.third >= local.line.size - 1)
            end NIL

        local.xp_text = waitthread global/strings.scr::Mid 1 local.line local.first
        local.kills_text = waitthread global/strings.scr::Mid (local.first + 2) local.line (local.second - local.first - 1)
        local.deaths_text = waitthread global/strings.scr::Mid (local.second + 2) local.line (local.third - local.second - 1)
        local.name = waitthread global/strings.scr::Mid (local.third + 2) local.line (local.line.size - local.third - 1)
    }

    local.xp = int(local.xp_text)
    local.kills = int(local.kills_text)
    local.deaths = int(local.deaths_text)
    if (local.xp < 0 || local.kills < 0 || local.deaths < 0 || local.name == "")
        end NIL
    if (local.xp_text != "" + local.xp || local.kills_text != "" + local.kills || local.deaths_text != "" + local.deaths)
        end NIL

    // v1 had no XP field. v2 introduced XP but migrated those existing kills
    // at zero, so conservatively raise both legacy formats to the base kill-XP
    // floor. Keeping a larger recorded value preserves objective and bonus XP.
    if (local.version <= 2)
    {
        local.minimum_xp = local.kills * (waitthread legacy_kill_xp)
        if (local.xp < local.minimum_xp)
            local.xp = local.minimum_xp
    }

    local.row["name"] = local.name
    local.row["xp"] = local.xp
    local.row["kills"] = local.kills
    local.row["deaths"] = local.deaths

end local.row


find_snapshot_separator local.line local.start:

    for (local.i = local.start; local.i < local.line.size; local.i++)
    {
        if (local.line[local.i] == "|")
            end local.i
    }

end -1


save_leaderboard:

    local.week = waitthread current_week_key
    local.sequence = session.leaderboard_snapshot_sequence
    if (local.sequence == NIL || local.sequence < 0)
        local.sequence = 0
    local.sequence++
    session.leaderboard_snapshot_sequence = local.sequence

    local.payload = waitthread build_snapshot_payload local.week local.sequence session.leaderboard

    if (local.sequence % 2 == 0)
        fs_write_content "leaderboard/weekly_a.dat" local.payload
    else
        fs_write_content "leaderboard/weekly_b.dat" local.payload

end


// Completed weeks are retained permanently by week key. The active week keeps
// using weekly_a.dat/weekly_b.dat so frequent map-boundary saves do not create
// an unbounded number of partial files.
write_week_archive local.week local.table local.sequence:

    if (local.week == NIL || local.week <= 0)
        end
    if (local.sequence == NIL || local.sequence <= 0)
        local.sequence = 1

    local.payload = waitthread build_snapshot_payload local.week local.sequence local.table
    local.path = "leaderboard/weekly_" + local.week + ".dat"
    fs_write_content local.path local.payload

end


build_snapshot_payload local.week local.sequence local.table:

    local.names = waitthread sorted_table_names local.table
    local.count = 0
    if (local.names != NIL)
        local.count = local.names.size

    local.payload = "weekly-leaderboard-v3|" + local.week + "|" + local.sequence + "|" + local.count

    for (local.i = 0; local.i < local.count; local.i++)
    {
        local.name = local.names[local.i]
        local.xp = local.table[local.name]["xp"]
        local.kills = local.table[local.name]["kills"]
        local.deaths = local.table[local.name]["deaths"]

        // OpenMoHAA sanitizes control characters out of netnames, so a name
        // cannot create another line. Pipes are safe because name is last.
        local.payload += "\n" + local.xp + "|" + local.kills + "|" + local.deaths + "|" + local.name
    }

    local.payload += "\nend|" + local.week + "|" + local.sequence + "|" + local.count

end local.payload


legacy_kill_xp:

    local.value = getcvar "xp_kill"
    if (local.value == NIL || local.value == "")
        local.value = 100

    local.amount = int(local.value)
    if (local.amount < 0)
        local.amount = 0

end local.amount


load_last_week_winner local.current_week:

    session.leaderboard_last_winner_name = NIL
    session.leaderboard_last_winner_xp = NIL

    local.last_week = local.current_week - 1
    local.path = "leaderboard/weekly_" + local.last_week + ".dat"
    local.snapshot = waitthread load_leaderboard_snapshot local.path
    if (local.snapshot == NIL || local.snapshot["week"] != local.last_week)
        end

    local.names = waitthread sorted_table_names local.snapshot["rows"]
    if (local.names == NIL || local.names.size == 0)
        end

    session.leaderboard_last_winner_name = local.names[0]
    session.leaderboard_last_winner_xp = local.snapshot["rows"][local.names[0]]["xp"]

end


// Clear stats when local calendar time crosses into a new Monday-based week.
// Gregorian 0001-01-01 was a Monday, so dividing its zero-based absolute day by
// seven yields a stable week key without needing a weekday API.
reset_if_new_week:

    local.week = waitthread current_week_key

    // Preserve an existing table when this feature first establishes its week
    // marker. Future week changes clear both the table and its old marker.
    if (session.leaderboard_week == NIL)
    {
        session.leaderboard_week = local.week
        end
    }

    if (session.leaderboard_week != local.week)
    {
        local.completed_week = session.leaderboard_week
        if (local.completed_week < local.week)
        {
            waitthread prune_leaderboard 100
            waitthread write_week_archive local.completed_week session.leaderboard session.leaderboard_snapshot_sequence
        }

        session.leaderboard = NIL
        session.leaderboard_week = local.week
        waitthread load_last_week_winner local.week
    }

end


current_week_key:

    // getdate format is fixed by OpenMoHAA: dd.mm.yyyy hh:mm:ss AM/PM. The
    // parser requires one expression argument for return-value commands; the
    // engine ignores this dummy value for getdate.
    local.date = getdate 0
    local.day_text = waitthread global/strings.scr::Mid 1 local.date 2
    local.month_text = waitthread global/strings.scr::Mid 4 local.date 2
    local.year_text = waitthread global/strings.scr::Mid 7 local.date 4

    local.day = int(local.day_text)
    local.month = int(local.month_text)
    local.year = int(local.year_text)

    local.days_before_month = waitthread days_before_month local.month
    if (local.month > 2 && (waitthread is_leap_year local.year))
        local.days_before_month++

    local.previous_year = local.year - 1
    local.absolute_day = (local.previous_year * 365)
    local.absolute_day += int(local.previous_year / 4)
    local.absolute_day -= int(local.previous_year / 100)
    local.absolute_day += int(local.previous_year / 400)
    local.absolute_day += local.days_before_month + local.day

    // Keep the cast out of the return statement. In this grammar, `end int()`
    // can return the literal command name instead of evaluating the cast.
    local.week = int((local.absolute_day - 1) / 7)

end local.week


days_before_month local.month:

    if (local.month == 1) end 0
    if (local.month == 2) end 31
    if (local.month == 3) end 59
    if (local.month == 4) end 90
    if (local.month == 5) end 120
    if (local.month == 6) end 151
    if (local.month == 7) end 181
    if (local.month == 8) end 212
    if (local.month == 9) end 243
    if (local.month == 10) end 273
    if (local.month == 11) end 304

end 334


is_leap_year local.year:

    if (local.year % 400 == 0)
        end 1
    if (local.year % 100 == 0)
        end 0
    if (local.year % 4 == 0)
        end 1

end 0


// getarraykeys returns a compact zero-indexed list. Selection sort is fine for
// the bounded 100-entry table and avoids retaining a second session structure.
sorted_names:

    local.names = waitthread sorted_table_names session.leaderboard

end local.names


sorted_table_names local.table:

    if (local.table == NIL)
        end NIL

    local.names = getarraykeys local.table
    if (local.names == NIL || local.names.size == 0)
        end NIL

    for (local.i = 0; local.i < local.names.size - 1; local.i++)
    {
        local.best = local.i

        for (local.j = local.i + 1; local.j < local.names.size; local.j++)
        {
            local.candidate = local.names[local.j]
            local.current = local.names[local.best]
            local.candidate_xp = local.table[local.candidate]["xp"]
            local.current_xp = local.table[local.current]["xp"]

            if (local.candidate_xp > local.current_xp)
                local.best = local.j
            else if (local.candidate_xp == local.current_xp)
            {
                // Kills, then fewer deaths, keep equal-XP ordering useful.
                local.candidate_kills = local.table[local.candidate]["kills"]
                local.current_kills = local.table[local.current]["kills"]
                if (local.candidate_kills > local.current_kills)
                    local.best = local.j
                else if (local.candidate_kills == local.current_kills)
                {
                    local.candidate_deaths = local.table[local.candidate]["deaths"]
                    local.current_deaths = local.table[local.current]["deaths"]
                    if (local.candidate_deaths < local.current_deaths)
                        local.best = local.j
                }
            }
        }

        if (local.best != local.i)
        {
            local.swap = local.names[local.i]
            local.names[local.i] = local.names[local.best]
            local.names[local.best] = local.swap
        }
    }

end local.names


prune_leaderboard local.keep:

    local.names = waitthread sorted_names
    if (local.names == NIL || local.names.size <= local.keep)
        end

    for (local.i = local.keep; local.i < local.names.size; local.i++)
        session.leaderboard[local.names[local.i]] = NIL

end
