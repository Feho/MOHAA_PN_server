/*
Battlefield-style tickets for team respawn maps.

Deaths drain the victim team's tickets. When a team reaches 0 tickets, that
team can no longer respawn. The team loses once no live players remain.
*/

main:
    if (level.tickets_initialized == 1)
        end

	setcvar "g_gametype" "4"
	setcvar "g_gametypestring" "Ticket-Match"
	setcvar "fraglimit" "0"
	setcvar "timelimit" "1" // prevents round restart that can crash players
    level.dmroundlimit = 15
	level.dmrespawning = 1
	level.clockside = "kills" // tickets keeps this in sync; engine uses it at round-end
    level.tickets_initialized = 1
    level.tickets_round_over = 0
    level.tickets_allies_respawn_stopped = 0
    level.tickets_axis_respawn_stopped = 0
    level.tickets_blink_state = 0
    level.tickets_hud_gen = 0

    wait 2
    waitthread init_tickets

    event_subscribe "player_killed" event_player_killed
    event_subscribe "player_spawned" event_player_spawned
    event_subscribe "player_disconnecting" event_player_disconnecting

    thread tickets_hud_loop
    thread tickets_win_monitor

    println ("[Tickets] initialized start=" + level.tickets_start + " allies=" + level.tickets_allies + " axis=" + level.tickets_axis)
end

init_tickets:
    local.active_players = waitthread count_active_players
    // 16 per player targets ~15-min rounds at the observed ~10 deaths/min/team rate.
    local.start = local.active_players * 16

    if (local.start < 60)
        local.start = 60

    level.tickets_start = local.start
    level.tickets_allies = local.start
    level.tickets_axis = local.start
end

count_active_players:
    local.count = 0

    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        local.player = $player[local.i]
        if (local.player != NIL && local.player != NULL && local.player.dmteam != "spectator")
            local.count++
    }

end local.count

event_player_killed local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:
    if (level.tickets_round_over == 1)
        end

    local.victim = self
    if (local.victim == NIL || local.victim == NULL)
        end

    local.team = local.victim.dmteam
    if (local.team != "allies" && local.team != "axis")
        end

    // Ticket arithmetic and its side effects (decrement, stopteamrespawn) must run
    // for every kill. The HUD is now a single global huddraw set (~13 ops total, not
    // per-player), but a grenade killing N players still fires this handler N times in
    // one frame — N redraws. So the redraw stays deferred + coalesced (see
    // request_ticket_hud_refresh): all N kills decrement synchronously this frame,
    // then a single redraw next frame shows the final counts. update_clockside and
    // check_ticket_winner are cheap and stay per-kill; pulse_team_count self-guards.
    waitthread remove_ticket local.team
    thread request_ticket_hud_refresh
    waitthread update_clockside
    waitthread check_ticket_winner
    thread pulse_team_count local.team
end

event_player_spawned:
    if (level.tickets_round_over == 1)
        end

    if (self == NIL || self == NULL)
        end

    if (isBot self)
        end

    // Global HUD already shows for everyone; one redraw ensures the just-spawned
    // player sees current counts immediately (tickets_hud_loop also refreshes ~1s).
    waitthread update_ticket_hud
    thread show_ticket_help self
end

event_player_disconnecting:
    if (self == NIL || self == NULL)
        end

    waitthread check_ticket_winner
end

remove_ticket local.team:
    if (local.team == "allies")
    {
        if (level.tickets_allies > 0)
            level.tickets_allies--

        if (level.tickets_allies <= 0)
        {
            level.tickets_allies = 0
            if (level.tickets_allies_respawn_stopped != 1)
            {
                level.tickets_allies_respawn_stopped = 1
                stopteamrespawn "american"
                thread global/feho/notify.scr::show "Allies have no respawns left!" "warning" 5.0
                println "[Tickets] allied tickets depleted; stopped American respawns"
                thread play_ticket_depleted_sound
            }
        }
    }
    else if (local.team == "axis")
    {
        if (level.tickets_axis > 0)
            level.tickets_axis--

        if (level.tickets_axis <= 0)
        {
            level.tickets_axis = 0
            if (level.tickets_axis_respawn_stopped != 1)
            {
                level.tickets_axis_respawn_stopped = 1
                stopteamrespawn "german"
                thread global/feho/notify.scr::show "Axis have no respawns left!" "warning" 5.0
                println "[Tickets] axis tickets depleted; stopped German respawns"
                thread play_ticket_depleted_sound
            }
        }
    }
end

remove_team_tickets local.team local.amount local.reason local.message:
    if (level.tickets_initialized != 1 || level.tickets_round_over == 1)
        end

    if (local.team != "allies" && local.team != "axis")
        end

    if (local.amount <= 0)
        end

    for (local.i = 1; local.i <= local.amount; local.i++)
        waitthread remove_ticket local.team

    waitthread update_all_ticket_huds
    waitthread update_clockside
    waitthread check_ticket_winner
    thread pulse_team_count local.team

    waitthread print_ticket_loss local.team local.amount local.message

    if (local.reason != NIL)
        println ("[Tickets] " + local.team + " -" + local.amount + " (" + local.reason + ")")
end

remove_team_tickets_percent local.team local.percent local.reason local.message:
    if (level.tickets_initialized != 1)
        end

    local.amount = int((level.tickets_start * local.percent) / 100)
    if (local.amount < 1)
        local.amount = 1

    waitthread remove_team_tickets local.team local.amount local.reason local.message
end

print_ticket_loss local.team local.amount local.message:
    if (local.message == NIL)
        end

    if (local.amount <= 0)
        end

    if (local.team == "allies")
        local.team_label = "Allies"
    else if (local.team == "axis")
        local.team_label = "Axis"
    else
        end

    thread global/feho/notify.scr::show (local.message + " " + local.team_label + " -" + local.amount + " tickets") "info" 4.0
end

play_ticket_depleted_sound:
    $player[0] loopsound bombtick
    wait 1
    $player[0] stoploopsound
end

show_ticket_help local.player:
    if (local.player == NIL || local.player == NULL)
        end

    if (local.player.tickets_help_shown == 1)
        end

    local.player.tickets_help_shown = 1

    for (local.i = 1; local.i <= 2; local.i++)
    {
        wait 15
        if (!local.player)
            end
        local.player iprint "TICKET MODE: Deaths reduce team tickets."

        wait 4
        if (!local.player)
            end
        local.player iprint "At 0 tickets, your team cannot respawn."

        wait 4
        if (!local.player)
            end
        local.player iprint "Reduce enemy tickets to 0, then eliminate survivors."
        wait 120
    }
end

tickets_win_monitor:
    while (level.tickets_round_over != 1)
    {
        waitthread check_ticket_winner
        wait 0.5
    }
end

check_ticket_winner:
    if (level.tickets_round_over == 1)
        end

    local.allies_alive = waitthread count_alive_team "allies"
    local.axis_alive = waitthread count_alive_team "axis"

    if (level.tickets_allies <= 0 && local.allies_alive <= 0)
        waitthread finish_round "axis"
    else if (level.tickets_axis <= 0 && local.axis_alive <= 0)
        waitthread finish_round "allies"
end

update_clockside:
    // Keep level.clockside in sync with ticket state so the engine round-end
    // (driven by level.dmroundlimit) picks the right winner. "kills" tells the
    // engine to pick the team with more live members at expiration.
    if (level.tickets_allies > level.tickets_axis)
        level.clockside = "allies"
    else if (level.tickets_axis > level.tickets_allies)
        level.clockside = "axis"
    else
        level.clockside = "kills"
end

finish_round local.winner:
    if (level.tickets_round_over == 1)
        end

    level.tickets_round_over = 1
    waitthread update_all_ticket_huds

    exec global/feho/maprotate.scr // sets nexmap if it is unset

    if (local.winner == "allies")
    {
        println "[Tickets] allies win"
        teamwin allies
    }
    else if (local.winner == "axis")
    {
        println "[Tickets] axis win"
        teamwin axis
    }
end

count_alive_team local.team:
    local.count = 0

    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        local.player = $player[local.i]
        if (local.player == NIL || local.player == NULL)
            continue

        if (local.player.dmteam != local.team)
            continue

        if (isalive local.player && !local.player.isSpectator)
            local.count++
    }

end local.count

tickets_hud_loop:
    while (level.tickets_round_over != 1)
    {
        local.has_critical = waitthread has_critical_tickets
        if (local.has_critical == 1)
        {
            if (level.tickets_blink_state == 1)
                level.tickets_blink_state = 0
            else
                level.tickets_blink_state = 1
        }
        else
            level.tickets_blink_state = 0

        waitthread update_all_ticket_huds

        if (local.has_critical == 1)
            wait 0.5
        else
            wait 1
    }
end

pulse_team_count local.team:
    if (local.team == "allies")
    {
        if (level.tickets_allies_pulsing == 1) end
        level.tickets_allies_pulsing = 1
        local.idx = 244
    }
    else if (local.team == "axis")
    {
        if (level.tickets_axis_pulsing == 1) end
        level.tickets_axis_pulsing = 1
        local.idx = 247
    }
    else
        end

    // Fade down quickly then ease back up to 1.0.
    local.down_steps = 3.0
    local.up_steps = 5.0
    local.min_alpha = 0.2
    local.down_wait = 0.04
    local.up_wait = 0.05

    for (local.s = 1; local.s <= local.down_steps; local.s++)
    {
        local.t = local.s / local.down_steps
        local.alpha = 1.0 - ((1.0 - local.min_alpha) * local.t)
        waitthread apply_team_alpha local.idx local.alpha
        wait local.down_wait
    }

    for (local.s = 1; local.s <= local.up_steps; local.s++)
    {
        local.t = local.s / local.up_steps
        local.alpha = local.min_alpha + ((1.0 - local.min_alpha) * local.t)
        waitthread apply_team_alpha local.idx local.alpha
        wait local.up_wait
    }

    if (local.team == "allies")
        level.tickets_allies_pulsing = 0
    else
        level.tickets_axis_pulsing = 0
end

// Global HUD: one huddraw_alpha sets the shared element for all clients.
apply_team_alpha local.idx local.alpha:
    huddraw_alpha local.idx local.alpha
end

// Coalesced, 1-frame-deferred ticket-HUD redraw. Spawn this async (thread, NOT
// waitthread) per kill: all same-frame spawns bump level.tickets_hud_gen, capture
// their own gen, then park on the same waitframe. Next frame only the last (highest
// gen) survives the guard and redraws once; the earlier ones bail. The generation
// token lives on LEVEL, not self — this handler's self is the VICTIM, a different
// entity each kill, so a self.* token would never dedup. Deferring one frame (not
// via tickets_hud_loop's 0.5-1s cadence) keeps counts current: all remove_ticket
// calls already ran synchronously this frame before the redraw fires.
request_ticket_hud_refresh:
    level.tickets_hud_gen++
    local.gen = level.tickets_hud_gen

    waitframe

    if (level.tickets_hud_gen != local.gen)
        end

    waitthread update_all_ticket_huds
end

// The tickets HUD is identical for everyone, so it's drawn once with the global
// huddraw_* family (one shared HUD) rather than looping ihuddraw per player.
update_all_ticket_huds:
    waitthread update_ticket_hud
end

update_ticket_hud:
    local.base = 240
    local.y = -78

    // --- Backdrop panel at index 240 (lowest, draws behind the text indices 241-246)
    // white.tga base lets huddraw_color tint each team's panel. Kept dark + desaturated
    // (low luminance) so the bright team text (allies blue / axis red) stays readable on top.
    // Indices 240/241 back the allies side, 242/243 the axis side.
    waitthread global/feho/hud_lib.scr::draw_rect_color_global local.base "center" "bottom" -234 (local.y - 1) 40 20 ( 0.012 0.020 0.036 ) 0.6
    waitthread global/feho/hud_lib.scr::draw_rect_color_global (local.base + 1) "center" "bottom" -104 (local.y + 4) 200 10 ( 0.012 0.020 0.036 ) 0.6
    waitthread global/feho/hud_lib.scr::draw_rect_color_global (local.base + 2) "center" "bottom" 105 (local.y + 4) 200 10 ( 0.036 0.012 0.012 ) 0.6
    waitthread global/feho/hud_lib.scr::draw_rect_color_global (local.base + 3) "center" "bottom" 235 (local.y - 1) 40 20 ( 0.036 0.012 0.012 ) 0.6

    local.allies_tickets = waitthread format_ticket_count level.tickets_allies
    local.axis_tickets = level.tickets_axis
    local.allies_critical = waitthread is_critical_tickets level.tickets_allies
    local.axis_critical = waitthread is_critical_tickets level.tickets_axis

    huddraw_align (local.base + 4) "center" "bottom"
    huddraw_rect (local.base + 4) -249 (local.y - 1) 0 0
    huddraw_font (local.base + 4) "courier-20"
    waitthread set_ticket_color (local.base + 4) "allies" local.allies_critical
    huddraw_string (local.base + 4) local.allies_tickets
    huddraw_alpha (local.base + 4) 1.0

    // Bar fills (indices 245/246) draw on top of the backdrop tracks (241/242).
    // The dark team-tinted backdrop is the empty track; this bright rect is the fill.
    // Both deplete from the outer edge toward the center, matching the old #-bar.
    waitthread draw_ticket_fill (local.base + 5) "allies" level.tickets_allies local.allies_critical
    waitthread draw_ticket_fill (local.base + 6) "axis" level.tickets_axis local.axis_critical

    huddraw_align (local.base + 7) "center" "bottom"
    huddraw_rect (local.base + 7) 220 (local.y - 1) 0 0
    huddraw_font (local.base + 7) "courier-20"
    waitthread set_ticket_color (local.base + 7) "axis" local.axis_critical
    huddraw_string (local.base + 7) local.axis_tickets
    huddraw_alpha (local.base + 7) 1.0

    waitthread update_last_stand_hud local.base local.y
end

format_ticket_count local.tickets:
    if (local.tickets < 0)
        local.tickets = 0

    if (local.tickets == 0)
        end ("0")

    if (local.tickets < 10)
        end ("  " + local.tickets)
    else if (local.tickets < 100)
        end (" " + local.tickets)

end ("" + local.tickets)

// Draw a team's ticket bar as a colored fill rect over its backdrop track.
//   allies track spans x=[-204,-4] (backdrop 241, center -104 w 200)
//   axis   track spans x=[5,205]  (backdrop 242, center  105 w 200)
// Both deplete from the outer edge inward, mirroring the old #-bar direction.
// At 0 tickets the fill is hidden (alpha 0); the last-stand HUD covers that state.
draw_ticket_fill local.idx local.team local.tickets local.is_critical:
    local.track_w = 200
    local.bar_h = 10   // matches the backdrop track height (both trimmed 20% from 13)
    local.y = -78

    // Multiply before dividing: int/int truncates in this language, so
    // tickets/start would floor to 0 for any value below start. (tickets*200)/start
    // yields a smooth 0..200 fill — same pattern build_bar used to avoid this.
    if (level.tickets_start <= 0)
        end
    local.fill_w = (local.tickets * local.track_w) / level.tickets_start
    if (local.fill_w < 0)
        local.fill_w = 0
    if (local.fill_w > local.track_w)
        local.fill_w = local.track_w

    if (local.fill_w <= 0)
    {
        huddraw_alpha local.idx 0.0
        end
    }

    // Muted fill tints — dimmer/desaturated vs the bright ticket-number text, so the
    // bar reads as a calm gauge rather than a flashy block. The number text (244/247)
    // keeps the vivid set_ticket_color values.
    if (local.team == "allies")
    {
        local.fill_rgb = ( 0.375 0.575 0.81 )
        local.center_x = -204 + (local.fill_w / 2)   // anchor at outer (left) edge
    }
    else
    {
        local.fill_rgb = ( 0.81 0.34 0.27 )
        local.center_x = 205 - (local.fill_w / 2)     // anchor at outer (right) edge
    }

    // Critical-blink still wins, but in a softened amber to match the calmer bar.
    if (local.is_critical == 1 && level.tickets_blink_state == 1)
        local.fill_rgb = ( 0.81 0.685 0.165 )

    waitthread global/feho/hud_lib.scr::draw_rect_color_global local.idx "center" "bottom" local.center_x (local.y + 4) local.fill_w local.bar_h local.fill_rgb 1.0
end

is_critical_tickets local.tickets:
    if (local.tickets > 0 && local.tickets < 10)
        end 1

end 0

has_critical_tickets:
    if (level.tickets_allies > 0 && level.tickets_allies < 10)
        end 1
    if (level.tickets_axis > 0 && level.tickets_axis < 10)
        end 1

end 0

set_ticket_color local.hud_id local.team local.is_critical:
    if (local.is_critical == 1 && level.tickets_blink_state == 1)
        huddraw_color local.hud_id 1.00 0.85 0.15
    else if (local.team == "allies")
        huddraw_color local.hud_id 0.45 0.70 1.00
    else
        huddraw_color local.hud_id 1.00 0.38 0.28
end

update_last_stand_hud local.base local.y:
    local.message = NIL

    if (level.tickets_allies <= 0 && level.tickets_axis <= 0)
    {
        local.allies_alive = waitthread count_alive_team "allies"
        local.axis_alive = waitthread count_alive_team "axis"
        local.message = ("LAST STAND: ALLIES " + local.allies_alive + " | AXIS " + local.axis_alive)
    }
    else if (level.tickets_allies <= 0)
    {
        local.allies_alive = waitthread count_alive_team "allies"
        local.message = ("ALLIES LAST STAND: " + local.allies_alive + " ALIVE")
    }
    else if (level.tickets_axis <= 0)
    {
        local.axis_alive = waitthread count_alive_team "axis"
        local.message = ("AXIS LAST STAND: " + local.axis_alive + " ALIVE")
    }

    if (local.message == NIL)
    {
        huddraw_alpha (local.base + 8) 0.0
        end
    }

    huddraw_align (local.base + 8) "center" "bottom"
    huddraw_rect (local.base + 8) -120 (local.y - 20) 0 0
    huddraw_font (local.base + 8) "courier-20"
    huddraw_color (local.base + 8) 0.95 0.95 0.80
    huddraw_string (local.base + 8) local.message
    huddraw_alpha (local.base + 8) 1.0
end
