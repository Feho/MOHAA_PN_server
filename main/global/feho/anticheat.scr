main:

    if (level.anticheat_initialized) end

    level.anticheat_initialized = 1

    event_subscribe "player_killed" event_player_killed
    event_subscribe "player_spawned" event_player_spawned
    event_subscribe "player_damaged" event_player_damaged

    // --- Honeypot tuning ---
    level.honeypot_chance = 10       // 1-in-N bot spawns arm the trap
    level.honeypot_duration = 1.0    // seconds the bot stays hidden/lifted
    level.honeypot_lift = 512        // Z offset (units) to lift the bait out of reach (~8 player-heights / ~4 floors)

end

event_player_killed local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:

    if (local.location == -1) end // grenade, bash...

    if (isBot local.attacker) end

    if (!local.attacker.prev_kill_time)
    {
        local.attacker.prev_kill_angle = local.attacker.angle
        local.attacker.prev_kill_time = level.time
        end
    }

    if (!local.attacker.suspicion_level) local.attacker.suspicion_level = 0

    if (local.attacker.suspicion_level > 0)
    {
        // Decrease the damage of the attacker's weapon based on their suspicion level
        local.attacker weaponcommand dual dmbulletdamage (50 / local.attacker.suspicion_level)
    }

    local.time_diff = level.time - local.attacker.prev_kill_time
    if (local.time_diff == 0) local.time_diff = 0.01

    local.angle_diff = local.attacker.angle - local.attacker.prev_kill_angle

    local.attacker.prev_kill_angle = local.attacker.angle
    local.attacker.prev_kill_time = level.time

    // Angle normalization
    if (local.angle_diff > 180) local.angle_diff = local.angle_diff - 360
    if (local.angle_diff < -180) local.angle_diff = local.angle_diff + 360
    if (local.angle_diff < 0) local.angle_diff = local.angle_diff * -1

    local.degrees_per_second = local.angle_diff / local.time_diff

    // I think values higher than 100 deg/s could be considered suspicious, as they are likely to indicate the use of an aimbot.
    if (local.degrees_per_second > 100)
    {
        local.developer = getcvar "developer"
        setcvar "developer" 1
        println ("^1Potential aimbot detected for " + netname local.attacker + " with " + local.degrees_per_second + " degrees per second")
        setcvar "developer" local.developer
        local.attacker.suspicion_level += 1

        // Decrease the damage of the attacker's weapon based on their suspicion level
        local.attacker weaponcommand dual dmbulletdamage (50 / local.attacker.suspicion_level)
        println ("^5Suspicion level: " + local.attacker.suspicion_level)
        println ("^5Bullet damage reduced to: " + (50 / local.attacker.suspicion_level))
    }

end

event_player_spawned:

    if (self.suspicion_level && self.suspicion_level > 0)
    {
        self weaponcommand dual dmbulletdamage (50 / self.suspicion_level)
    }

    // Honeypot: occasionally turn a freshly-spawned bot into invisible, unreachable bait.
    if (isBot self && randomint(level.honeypot_chance) == 0)
    {
        thread arm_honeypot self
    }

end

// Lift a bot out of reach, hide it, and mark it armed for ~1s. Any human hit on it
// during that window is logged (log-only: no punishment yet).
arm_honeypot local.bot:

    if (!isalive local.bot) end

    // Generation token: a hit only counts if it matches the generation that is
    // currently armed, so a late/stale hit after disarm can never frame a player.
    if (!local.bot.honeypot_gen) local.bot.honeypot_gen = 0
    local.bot.honeypot_gen += 1
    local.gen = local.bot.honeypot_gen

    local.bot.honeypot_return_origin = local.bot.origin
    local.bot.honeypot_arm_time = level.time
    local.bot.origin = ( local.bot.origin[0]  local.bot.origin[1]  (local.bot.origin[2] + level.honeypot_lift) )
    local.bot hide
    local.bot.is_honeypot = 1

    wait level.honeypot_duration

    // Only disarm if this is still the same arming generation (the bot may have
    // died/respawned and been re-armed during the wait).
    if (local.bot.honeypot_gen == local.gen)
    {
        local.bot.is_honeypot = 0
        local.bot show
        if (isalive local.bot) local.bot.origin = local.bot.honeypot_return_origin
    }

end

event_player_damaged local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:

    // self == the entity that got damaged (the bait, when armed).
    if (!self.is_honeypot) end

    // Guard the attacker: ignore world/NIL, other bots, and self-damage.
    if (!local.attacker) end
    if (isBot local.attacker) end
    if (local.attacker == self) end

    // Ignore explosive/splash/non-bullet damage (location -1 = grenade, bash...).
    if (local.location == -1) end

    // CAUGHT: a human dealt direct damage to an invisible, lifted bot.
    // LOG-ONLY phase — record everything, apply no punishment yet.
    local.dt = level.time - self.honeypot_arm_time
    local.developer = getcvar "developer"
    setcvar "developer" 1
    println ("^1[HONEYPOT] " + netname local.attacker + " hit invisible bait " + netname self + " | map=" + getcvar "mapname" + " | dmg=" + local.damage + " | mod=" + local.meansofdeath + " | loc=" + local.location + " | dt=" + local.dt + "s")
    println ("^5[HONEYPOT] attacker_origin=" + local.attacker.origin + " attacker_angle=" + local.attacker.angle + " bait_origin=" + self.origin)
    setcvar "developer" local.developer

end
