main:

    if (level.anticheat_initialized) end

    level.anticheat_initialized = 1

    event_subscribe "player_killed" event_player_killed
    event_subscribe "player_spawned" event_player_spawned

end

event_player_killed local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:

    if (local.location == -1) end // grenade, bash...

    if (!local.attacker.prev_kill_time)
    {
        local.attacker.prev_kill_angle = local.attacker.angle
        local.attacker.prev_kill_time = level.time
        end
    }

    if (!local.attacker.suspicion_level) local.attacker.suspicion_level = 0

    if (local.attacker.suspicion_level > 0)
    {
        // Decrease the damage of the attacker's weapon based on their suspicion level
        local.attacker weaponcommand dual dmbulletdamage (50 / local.attacker.suspicion_level)
    }

    local.time_diff = level.time - local.attacker.prev_kill_time
    if (local.time_diff == 0) local.time_diff = 0.01

    local.angle_diff = local.attacker.angle - local.attacker.prev_kill_angle

    // Angle normalization
    if (local.angle_diff > 180) local.angle_diff = local.angle_diff - 360
    if (local.angle_diff < -180) local.angle_diff = local.angle_diff + 360
    if (local.angle_diff < 0) local.angle_diff = local.angle_diff * -1

    local.degrees_per_second = local.angle_diff / local.time_diff

    // I think values higher than 100 deg/s could be considered suspicious, as they are likely to indicate the use of an aimbot.
    if (local.degrees_per_second > 100 && !isBot local.attacker)
    {
        local.developer = getcvar "developer"
        setcvar "developer" 1
        println ("^1Potential aimbot detected for " + netname local.attacker + " with " + local.degrees_per_second + " degrees per second")
        setcvar "developer" local.developer
        local.attacker.suspicion_level += 1

        // Decrease the damage of the attacker's weapon based on their suspicion level
        local.attacker weaponcommand dual dmbulletdamage (50 / local.attacker.suspicion_level)
        println ("^5Suspicion level: " + local.attacker.suspicion_level)
        println ("^5Bullet damage reduced to: " + (50 / local.attacker.suspicion_level))
    }

end

event_player_spawned:

    if (self.suspicion_level && self.suspicion_level > 0)
    {
        self weaponcommand dual dmbulletdamage (50 / self.suspicion_level)
    }

end
