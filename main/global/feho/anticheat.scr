main local.command local.class:

    // .st entrycommands do not load `script.scr::label` correctly here, so the
    // mike_torso.st hooks call this file as `exec global/feho/anticheat.scr <command>`.
    if (local.command == "shot_fired")
    {
        waitthread shot_fired local.class
        end
    }

    if (local.command == "weapon_raise")
    {
        waitthread weapon_raise local.class
        end
    }

    if (level.anticheat_initialized) end

    level.anticheat_initialized = 1

    event_subscribe "player_spawned" event_player_spawned

    event_subscribe "player_killed" track_killrate
    // Aimbot gate: kill = known aim point (anchor), first new hit
    // within the window = re-acquisition arc to a new target. Large arc fast
    // = aimbot tell.
    event_subscribe "player_killed" gate_record_kill
    event_subscribe "player_damaged" gate_measure_swing
    event_subscribe "player_damaged" track_mg_accuracy
    event_subscribe "player_damaged" track_headshots

    // --- Honeypot tuning ---
    level.honeypot_chance = 10       // 1-in-N bot spawns arm the trap
    level.honeypot_duration = 1.0    // seconds the bot stays hidden/lifted
    level.honeypot_lift = 512        // Z offset (units) to lift the bait out of reach (~8 player-heights / ~4 floors)

    // --- Aimbot gate tuning ---
    // NOTE: 160 is a conservative *starting* threshold. It is NOT validated for
    // this kill->damage metric — the old kill-to-kill log was censored at 160 so
    // it can't tell us the right value. Retune from the uncensored raw values
    // this gate prints, finding the valley between the human-turn hump and the
    // cheat-snap hump.
    level.ac_gate_degs = 160        // deg/s over which a swing is flagged
    level.ac_gate_window = 1.0      // sec: kill->first-hit must be within this
    level.ac_gate_mindt = 0.1       // sec: ignore pairs tighter than this (same-shot multi-hit / pellets)
    level.ac_flags_to_punish = 2    // punish on the Nth flag this round (flags reset at round boundary, ~15 min max)

    // Nerf applied to a flagged player's weapon (damage scales with flag count;
    // spread is the absolute cone). Re-applied on every weapon raise via the
    // weapon_raise hook in mike_torso.st, so it survives re-pick/respawn/pickup.
    // For reference, stock dmbulletspread mins are ~2-40; 90/150 is deliberately
    // shotgun-wide so a confirmed cheater's shots wander.
    level.ac_nerf_spread = 60      // min spread cone (degrees-ish) for a flagged weapon
    level.ac_nerf_spread_max = 80  // max spread cone (moving / sustained fire)

    // --- MG accuracy telemetry ---
    // Shots are counted from ATTACK_MG_PRIMARY in mike_torso.st. Hits are counted
    // from player_damaged, once per shot sequence, so multi-damage on the same
    // trigger pull cannot inflate accuracy.
    level.ac_mg_hit_window = 0.35       // sec: bullet damage must arrive soon after the MG shot
    level.ac_mg_log_min_shots = 50      // ignore tiny samples
    level.ac_mg_log_every_shots = 25    // print a compact sample every N MG shots

    // --- Kills/min signal ---
    // The ONLY signal that fired on all three confirmed cheaters (racaille's
    // aim looked clean; volume did not). Self-counted from player_killed (engine
    // getkills/getdeaths are unreliable: num_deaths is assigned from round_kills,
    // so K==D in the log). Counted per attacker per round on self.*, anchored on
    // their first kill of the round, so the per-map level.time reset never bites.
    level.ac_kr_min_kills = 40          // need at least this many kills before a rate is meaningful (else -1)
    level.ac_kr_min_elapsed = 30        // ...and at least this many seconds since the first kill (else -1)

    // K/M flag threshold (cvar so it's tunable live without a restart). The
    // watcher only persists/nerfs when this K/M threshold is met after the
    // larger kill sample above AND the player's IP is a VPN/datacenter.
    level.ac_kr_flag_km = int(getcvar "ac_kr_flag_km")
    if (level.ac_kr_flag_km <= 0) level.ac_kr_flag_km = 7    // K/M at/above which we emit [KMFLAG]
    level.ac_kr_log_floor = 3           // log the K/M value once per round when it first crosses this (calibration)

    level.ac_debug = int(getcvar "debug")

    // Consumer loop: lets the external watcher request a nerf by setting the
    // ac_nerf_slot cvar (mirrors antinoob.scr's unblack: idiom).
    thread ac_nerf_consumer

end

// ============================================================================
// Kills/min signal
// ============================================================================
// Self-counted kill rate per attacker per round. This is the only signal that
// fired on all three confirmed cheaters (a smooth/ESP cheat hides its aim but
// not its kill volume). We count here rather than via engine getkills because
// getdeaths is corrupted (num_deaths = round_kills => K==D) and getkills is
// team-mediated; a private counter is deterministic and ours to reset.
//
// Counters live on self.* (the attacker), so they clear at the round boundary
// along with gate_flags/headshot counters. The anchor (ac_kr_t0) is captured on
// the FIRST kill of the round, so the per-map level.time reset never bites: we
// never subtract a time across a reset. Count ALL kills (bots included, any
// means-of-death) — a volume farmer's bot kills are exactly what we want to see.

// player_killed: bump the attacker's per-round kill count; anchor on first kill.
track_killrate local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:

    if (!local.attacker) end
    if (isBot local.attacker) end            // only score humans (victim may be a bot — that's fine)
    if (local.attacker == self) end          // suicide / world death is not a kill

    if (!local.attacker.ac_kr_kills)
    {
        local.attacker.ac_kr_kills = 0
        local.attacker.ac_kr_t0 = level.time // anchor on the first kill of the round
    }
    local.attacker.ac_kr_kills++

    // --- Rate check + flag emit ---
    local.km = waitthread kill_rate local.attacker
    if (local.km < 0) end                      // sample still too small (-1)

    // Observability: log the actual K/M value the first time it crosses the (low)
    // calibration floor this round, so a live session reveals the real
    // distribution and we can set ac_kr_flag_km from data, not a guess.
    if (local.km >= level.ac_kr_log_floor && !local.attacker.ac_kr_logged)
    {
        local.attacker.ac_kr_logged = 1
        local.developer = getcvar "developer"
        setcvar "developer" 1
        println ("^3[KM] " + netname local.attacker + " km=" + local.km + " (" + local.attacker.ac_kr_kills + " kills)")
        setcvar "developer" local.developer
    }

    // Flag emit (latched once per round): the watcher triggers on [KMFLAG]. We
    // print clientnum (= the {#N|ip} slot, the nerf key), ip (for the VPN check,
    // ip:port — the watcher strips the port), and netname (for the audit log).
    if (local.km >= level.ac_kr_flag_km && !local.attacker.ac_kr_flagged)
    {
        local.attacker.ac_kr_flagged = 1
        local.slot = getclientnum local.attacker
        local.ip = getip local.attacker
        local.developer = getcvar "developer"
        setcvar "developer" 1
        println ("^1[KMFLAG] slot=" + local.slot + " ip=" + local.ip + " kills=" + local.attacker.ac_kr_kills + " km=" + local.km + " name=" + netname local.attacker)
        setcvar "developer" local.developer
    }

end

// Returns the attacker's kills/min this round, or -1 if the sample is too small
// (fewer than ac_kr_min_kills kills, or less than ac_kr_min_elapsed seconds since
// the first kill) — mirrors the headshot_ratio -1 convention so the brain reads
// "insufficient sample" the same way across columns.
kill_rate local.who:

    if (!local.who) end
    if (!local.who.ac_kr_kills)
    {
        local.result = -1
        end local.result
    }

    if (local.who.ac_kr_kills < level.ac_kr_min_kills)
    {
        local.result = -1
        end local.result
    }

    local.elapsed = level.time - local.who.ac_kr_t0
    if (local.elapsed < level.ac_kr_min_elapsed)
    {
        local.result = -1
        end local.result
    }

    local.result = (local.who.ac_kr_kills * 60) / local.elapsed
    end local.result

// ============================================================================
// Aimbot gate
// ============================================================================
// A kill is a known aim point (they were aimed at the victim). The FIRST new
// hit within level.ac_gate_window measures the re-acquisition arc to the next
// target. A large arc covered fast = the aimbot "snap". The deg/s figure is an
// AVERAGE velocity over the interval, so a single flag is NOT proof — that is
// why we punish only on the Nth flag (level.ac_flags_to_punish) and the
// punishment stays reversible (a damage nerf, never an auto-kick).
//
// Flags are a plain per-round counter on the player entity. self.* clears at
// the round boundary and a round is ~15 min max, so no time-decay is needed —
// a regular player's rare fast turn won't reach N before the count is wiped.

// player_killed: drop the anchor. Records the aim point and arms the window.
gate_record_kill local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:

    if (local.location == -1) end // grenade, bash... no aim point
    if (!local.attacker) end
    if (isBot local.attacker) end

    local.attacker.gate_kill_angle = local.attacker.angle
    local.attacker.gate_kill_time = level.time
    local.attacker.gate_armed = 1 // consumed by the first qualifying hit below

end

// player_damaged: if a qualifying hit lands inside the window, measure the
// swing, consume the anchor (one trigger-pull -> one measurement), flag if fast.
gate_measure_swing local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:

    if (!local.attacker) end
    if (isBot local.attacker) end
    if (local.attacker == self) end          // self-damage
    if (local.location == -1) end            // grenade, bash... no aim point
    if (!local.attacker.gate_armed) end      // no live kill anchor (already consumed or none)

    local.dt = level.time - local.attacker.gate_kill_time

    // Window: only the re-acquisition right after a kill is interesting.
    if (local.dt >= level.ac_gate_window)
    {
        local.attacker.gate_armed = 0
        end
    }

    // Min-dt floor: a shot that kills A and hits B in the same instant (pellets,
    // a penetrating round) is one shot, not a re-acquisition. Drop it but keep
    // the anchor armed so a genuine later swing within the window still counts.
    if (local.dt < level.ac_gate_mindt) end

    // CONSUME: one kill -> one measurement. Prevents a burst of follow-up hits
    // from recomputing against the same anchor with shrinking dt.
    local.attacker.gate_armed = 0

    local.angle_diff = local.attacker.angle - local.attacker.gate_kill_angle
    if (local.angle_diff > 180) local.angle_diff = local.angle_diff - 360
    if (local.angle_diff < -180) local.angle_diff = local.angle_diff + 360
    if (local.angle_diff < 0) local.angle_diff = local.angle_diff * -1

    local.degs = local.angle_diff / local.dt

    if (local.degs <= level.ac_gate_degs) end

    // --- Flagged. Bump the per-round counter and log the raw (uncensored) value. ---
    if (!local.attacker.gate_flags) local.attacker.gate_flags = 0
    local.attacker.gate_flags++

    local.kills = local.attacker getkills
    local.deaths = local.attacker getdeaths
    local.hs_ratio = waitthread headshot_ratio local.attacker   // -1 if sample too small (see ac_hs_min_hits)

    local.developer = getcvar "developer"
    setcvar "developer" 1
    println ("^1[AIMBOT] " + netname local.attacker + " swing " + local.degs + " deg/s | flags=" + local.attacker.gate_flags + "/" + level.ac_flags_to_punish + " | hs=" + local.hs_ratio + "% (" + local.attacker.ac_hs_heads + "/" + local.attacker.ac_hs_hits + ") | K/D=" + local.kills + "/" + local.deaths)
    setcvar "developer" local.developer

    if (local.attacker.gate_flags >= level.ac_flags_to_punish)
    {
        // Reversible punishment only (auto-lifts at round reset; never auto-kick
        // on an average-velocity metric). Mark them, then nerf the weapon they
        // are holding right now. The raise-hook (weapon_raise) re-applies it on
        // every subsequent weapon raise, so it survives re-pick/respawn/pickup.
        local.attacker.suspicion_level = local.attacker.gate_flags
        waitthread apply_nerf local.attacker

        local.developer = getcvar "developer"
        setcvar "developer" 1
        local.slot = getclientnum local.attacker
        local.ip = getip local.attacker
        println ("^1[AIMBOT] PUNISH slot=" + local.slot + " ip=" + local.ip + " name=" + netname local.attacker + " | flags=" + local.attacker.gate_flags + " | K/D=" + local.kills + "/" + local.deaths + " | nerf->dmg " + (60 / local.attacker.gate_flags))
        setcvar "developer" local.developer
    }

end

// ============================================================================
// Headshot ratio (second signal, LOG-ONLY for now)
// ============================================================================
// Aimbots lock to the head hitbox. The hit location is handed to us directly in
// player_damaged (no world trace needed), so a high headshot fraction over a real
// sample is a near-free aimbot tell. Counted per attacker per round; the counters
// live on self.* so they clear at the round boundary along with gate_flags.
//
// Scope: only AIMED BULLET weapons count toward the sample. Grenades/explosions
// (MOD_GRENADE=14) and bashes (MOD_BASH=25) have no aim point and would pollute
// the ratio, so we restrict to MOD_BULLET=18, MOD_FAST_BULLET=19, MOD_SHOTGUN=26.
// HITLOC: 0=HEAD, 1=HELMET, 2=NECK is the head band (location <= ac_hs_band).

// player_damaged: count one bullet hit, and whether it landed in the head band.
track_headshots local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:

    if (!local.attacker) end
    if (isBot local.attacker) end
    if (local.attacker == self) end          // self-damage

    // Aimed bullet weapons only (exclude grenades, explosions, bash, fire, etc.)
    if (local.meansofdeath != 18 && local.meansofdeath != 19 && local.meansofdeath != 26) end

    if (!local.attacker.ac_hs_hits) local.attacker.ac_hs_hits = 0
    if (!local.attacker.ac_hs_heads) local.attacker.ac_hs_heads = 0

    local.attacker.ac_hs_hits++
    if (local.location >= 0 && local.location <= level.ac_hs_band)
        local.attacker.ac_hs_heads++

end

// Returns the headshot percentage for a player, or -1 if the sample is too small
// (fewer than ac_hs_min_hits tracked bullet hits) to be meaningful.
headshot_ratio local.who:

    if (!local.who) end
    if (!local.who.ac_hs_hits) local.who.ac_hs_hits = 0
    if (!local.who.ac_hs_heads) local.who.ac_hs_heads = 0

    if (local.who.ac_hs_hits < level.ac_hs_min_hits)
    {
        local.result = -1
        end local.result
    }

    local.result = (local.who.ac_hs_heads * 100) / local.who.ac_hs_hits
    end local.result

// ============================================================================
// MG accuracy telemetry
// ============================================================================

// Called from mike_torso.st ATTACK_MG_PRIMARY.
shot_fired local.class:

    if (local.class != "mg") end
    if (isBot self) end

    if (!level.ac_mg_log_min_shots) level.ac_mg_log_min_shots = 50
    if (!level.ac_mg_log_every_shots) level.ac_mg_log_every_shots = 25

    if (!self.ac_mg_shots) self.ac_mg_shots = 0
    if (!self.ac_mg_shot_seq) self.ac_mg_shot_seq = 0

    self.ac_mg_shots++
    self.ac_mg_shot_seq++
    self.ac_mg_last_shot_time = level.time

    if (level.ac_debug == 1)
    {
        local.developer = getcvar "developer"
        setcvar "developer" 1
        println ("^5[ACCURACY:MG:DEBUG] shot " + netname self + " | shots=" + self.ac_mg_shots + " | seq=" + self.ac_mg_shot_seq)
        setcvar "developer" local.developer
    }

    if (!self.ac_mg_next_log_shots)
        self.ac_mg_next_log_shots = level.ac_mg_log_min_shots

    if (self.ac_mg_shots < self.ac_mg_next_log_shots) end

    self.ac_mg_next_log_shots = self.ac_mg_next_log_shots + level.ac_mg_log_every_shots

    waitthread log_mg_accuracy self

end

// player_damaged: count one hit for the attacker's current MG shot sequence.
track_mg_accuracy local.attacker local.damage local.inflictor local.position local.direction local.normal local.knockback local.damageflags local.meansofdeath local.location:

    if (!local.attacker) end
    if (isBot local.attacker) end
    if (local.attacker == self) end          // self-damage
    if (local.location == -1) end            // grenade, bash... no bullet aim point
    if (!local.attacker.ac_mg_shot_seq) end  // attacker has not fired a tracked MG shot

    if (!level.ac_mg_hit_window) level.ac_mg_hit_window = 0.35

    local.dt = level.time - local.attacker.ac_mg_last_shot_time
    if (local.dt > level.ac_mg_hit_window) end

    // Prevent multi-damage, penetration, or any duplicated damage callback from
    // counting as several hits for one MG trigger pull.
    if (local.attacker.ac_mg_hit_seq == local.attacker.ac_mg_shot_seq) end

    local.attacker.ac_mg_hit_seq = local.attacker.ac_mg_shot_seq

    if (!local.attacker.ac_mg_hits) local.attacker.ac_mg_hits = 0
    local.attacker.ac_mg_hits++

end

log_mg_accuracy local.player:

    if (!local.player) end
    if (!local.player.ac_mg_shots) end

    if (!local.player.ac_mg_hits)
        local.player.ac_mg_hits = 0

    local.accuracy = (local.player.ac_mg_hits * 100) / local.player.ac_mg_shots
    local.kills = local.player getkills
    local.deaths = local.player getdeaths

    local.developer = getcvar "developer"
    setcvar "developer" 1
    println ("^3[ACCURACY:MG] " + netname local.player + " acc=" + local.accuracy + "% | hits/shots=" + local.player.ac_mg_hits + "/" + local.player.ac_mg_shots + " | K/D=" + local.kills + "/" + local.deaths)
    setcvar "developer" local.developer

end

// Apply the reversible nerf (damage + accuracy) to the weapon the flagged
// player is CURRENTLY holding. dmbulletdamage/dmbulletspread are per-weapon-
// instance, so this must be re-run whenever a fresh weapon is raised — that is
// what the weapon_raise hook below does.
apply_nerf local.who:

    if (!local.who) end
    if (!local.who.suspicion_level) end
    if (local.who.suspicion_level <= 0) end

    local.who iprintln "Have fun!"

    // Damage: scale down by flag count
    local.who weaponcommand dual dmbulletdamage (60 / local.who.suspicion_level)
    local.who weaponcommand dual dmbulletspread (level.ac_nerf_spread) (level.ac_nerf_spread) (level.ac_nerf_spread_max) (level.ac_nerf_spread_max)
    //local.who setspeed 0.7
    println ("^1[KMNERF] name=" + netname local.who + " -> suspicion=" + local.who.suspicion_level + " nerf applied")

end

// Called from mike_torso.st RAISE_* states: `exec global/feho/anticheat.scr weapon_raise mg`
// self = the raising player. Near-free for the 99% case: an unflagged player
// does one NIL check and returns before any weapon work. Re-applies the nerf to
// the freshly-raised weapon so a flagged cheater can never raise a clean gun.
weapon_raise local.class:

    if (!self.suspicion_level) end
    if (self.suspicion_level <= 0) end

    waitthread apply_nerf self

end

// ============================================================================
// External nerf consumer (watcher -> cvar -> nerf)
// ============================================================================
// The external watcher confirms VPN + K/M flag, then injects into the server
// console: `seta ac_nerf_slot <clientnum>`. This loop consumes that request,
// finds the player by client number, flags them (suspicion_level = 3) and nerfs
// the weapon they hold. The raise-hook (weapon_raise) re-applies it on every
// subsequent raise, so it survives re-pick/respawn until the round resets.
// Idiom mirrors antinoob.scr's unblack: clear -> wait-for-nonempty -> resolve.
ac_nerf_consumer:

    while (1)
    {
        setcvar "ac_nerf_slot" ""
        while (getcvar "ac_nerf_slot" == "") { wait 1 }

        local.slot = int(getcvar "ac_nerf_slot")
        local.who = waitthread find_player_by_clientnum local.slot
        if (local.who)
        {
            local.who.suspicion_level = 3
            waitthread apply_nerf local.who

            local.developer = getcvar "developer"
            setcvar "developer" 1
            println ("^1[KMNERF] slot=" + local.slot + " name=" + netname local.who + " -> suspicion=3 nerf applied")
            setcvar "developer" local.developer
        }
    }

end

// Returns the player entity whose client number == local.slot, or NIL.
find_player_by_clientnum local.slot:

    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        if (getclientnum $player[local.i] == local.slot)
            end $player[local.i]
    }
    end NIL

end

event_player_spawned:

    if (self.suspicion_level && self.suspicion_level > 0)
    {
        wait 2
        if (!self) end // disconnected during the wait
        // Re-apply the nerf: respawn hands a fresh (un-nerfed) weapon instance.
        // The weapon_raise hook also covers later raises within the life.
        waitthread apply_nerf self
    }

end
