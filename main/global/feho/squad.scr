/*
# Squad mod

This mod allows players to be attached to one of the 3 or 4 squads per team.
A squad consists of 4 players, and each player can only be in one squad.
The first player to join a squad is the squad leader.
Each time a player is killed, he respawns near his squad leader.

## Technical details

### Leader selection

Humans outrank bots: a bot holds the leader slot only until a human is available.
Three paths can set a leader, and together they keep that invariant:

  1. First to join an empty squad leads it (`assign_player_to_squad`), human or bot.
  2. On the leader's death or departure, `promote_new_squad_leader` picks a random
     LIVING HUMAN, falling back to a random living bot only if the squad has no
     living human.
  3. When a human spawns into a squad a BOT is leading, they take it over on the
     spot (`try_human_leader_takeover`) — path 2 alone would leave a bot in charge
     of a squad a human joined later, until that bot happened to die.

Path 3 never displaces a human leader: it is bot-to-human only, so a spawning
human cannot take the role from another human. It DOES take over from a dead bot
leader, deliberately — `get_valid_spawn_pos_near_leader` requires a living leader,
so a dead bot in the slot blocks squad respawns until something else promotes.

### Respawning near the squad leader

To be able to respawn near the squad leader, we need to store the last ten positions of the squad leader in an array.
A new position is added to the array when the squad leader moves by a certain distance, and the oldest position is removed from the array.
When a player spawns (event_player_spawned), we check if he is in a squad. If he is, we check if the squad leader is alive. If the squad leader is alive, we respawn the player at one of the last ten positions of the squad leader.

A candidate position is rejected if any player is within 80 units (telefrag guard), or if a
living enemy within `level.squad_spawn_enemy_radius` has line of sight to it — that's the
"respawned in front of an enemy" case. Up to 10 positions are tried; if none is safe the
player just spawns normally. This is complementary to the leader's `is_under_fire` veto:
that one asks whether the LEADER is being shot at right now, while this one checks the
specific history position being considered, which may be many moves behind the leader.

### Hold-position orders

A human squad leader aims at a spot and presses USE to send the squad's bots there.
The bots scatter within `level.squad_hold_radius` of the point and hold for
`level.squad_hold_duration` seconds — the timer starts when each bot arrives, so a long
walk doesn't eat into the guard time. This uses the engine's extended `bot_holdposition`
(vector form); see `docs/scripting_bot_commands.md`.

Because USE is also bomb-planting and vehicle-entry, orders are restricted to squad
leaders who actually have living bots, and are rate-limited by `level.squad_hold_cooldown`.

Set the `squad_debug` cvar to 1 to flash a green beam at each order's destination.
The cvar is read per order, so it can be toggled mid-map. The beam is a world entity
and is therefore visible to everyone — keep it off in production.

*/

main:
    if (level.squad_mod_started == 1) end
    if (getcvar "g_gametype" == 1 || getcvar "g_gametype" == 3 || getcvar "squad" != 1 || level.squad_mod == 0) end

    level.squad_mod_started = 1
    thread init_squad_system
    thread monitor_squads

    event_subscribe "player_spawned" event_player_spawned
    event_subscribe "player_damaged" event_player_damaged
    event_subscribe "player_killed" event_player_killed
    event_subscribe "player_disconnecting" event_player_disconnecting
    //println "Squad Mod Subscribed to Events."
end

init_squad_system:
    level.squad_max_squads_per_team = 6
    level.squad_max_players_per_squad = 4
    level.squad_leader_pos_history_count = 20
    level.squad_leader_pos_update_distance = 64.0 // Use float for distance checks
    level.squad_leader_pos_update_interval = 0.5 // Seconds
    // A living enemy closer than this WITH line of sight vetoes a spawn spot.
    // Raise it and more spots get rejected, so more players fall back to the base
    // spawn; lower it and squadmates keep popping up inside firefights.
    level.squad_spawn_enemy_radius = 384

    // --- Hold-position orders (human presses USE to order squad bots to a spot) ---
    level.squad_hold_radius = 128   // bots scatter within this radius of the aim point
    level.squad_hold_duration = 15  // seconds held, clock starts when each bot arrives
    level.squad_hold_max_range = 4096 // max crosshair trace distance
    level.squad_hold_cooldown = 3   // seconds between orders, per player

    for (local.i = 1; local.i <= level.squad_max_squads_per_team; local.i++)
    {
        level.squads[1][local.i] = NIL
        level.squads[2][local.i] = NIL
        level.squad_leaders[1][local.i] = NIL
        level.squad_leaders[2][local.i] = NIL
    }

    //println "Squad Mod System Initialized."
end

// Prints squads and their members for debugging every 10 seconds
monitor_squads:
    while(1)
    {
        wait 30

        for (local.team_idx = 1; local.team_idx <= 2; local.team_idx++)
        {
            for (local.squad_idx = 1; local.squad_idx <= level.squad_max_squads_per_team; local.squad_idx++)
            {
                local.squad_members = level.squads[local.team_idx][local.squad_idx]

                if (local.squad_members != NIL)
                {
                    println("             Team " + local.team_idx + ", Squad " + local.squad_idx + " Members:")

                    for (local.i = 1; local.i <= local.squad_members.size; local.i++)
                    {
                        local.is_leader = (level.squad_leaders[local.team_idx][local.squad_idx] == local.squad_members[local.i])
                        local.status = (local.squad_members[local.i].isAlive) ? "" : "(Dead)"
                        local.leader_marker = (local.is_leader) ? " (Leader)" : ""
                        println("   " + netname local.squad_members[local.i] + " " + local.status + local.leader_marker)
                    }
                }
            }
        }
    }
end

get_team_idx_internal local.team_name:
    if (local.team_name == "allies")
        end 1
    if (local.team_name == "axis")
        end 2
end 0 // 0 for spectator or unknown

min_val local.a local.b:
    if (local.a < local.b)
        end local.a
end local.b

// ============================================================================
// PREDICATES - Used with array_filter callback pattern
// ============================================================================

// Check if an entity is alive (used by array_filter in promote_new_squad_leader)
is_alive local.entity:
end (local.entity != NIL && local.entity.isAlive == 1)

// Check if entity is alive and not a bot (prefer humans as squad leaders)
is_living_human local.entity:
end (local.entity != NIL && local.entity.isAlive == 1 && !isBot local.entity)

// ============================================================================

start_leader_position_tracking local.leader_entity:
    if (local.leader_entity == NIL)
        end
    
    // Clear any old tracking flag before starting a new thread
    local.leader_entity.squad_stop_tracking = NIL
    // local.leader_entity light 0.9 0.0 0.0 50
    thread track_leader_positions local.leader_entity
    //println ("Squad Mod: Started position tracking for " + netname local.leader_entity)
end

stop_leader_position_tracking local.leader_entity:
    if (local.leader_entity == NIL)
        end
    
    local.leader_entity.squad_stop_tracking = 1
    //println ("Squad Mod: Signaled position tracking to stop for " + netname local.leader_entity)
end

track_leader_positions local.leader_entity:
    if (local.leader_entity == NIL)
        end

    local.leader_entnum = local.leader_entity.entnum
    local.history_index = 1
    local.last_recorded_pos = local.leader_entity.origin
    level.squad_leader_positions[local.leader_entnum][1] = local.last_recorded_pos
    //println("Squad Mod: Initial position for " + netname local.leader_entity + " is " + local.last_recorded_pos)

    while(1)
    {
        wait level.squad_leader_pos_update_interval

        if (!local.leader_entity || local.leader_entity.squad_stop_tracking == 1 || local.leader_entity.health <= 0)
        {
            if (local.leader_entity) { local.leader_entity.squad_stop_tracking = NIL }
            level.squad_leader_positions[local.leader_entnum] = NIL
            //println ("Squad Mod: Stopping tracking for entnum " + local.leader_entnum + " (NIL, flagged, or dead).")
            end
        }

        local.player_squad_data = level.player_squad_info[local.leader_entnum]
        if (local.player_squad_data == NIL)
        {
            level.squad_leader_positions[local.leader_entnum] = NIL
            //println ("Squad Mod: Stopping tracking for entnum " + local.leader_entnum + " (no squad info).")
            end
        }
        local.squad_team_idx = local.player_squad_data["team_idx"]
        local.squad_idx = local.player_squad_data["squad_idx"]

        if (level.squad_leaders[local.squad_team_idx][local.squad_idx] != local.leader_entity)
        {
            level.squad_leader_positions[local.leader_entnum] = NIL
            //println ("Squad Mod: Stopping tracking for entnum " + local.leader_entnum + " (no longer leader of squad " + local.squad_idx + " on team " + local.squad_team_idx + ").")
            end
        }

        // Anticheat honeypot: a bot leader armed as bait is sitting at a lifted,
        // unreachable origin — don't poison the position history with it.
        if (local.leader_entity.is_honeypot) continue

        local.current_pos = local.leader_entity.origin
        if (!(vector_within local.current_pos local.last_recorded_pos level.squad_leader_pos_update_distance))
        {
            local.history_index++
            if (local.history_index > level.squad_leader_pos_history_count)
                local.history_index = 1
            
            level.squad_leader_positions[local.leader_entnum][local.history_index] = local.current_pos
            local.last_recorded_pos = local.current_pos
            //// println("Squad Mod: Updated position for " + netname local.leader_entity + ". History size: " + level.squad_leader_positions[local.leader_entnum].size + " at index " + local.history_index + " to " + local.current_pos)
        }
    }
end

assign_player_to_squad local.player:
    local.player_team_name = local.player.dmteam
    local.player_team_idx = waitthread get_team_idx_internal local.player_team_name

    if (local.player_team_idx == 0)
    {
        //println("Squad Mod: Player " + netname local.player + " is not on a valid team for squad assignment.")
        end NIL // Not on a team that can have squads
    }

    // Try to find a squad with a free slot
    for (local.s_idx = 1; local.s_idx <= level.squad_max_squads_per_team; local.s_idx++)
    {
        if (level.squads[local.player_team_idx][local.s_idx] == NIL)
        {
            level.squads[local.player_team_idx][local.s_idx][1] = local.player
            level.squad_leaders[local.player_team_idx][local.s_idx] = local.player
            
            level.player_squad_info[local.player.entnum]["team_idx"] = local.player_team_idx
            level.player_squad_info[local.player.entnum]["squad_idx"] = local.s_idx
            
            thread start_leader_position_tracking local.player
            thread notify_new_leader local.player
            //println("Squad Mod: Player " + netname local.player + " created and leads squad " + local.s_idx + " on team " + local.player_team_idx)
            end local.player
        }
        else if (level.squads[local.player_team_idx][local.s_idx].size < level.squad_max_players_per_squad)
        {
            level.squads[local.player_team_idx][local.s_idx][level.squads[local.player_team_idx][local.s_idx].size + 1] = local.player
            
            level.player_squad_info[local.player.entnum]["team_idx"] = local.player_team_idx
            level.player_squad_info[local.player.entnum]["squad_idx"] = local.s_idx
            //println("Squad Mod: Player " + netname local.player + " joined squad " + local.s_idx + " on team " + local.player_team_idx)
            end local.player
        }
    }
    //println("Squad Mod: No available squad for player " + netname local.player + " on team " + local.player_team_idx)
    local.player iprint ("All squads are currently full.")
    end NIL // All squads full
end

promote_new_squad_leader local.team_idx local.squad_idx:
    local.old_leader = level.squad_leaders[local.team_idx][local.squad_idx]
    if (local.old_leader != NIL)
    {
        thread stop_leader_position_tracking local.old_leader
    }

    local.current_squad_array = level.squads[local.team_idx][local.squad_idx]
    if (local.current_squad_array == NIL || local.current_squad_array.size == 0)
    {
        level.squad_leaders[local.team_idx][local.squad_idx] = NIL
        //println("Squad Mod: Squad " + local.squad_idx + " on team " + local.team_idx + " is empty. No new leader.")
        end
    }

    // Filter for living members and living humans
    local.living_members = waitthread global/feho/utils.scr::array_filter local.current_squad_array is_alive
    local.living_humans = waitthread global/feho/utils.scr::array_filter local.current_squad_array is_living_human

    if (local.living_members == NIL || local.living_members.size <= 0)
    {
        level.squad_leaders[local.team_idx][local.squad_idx] = NIL
        //println("Squad Mod: Squad " + local.squad_idx + " on team " + local.team_idx + " has no living members. No new leader.")
        end
    }

    // Prefer human players as leaders, fall back to bots
    if (local.living_humans != NIL && local.living_humans.size > 0)
    {
        local.new_leader = waitthread global/feho/utils.scr::array_random local.living_humans
    }
    else
    {
        local.new_leader = waitthread global/feho/utils.scr::array_random local.living_members
    }

    level.squad_leaders[local.team_idx][local.squad_idx] = local.new_leader
    thread start_leader_position_tracking local.new_leader
    thread notify_new_leader local.new_leader
    //println("Squad Mod: " + netname local.new_leader + " is the new leader of squad " + local.squad_idx + " on team " + local.team_idx)
end

// Humans outrank bots: a bot only ever holds the leader slot until a human is
// available. promote_new_squad_leader already prefers humans, but it runs only when
// the leader dies or leaves — so an all-bot squad that a human later joins would keep
// its bot leader until that bot happened to die. This closes that gap at spawn time.
//
// Deliberately NOT reusing promote_new_squad_leader: that picks a RANDOM living human,
// which is right after a death but wrong here — it could displace an existing HUMAN
// leader and hand the squad to some third player. This takes over from a BOT only.
//
// A dead bot leader is included on purpose: get_valid_spawn_pos_near_leader requires
// an isAlive leader, so a dead bot in the slot blocks squad respawn for everyone until
// something else triggers a promotion. Taking over from it immediately restores that.
//
// Returns 1 if local.player leads the squad when this ends (took over or already led
// it), 0 otherwise. No caller currently reads it: the spawn path instead re-reads
// level.squad_leaders after calling this, so its existing "leader != me" guard skips
// the teleport on its own. Kept as a return value for callers that want the answer
// without a second lookup — wiring it into that guard would be redundant, not a fix.
try_human_leader_takeover local.player local.team_idx local.squad_idx:
    if (!local.player || isBot local.player)
        end 0

    local.current_leader = level.squad_leaders[local.team_idx][local.squad_idx]

    // Already leading: nothing to do, but report it so the caller skips the teleport.
    if (local.current_leader == local.player)
        end 1

    // An empty slot is promote_new_squad_leader's job, not a "takeover".
    if (local.current_leader == NIL)
        end 0

    // Humans never displace humans.
    if (!isBot local.current_leader)
        end 0

    // Hand the role over. Stop tracking the bot first: track_leader_positions self-exits
    // when it sees it is no longer the leader, but that check only runs on its next
    // 0.5s tick, and the stale history would stay readable until then.
    thread stop_leader_position_tracking local.current_leader

    level.squad_leaders[local.team_idx][local.squad_idx] = local.player
    thread start_leader_position_tracking local.player
    thread notify_new_leader local.player

    //println("Squad Mod: " + netname local.player + " took leadership of squad " + local.squad_idx + " on team " + local.team_idx + " from bot " + netname local.current_leader)
end 1

// Tell a human they can give hold orders, at the moment it becomes true for them.
// Once per player per map: promotions can happen repeatedly and this would nag.
notify_new_leader local.player:
    if (!local.player || isBot local.player)
        end

    if (local.player.squad_hold_tip_shown == 1)
        end

    local.player.squad_hold_tip_shown = 1

    // Let the promotion/spawn messages clear first.
    wait 2
    if (!local.player)
        end

    local.player iprint ("You lead this squad - aim and press [USE] to order your bots to hold that spot")
end

handle_player_leaving_squad local.player:
    if (local.player == NIL || level.player_squad_info[local.player.entnum] == NIL)
        end

    local.squad_info = level.player_squad_info[local.player.entnum]
    local.team_idx = local.squad_info["team_idx"]
    local.squad_idx = local.squad_info["squad_idx"]

    //println("Squad Mod: Player " + netname local.player + " is leaving squad " + local.squad_idx + " on team " + local.team_idx)

    // Check if player was leader
    if (level.squad_leaders[local.team_idx][local.squad_idx] == local.player)
    {
        // This player was the leader, promote new one before removing them from array
        thread promote_new_squad_leader local.team_idx local.squad_idx
    }

    // Remove player from squad array
    local.current_squad_array = level.squads[local.team_idx][local.squad_idx]
    if (local.current_squad_array != NIL)
    {
        local.new_squad_list = waitthread global/feho/utils.scr::array_remove local.current_squad_array local.player
        level.squads[local.team_idx][local.squad_idx] = local.new_squad_list

        if (local.new_squad_list == NIL || local.new_squad_list.size <= 0)
        {
            level.squads[local.team_idx][local.squad_idx] = NIL // Mark squad as empty
            level.squad_leaders[local.team_idx][local.squad_idx] = NIL // No leader if squad is empty
            //println("Squad Mod: Squad " + local.squad_idx + " on team " + local.team_idx + " is now empty.")
        }
    }

    level.player_squad_info[local.player.entnum] = NIL
end

get_valid_spawn_pos_near_leader local.leader_entity:
    if (local.leader_entity == NIL || !local.leader_entity.isAlive || local.leader_entity.is_under_fire)
        end NIL

    local.pos_history = level.squad_leader_positions[local.leader_entity.entnum]
    if (local.pos_history == NIL || local.pos_history.size < level.squad_max_players_per_squad - 1)
        end NIL

    // Pick a random position from history
    local.random_idx = (randomint(local.pos_history.size) + 1)
    local.base_pos = local.pos_history[local.random_idx]
    local.tentatives = 0

    // The spawner is always on the leader's team, so the leader carries the team context
    // that can_spawn_here needs to tell friend from foe.
    local.team = local.leader_entity.dmteam

    while (!(waitthread can_spawn_here local.base_pos local.team))
    {
        local.tentatives++
        if (local.tentatives > 10)
        {
            //println("Squad Mod: No valid spawn position found near leader " + netname local.leader_entity + " after 10 attempts.")
            end NIL
        }
        //// println("random_idx: " + local.random_idx + " history size: " + local.pos_history.size)
        local.random_idx++
        if (local.random_idx > local.pos_history.size)
            local.random_idx = 1 // Loop back to the start of the history
        local.base_pos = local.pos_history[local.random_idx]
        waitframe
    }
    
    //println("Squad Mod: Valid spawn position found at " + local.base_pos)
    
end local.base_pos // Fallback to the recorded position if trace fails or finds nothing nearby

// Two independent vetoes, both walked in one pass over $player:
//
//  1. Telefrag guard — ANY player (friend or foe, alive or not) within 80 units.
//     Keeps two bodies from materialising inside each other.
//  2. Enemy guard — a LIVING enemy within level.squad_spawn_enemy_radius that also
//     has an unobstructed sight line to the spot. This is the "respawned right in
//     front of a rifle" case.
//
// The sight test is what keeps the enemy guard from being too blunt: an enemy on the
// other side of a wall or a floor is near but can't shoot you, so that spot stays
// usable. Without it, on tight indoor maps most of the leader's history gets vetoed
// and squadmates fall back to the base spawn instead.
//
// $player contains bots as well as humans (see koth.scr:197 — it walks $player and
// filters with isBot), so both are covered by this single loop.
can_spawn_here local.spawn_pos local.team:

	for (local.i = 1; local.i <= $player.size; local.i++)
	{
		local.other = $player[local.i]
		if (!local.other) continue

		if ( (vector_within local.spawn_pos local.other.origin 80) == 1)
		{
            //println("Squad Mod: Spawn position " + local.spawn_pos + " is occupied by player " + netname local.other)
			end 0
		}

		// Corpses and spectators can't shoot. Skipping the dead matters here: a body
		// lying 300 units away would otherwise veto a perfectly safe spot.
		if (!isalive local.other) continue

		// Match the enemy team by name rather than "not my team", so spectators
		// (dmteam "spectator") are never mistaken for a threat.
		if (local.team == "allies")
		{
			if (local.other.dmteam != "axis") continue
		}
		else if (local.team == "axis")
		{
			if (local.other.dmteam != "allies") continue
		}
		else
		{
			continue // Unknown/spectator leader team: no enemy to test against.
		}

		// Cheap distance gate first; only survivors pay for a trace.
		if (!(vector_within local.spawn_pos local.other.origin level.squad_spawn_enemy_radius)) continue

		// Chest-to-chest: origin + 48 on both ends, so the line clears the floor and
		// lands where the spawning player's torso will be, not between their boots.
		//
		// Deliberately NOT gettagposition "Bip01 Head" (as get_crosshair_position uses):
		// that tag is only reliable on an entity whose model is fully loaded, and a bot
		// mid-respawn can return (0 0 0). A trace from the world origin reads as BLOCKED,
		// which would silently disable this veto while still looking like it works.
		// Crouch/prone eye-height error is irrelevant over a 384-unit span anyway.
		//
		// sighttrace returns 1 for a CLEAR line and 0 when something blocks it — the
		// opposite convention from trace (see pk3s_codebase.md:22011).
		if (sighttrace ( local.other.origin + ( 0 0 48 ) ) ( local.spawn_pos + ( 0 0 48 ) ) 1)
		{
            println("Squad Mod: Spawn position " + local.spawn_pos + " is exposed to " + netname local.other)
			end 0
		}
	}

end 1

event_player_spawned:
    local.player = self
    local.player_team_name = local.player.dmteam
    local.current_player_team_idx = waitthread get_team_idx_internal local.player_team_name
    //println("Squad Mod: Player " + netname local.player + " spawned on team " + local.current_player_team_idx)

    // HACK: player is considered alive even if they didn't spawn yet
    if (local.player.isAlive == NIL)
    {
        //println("Squad Mod: Player " + netname local.player + " spawned with isAlive NIL, setting to 0 ~~~~~~~~~~.")
        local.player.isAlive = 0
        end
    }

    if (local.current_player_team_idx == 0) // Spectator or invalid team
    {
        if (level.player_squad_info[local.player.entnum] != NIL)
        {
            // Was in a squad, but now spectator/invalid team, remove them.
            thread handle_player_leaving_squad local.player
        }
        end
    }

    local.player.isAlive = 1

    // Check if player is in a squad and if it's for the correct current team
    local.needs_assignment = 1
    if (level.player_squad_info[local.player.entnum] != NIL)
    {
        local.stored_squad_info = level.player_squad_info[local.player.entnum]
        if (local.stored_squad_info["team_idx"] == local.current_player_team_idx)
        {
            local.needs_assignment = 0 // Already in a squad on the correct team
        }
        else
        {
            // Team changed, remove from old squad first
            //println("Squad Mod: Player " + netname local.player + " changed teams. Removing from old squad.")
            thread handle_player_leaving_squad local.player
            // level.player_squad_info will be NIL now, so assignment will occur
        }
    }

    if (local.needs_assignment == 1 || level.player_squad_info[local.player.entnum] == NIL)
    {
        //println("Squad Mod: Player " + netname local.player + " ("+ local.player.entnum +") needs squad assignment.")
        local.assigned_player = waitthread assign_player_to_squad local.player
        if (local.assigned_player == NIL)
        {
            //println("Squad Mod: Failed to assign " + netname local.player + " to a squad. Spawning normally.")
            end // Could not assign, player spawns normally
        }
    }

    // Player is now in a squad (either newly assigned or was already in one)
    local.player_squad_data = level.player_squad_info[local.player.entnum]
    if (local.player_squad_data == NIL) { end } // Should not happen if assignment worked

    if (!isBot local.player)
    {
        thread update_squad_hud local.player
        thread watch_hold_position_order local.player
    }

    local.squad_team_idx = local.player_squad_data["team_idx"]
    local.squad_idx = local.player_squad_data["squad_idx"]

    // Take the squad over from a bot leader BEFORE reading the leader below: this
    // player may become the leader here, and a leader must not teleport onto the
    // position history of the bot it just replaced. The read below picks up the new
    // leader, so the "local.squad_leader != local.player" guard is false for them and
    // the teleport is skipped — they spawn where they normally would.
    waitthread try_human_leader_takeover local.player local.squad_team_idx local.squad_idx

    local.squad_leader = level.squad_leaders[local.squad_team_idx][local.squad_idx]

    if (local.squad_leader && local.squad_leader != local.player && local.squad_leader.isAlive)
    {
        wait randomfloat(0.5)

        // Wait for any existing lock on this leader to be released.
        while (level.lock[local.squad_leader.entnum] == 1)
        {
            println("Squad Mod: Waiting for lock on squad leader " + netname local.squad_leader + " to be released.")
            wait 0.1
        }

        level.lock[local.squad_leader.entnum] = 1 // Lock to prevent concurrent access from other squad members.
        local.spawn_pos = waitthread get_valid_spawn_pos_near_leader local.squad_leader

        // Anticheat honeypot: don't relocate a bot that is currently armed as bait —
        // it must stay at its hidden, unreachable origin (see anticheat.scr).
        if (local.spawn_pos != NIL && !local.player.is_honeypot)
        {
            //println("Squad Mod: Teleporting " + netname local.player + " near leader " + netname local.squad_leader + " to " + local.spawn_pos)
            local.player tele local.spawn_pos
            //local.player.angles = local.squad_leader.angles // Orient player same as leader
            // MOHAA might automatically unstick player if teleported into something minor.
        }
        else
        {
            //println("Squad Mod: No valid spawn position near leader for " + netname local.player + ". Spawning normally.")
        }

        level.lock[local.squad_leader.entnum] = 0 // Unlock AFTER teleporting to prevent race conditions.
    }
    else if (!local.squad_leader)
    {
        thread promote_new_squad_leader local.squad_team_idx local.squad_idx
    }

    while (local.player && local.player.isAlive)
    {
        if (local.player.dmteam == "spectator")
        {
            //println("Squad Mod: Player " + netname local.player + " is now a spectator. Removing from squad.")
            thread handle_player_leaving_squad local.player
            end
        }
        wait 0.1
    }
end

// ============================================================================
// HOLD-POSITION ORDERS
// ============================================================================
// A human squad leader presses USE to send the squad's bots to whatever their
// crosshair is on. Bots move there and hold for level.squad_hold_duration; the
// duration clock only starts once each bot arrives (engine-side), so travel time
// never eats into the guard time.

// Polls USE for one human player. Started per spawn, ends when they die/leave.
watch_hold_position_order local.player:
    if (!local.player || isBot local.player)
        end

    if (local.player.squad_hold_thread_active == 1)
        end

    local.player.squad_hold_thread_active = 1

    while (local.player && local.player.isAlive && level.player_squad_info[local.player.entnum] != NIL)
    {
        // Edge-triggered: only fire on the press, not every frame USE stays down.
        if (local.player.useheld == 1)
        {
            if (local.player.squad_hold_use_was_down != 1)
            {
                local.player.squad_hold_use_was_down = 1
                thread issue_hold_position_order local.player
            }
        }
        else
        {
            local.player.squad_hold_use_was_down = 0
        }

        waitframe
    }

    if (local.player)
    {
        local.player.squad_hold_thread_active = 0
        local.player.squad_hold_use_was_down = 0
    }
end

issue_hold_position_order local.player:
    if (!local.player || !local.player.isAlive)
        end

    // Only the squad leader gives orders.
    local.squad_info = level.player_squad_info[local.player.entnum]
    if (local.squad_info == NIL)
        end

    local.team_idx = local.squad_info["team_idx"]
    local.squad_idx = local.squad_info["squad_idx"]

    if (level.squad_leaders[local.team_idx][local.squad_idx] != local.player)
        end

    // Rate-limit repeated orders. The cooldown is only consumed once an order actually
    // goes out, so a bomb plant or vehicle entry doesn't block the next real order.
    if (local.player.squad_hold_next_order != NIL && level.time < local.player.squad_hold_next_order)
        end

    // Collect the commandable bots first. USE is also bomb-planting and vehicle-entry,
    // so a leader with no bots must never see order feedback for an unrelated keypress.
    local.squad_members = level.squads[local.team_idx][local.squad_idx]
    if (local.squad_members == NIL)
        end

    local.bots = NIL
    for (local.i = 1; local.i <= local.squad_members.size; local.i++)
    {
        local.member = local.squad_members[local.i]
        if (local.member == NIL || local.member == local.player) continue;
        if (!isBot local.member || !local.member.isAlive) continue;

        // Anticheat honeypot bots must stay at their hidden origin (see anticheat.scr).
        if (local.member.is_honeypot) continue;

        // NIL arrays have no .size, so seed index 1 explicitly (same idiom as array_filter).
        if (local.bots == NIL)
            local.bots[1] = local.member
        else
            local.bots[local.bots.size + 1] = local.member
    }

    if (local.bots == NIL || local.bots.size == 0)
        end

    local.target = waitthread get_crosshair_position local.player
    if (local.target == NIL)
    {
        local.player iprint ("Aim at the ground or a wall to set the hold position.")
        end
    }

    local.player.squad_hold_next_order = level.time + level.squad_hold_cooldown

    // Read the cvar live (bot_queue.scr idiom) so squad_debug can be toggled mid-map.
    if (int(getcvar "squad_debug"))
        thread debug_flash_hold_point local.target

    for (local.i = 1; local.i <= local.bots.size; local.i++)
    {
        local.bots[local.i] bot_holdposition local.target level.squad_hold_duration level.squad_hold_radius
    }

    local.player iprint ("Squad holding position (" + local.bots.size + " bots, " + int(level.squad_hold_duration) + "s)")
end

// Traces from the player's eyes along their view to find the aimed-at point.
// Both traces use the default MASK_SOLID, which ignores entities — so the line
// passes through teammates and hits world geometry instead of stopping on them.
//
// Uses viewangles, NOT forwardvector. forwardvector is SimpleEntity::GetForwardVector,
// which builds the vector from `angles` — the player's BODY angles, whose pitch is
// clamped to zero. The result is a purely horizontal ray, so aiming at the floor
// traced flat ahead and hit the first wall instead. viewangles returns GetVAngles()
// (v_angle), the real look direction including pitch. Same idiom as the binocular
// artillery spotting in the Fire-For-Effect mod (root.scr:193).
//
// The eye also comes from the head tag rather than origin + a constant: the eye is
// not at a fixed height when crouched, prone or on a ladder.
get_crosshair_position local.player:
    if (!local.player)
        end NIL

    local.aim_dir = angles_toforward local.player.viewangles
    local.head = local.player gettagposition "Bip01 Head"

    // Start clear of the player's own bounding box. The head tag sits inside the
    // solid player hull, and a trace beginning in solid can return its start point
    // immediately. (FFE uses the same 64-unit lead-in.)
    local.eye = local.head + local.aim_dir * 64
    local.aim_end = local.head + local.aim_dir * level.squad_hold_max_range

    // trace always returns a vector: the impact point, or aim_end if nothing was hit.
    local.hit = trace local.eye local.aim_end

    // Aiming at open sky gives a point in mid-air, which no bot can stand on.
    if (vector_within local.hit local.aim_end 1)
        end NIL

    // Drop to the floor so the bots get a standable goal even when the crosshair
    // lands on a wall. Starting slightly above the impact avoids starting in solid.
    local.ground = trace ( local.hit + ( 0 0 32 ) ) ( local.hit - ( 0 0 16384 ) )

end local.ground

// Debug only (squad_debug 1): green beam at the point the bots were actually sent to,
// so you can see where an order landed without reading the console.
//
// This is a func_beam — a WORLD entity — so the flash is visible to every player on
// the server, not just the ordering leader. Acceptable behind a debug cvar; do not
// reuse this as player-facing order feedback.
//
// Verb order follows obj_marker.scr: origin and endpoint are set BEFORE activate so
// there's no one-frame streak from the world origin. On a flash this short that
// artifact would be a large fraction of what you see.
debug_flash_hold_point local.pos:
    local.duration = 2

    local.beam = spawn func_beam
    local.beam color ( 0.2 1.0 0.2 )
    local.beam scale 6
    local.beam numsegments 1
    local.beam life 0
    local.beam.origin = local.pos
    local.beam endpoint ( local.pos + ( 0 0 96 ) )
    local.beam activate

    wait local.duration

    // Reap manually rather than relying on life (same as obj_marker.scr::kill).
    if (local.beam)
        local.beam remove
end

event_player_damaged:

    local.squad_info = level.player_squad_info[self.entnum]
    if (!local.squad_info) end
    local.team_idx = local.squad_info["team_idx"]
    local.squad_idx = local.squad_info["squad_idx"]

    if (level.squad_leaders[local.team_idx][local.squad_idx] != self)
        end

    self.is_under_fire = 1
    self.is_under_fire_expiration = level.time + 4
    //println("^3Player " + netname self + " is under fire!")

    if (self.squad_under_fire_thread_active == 1)
        end

    self.squad_under_fire_thread_active = 1

    while (self && level.time < self.is_under_fire_expiration)
    {
        wait 0.1
    }

    if (self)
    {
        self.is_under_fire = 0
        self.squad_under_fire_thread_active = 0
    }

end

event_player_killed:
    local.player = self
    local.player.isAlive = 0
	// local.player light 0.0 0.0 0.0 0
    if (local.player == NIL || level.player_squad_info[local.player.entnum] == NIL)
        end // Not in a squad or invalid player

    //println("Squad Mod: Player " + netname local.player + " killed.")

    local.squad_info = level.player_squad_info[local.player.entnum]
    // Player might have disconnected right before kill event, squad_info could be NIL
    if (local.squad_info == NIL) 
    {
        //println("Squad Mod: Player " + netname local.player + " had no squad info upon death (possibly disconnected).")
        end
    }

    local.team_idx = local.squad_info["team_idx"]
    local.squad_idx = local.squad_info["squad_idx"]

    // Check if the killed player was the squad leader
    if (level.squad_leaders[local.team_idx][local.squad_idx] == local.player)
    {
        //println("Squad Mod: Squad leader " + netname local.player + " was killed. Promoting new leader for squad " + local.squad_idx + " on team " + local.team_idx)
        thread promote_new_squad_leader local.team_idx local.squad_idx
    }
    // Player remains in the squad data structure.
    // They will be removed if they disconnect or change teams.
end

event_player_disconnecting:
    local.player = self
    local.player.isAlive = 0

    if (local.player == NIL || level.player_squad_info[local.player.entnum] == NIL)
        end

    //println("Squad Mod: Player " + netname local.player + " disconnecting. Processing squad leave.")
    thread handle_player_leaving_squad local.player
end

reset:
    for (local.team_idx = 1; local.team_idx <= 2; local.team_idx++)
    {
        if (level.squads[local.team_idx] != NIL)
        {
            for (local.squad_idx = 1; local.squad_idx <= level.squad_max_squads_per_team; local.squad_idx++)
            {
                level.squads[local.team_idx][local.squad_idx] = NIL
                level.squad_leaders[local.team_idx][local.squad_idx] = NIL
            }
        }
    }

    level.squads = NIL
    level.squad_leaders = NIL
    level.player_squad_info = NIL
    level.squad_leader_positions = NIL
end

update_squad_hud local.player:
    if (!local.player || isBot local.player)
        end

    if (local.player.squad_hud_thread_active == 1)
        end

    local.player.squad_hud_thread_active = 1

    local.hud_index_base = 150 // Fixed base index for all players
    local.hud_y_pos = 380
    local.hud_x_pos = 30
    local.team = local.player.dmteam

    // --- Caching variables to prevent unnecessary HUD updates ---
    local.cached_hud_strings = NIL
    local.cached_member_count = 0

    // --- Draw HUD Title (it's static, so we draw it once) ---
    local.title_index = local.hud_index_base
    ihuddraw_font local.player local.title_index "default"
    ihuddraw_align local.player local.title_index "left" "top"
    ihuddraw_rect local.player local.title_index local.hud_x_pos local.hud_y_pos 0 0
    ihuddraw_color local.player local.title_index 0.8 0.8 0.8
    ihuddraw_string local.player local.title_index "SQUAD"
    ihuddraw_alpha local.player local.title_index 1.0

    while (local.player && local.player.dmteam == local.team && level.player_squad_info[local.player.entnum] != NIL)
    {
        local.squad_info = level.player_squad_info[local.player.entnum]
        local.team_idx = local.squad_info["team_idx"]
        local.squad_idx = local.squad_info["squad_idx"]
        local.squad_members = level.squads[local.team_idx][local.squad_idx]
        local.squad_leader = level.squad_leaders[local.team_idx][local.squad_idx]

        if (local.squad_members == NIL)
        {
            thread cleanup_squad_hud local.player local.hud_index_base
            wait 0.5
            continue;
        }

        // --- Update Squad Members (only if changed) ---
        for (local.i = 1; local.i <= local.squad_members.size; local.i++)
        {
            local.member = local.squad_members[local.i]
            if (local.member == NIL) continue;

            local.member_index = local.hud_index_base + local.i
            local.display_name = netname local.member

            // The ">>" marker must stay in the STRING, not just the colour: the cache
            // below is keyed on it, so a colour-only marker would leave the string
            // unchanged on promotion and the previous leader would stay gold all map.
            local.is_leader = (local.member == local.squad_leader)
            if (local.is_leader) {
                local.display_name = ">> " + local.display_name
            }

            // Alive/dead is shown by the row colour, not repeated as text.
            // "(Explosives)" stays: orange alone doesn't say WHAT the player carries.
            local.status_text = ""
            if (local.member.isAlive && local.member.has_the_bomb)
                local.status_text = " (Explosives)"

            local.final_string = local.display_name + local.status_text

            // Key on the string PLUS liveness, not the drawn string alone: with death
            // shown by colour, a plain member's string is identical alive and dead
            // ("Bob" either way), so a string-only key would skip the repaint and leave
            // a dead squadmate drawn green. "== 1" (not int()) because isAlive is NIL
            // before a member's first spawn; NIL and 0 collapse to one key, correctly.
            local.alive_flag = (local.member.isAlive == 1)
            local.cache_key = local.final_string + "|" + local.alive_flag

            // If the cached key is different, update the HUD for that member
            if (local.cached_hud_strings[local.i] != local.cache_key)
            {
                local.y_pos = local.hud_y_pos + 20 + (15 * (local.i - 1))
                ihuddraw_font local.player local.member_index "default"
                ihuddraw_align local.player local.member_index "left" "top"
                ihuddraw_rect local.player local.member_index local.hud_x_pos local.y_pos 0 0
                ihuddraw_string local.player local.member_index local.final_string
                ihuddraw_alpha local.player local.member_index 1.0

                // Colour precedence for a living member: explosives > leader > normal.
                // Carrying the bomb outranks leading because it is the time-critical
                // fact on the row; the ">>" glyph still identifies the leader in that
                // case, so no information is lost when one player is both.
                if (local.member.isAlive) {
                    if (local.member.has_the_bomb)
                        ihuddraw_color local.player local.member_index 1 0.5 0
                    else if (local.is_leader)
                        ihuddraw_color local.player local.member_index 1 0.85 0.2
                    else
                        ihuddraw_color local.player local.member_index 0.5 1 0.5
                } else {
                    ihuddraw_color local.player local.member_index 1 0.5 0.5
                }

                local.cached_hud_strings[local.i] = local.cache_key
            }
        }

        // --- Cleanup HUD elements if squad size shrinks ---
        if (local.cached_member_count > local.squad_members.size)
        {
            for (local.i = local.squad_members.size + 1; local.i <= local.cached_member_count; local.i++)
            {
                 ihuddraw_alpha local.player (local.hud_index_base + local.i) 0.0
                 local.cached_hud_strings[local.i] = NIL
            }
        }
        local.cached_member_count = local.squad_members.size

        wait 0.5
    }

    // --- Cleanup all HUD elements when loop ends ---
    if (local.player)
        local.player.squad_hud_thread_active = 0

    thread cleanup_squad_hud local.player local.hud_index_base
end

cleanup_squad_hud local.player local.hud_index_base:
    if (!local.player) end

    // Clear title + 4 potential members
    for (local.i = 0; local.i <= level.squad_max_players_per_squad; local.i++)
    {
        ihuddraw_alpha local.player (local.hud_index_base + local.i) 0.0
    }
end
