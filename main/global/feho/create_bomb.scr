main local.origin: 
	
	local.MASTER = spawn scriptmaster

	local.MASTER aliascache bomb_drop1 sound/items/Item_BangaloreAssemble_03.wav soundparms 1.0 0.0 1.0 0.0 100 2000 item loaded maps "m dm moh obj train"
	local.MASTER aliascache pickup_bomb1 sound/items/Item_BangalorePickup_01.wav soundparms 1.0 0.0 1.0 0.0 100 2000 item loaded maps "m dm moh obj train"

	level.bomb_model = "models/items/explosive.tik"
	
	local.trigger = spawn trigger_multiple origin local.origin
	local.trigger model level.bomb_model
	local.trigger show
	local.trigger setsize ( -50 -50 0 ) ( 50 50 50 )
	local.trigger thread setup_led
	local.trigger setthread global/feho/bomb.scr::main
	local.trigger droptofloor

end

setup_led:

	self light 1 0 0 65
	self thread setup_icon
	self thread flash_led

end

setup_icon:

	local.icon = spawn func_beam
	local.icon shader "textures/hud/explosives.tga"
	local.icon.origin = self.origin + ( 0 0 30 )
	local.icon endpoint ( self.origin + ( 0 0 43 ) )
	local.icon color ( 1.0 1.0 1.0 )
	local.icon scale 6
	local.icon numsegments 1
	local.icon life 0
	local.icon activate
	self.icon = local.icon

	local.low_offset = 20
	local.high_offset = 42
	local.icon_height = 13

	while (self && local.icon)
	{
		local.z = local.low_offset
		while (local.z <= local.high_offset && self && local.icon)
		{
			local.endpoint_z = local.z + local.icon_height
			local.icon.origin = self.origin + ( 0 0 local.z )
			local.icon endpoint ( self.origin + ( 0 0 local.endpoint_z ) )
			local.step = waitthread get_icon_bob_step local.z local.low_offset local.high_offset
			local.z += local.step
			waitframe
		}

		local.z = local.high_offset
		while (local.z >= local.low_offset && self && local.icon)
		{
			local.endpoint_z = local.z + local.icon_height
			local.icon.origin = self.origin + ( 0 0 local.z )
			local.icon endpoint ( self.origin + ( 0 0 local.endpoint_z ) )
			local.step = waitthread get_icon_bob_step local.z local.low_offset local.high_offset
			local.z -= local.step
			waitframe
		}
	}

	if (local.icon)
		local.icon remove

end

get_icon_bob_step local.z local.low_offset local.high_offset:

	if (local.z <= local.low_offset + 2) end 1
	if (local.z >= local.high_offset - 2) end 1
	if (local.z <= local.low_offset + 8) end 2
	if (local.z >= local.high_offset - 8) end 2

end 2

flash_led:

	while (self)
	{
		self lightOn
		wait 0.08

		if (!self) end

		self lightOff
		wait 1.92
	}

end
