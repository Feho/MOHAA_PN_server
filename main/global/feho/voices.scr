	if (level.voices == 1)
		end
	
	level.voices = 1

	// Array of Allied voices
	level.alliedVoices = makeArray
		allied_sighted
		allied_sighted
		allied_sighted
		allied_sighted
		allied_sighted
		allied_sighted
		allied_sighted
		allied_sighted
		allied_sighted
		allied_sighted
		allied_sighted
		allied_sighted
		allied_sighted
		dfr_attack_10j_1
		dfr_attack_10j_1
		dfr_attack_10j_1
		dfr_attack_10j_1
		dfr_attack_10j_1
		dfr_attack_10j_1
		dfr_attack_10j_1
		dfr_attack_10j_1
		dfr_attack_10j_1
		dfr_attack_10j_1
		dfr_attack_10j_1
		dfr_attack_10j_1
		dfr_attack_10j_1
		dfr_alert_04h_1
		dfr_alert_04h_1
		dfr_directive_215a_2
		dfr_directive_215a_3
		dfr_directive_218c_1
		// dfr_directive_218c_2 // Déployez-vous !
		dfr_directive_217h_1
		dfr_directive_276m_2
		dfr_directive_187j_2
		dfr_directive_194c_1
		dfr_panic_33h_1
		dfr_idle_11h_1
		dfr_idle_20h_1
		dfr_idle_27h_1
		dfr_idle_28h_1
		dfr_idle_31h_1
		dfr_idle_35h_1
		dfr_before_039j_2
		dfr_before_117j_1
		dfr_follow_02j_1
		dfr_follow_01j_1
		dfr_follow_03j_3
		dfr_follow_04j_yell
		dfr_follow_05j_1
		dfr_over_10j_1
		dfr_betrayed_02j_2
		dfr_cover_01j_1
		dfr_cover_01j_1
		dfr_cover_01j_1
		dfr_cover_01j_1
		dfr_cover_01j_1
		dfr_cover_01j_1
		dfr_cover_01j_1
		dfr_cover_01j_1
		dfr_impressed_17j_1
	endArray

	// Array of German voices
	level.axisVoices = makeArray
		axis_sighted
		axis_sighted
		axis_sighted
		den_curious1_10a
		den_curious1_11b
		den_curious1_08b
		den_curious1_12d
		den_curious1_09d
		den_alarm_09a
		den_alarm_09a
		den_alarm_01c
		den_alarm_01c
		den_attack_075d
		den_attack_074b
		den_attack_074b
		den_attack_072b
		den_attack_072b
		den_attack_040b
		den_attack_060b
		den_attack_001c
		den_attack_002c
		den_attack_003d
		den_fear_30b
		den_fear_30d
		den_fear_11c
		den_attack_007d
		den_attack_010c
		den_attack_022e
		snd_den_fer_generic
		Ang_004a
		Ang_007a
		snd_den_laugh_generic_a
		snd_den_laugh_generic_c
		snd_den_laugh_generic_d
		den_disguise_057d
		snd_den_papers_generic
		den_disguise_042d
		snd_den_handsup_generic
	endArray
	
	level waittill spawn
	wait 5

	thread random_player "allies"
	thread random_player "axis"
	
	while (1)
	{
		for (local.i = 1; local.i <= $player.size; local.i++)
		{
			local.p = $player[local.i]
			if (local.p && local.p.useheld && local.p.fireheld && local.p.can_speak != 0 && local.p.needrevive != 1)
			{
				local.p thread play_a_sound
				local.p.can_speak = 0
				local.p thread cooldown_speak
			}
		}

		wait 0.2
	}

end

cooldown_speak:
	wait 3
	if (self)
		self.can_speak = 1
end

// Picks a random team player and plays a sound if they can see an enemy
random_player local.team:

	while (1)
	{
		local.team_players = NIL
		local.enemy_players = NIL
		local.teamCount = 0
		local.enemyCount = 0
		local.totalActive = 0

		for (local.i = 1; local.i <= $player.size; local.i++)
		{
			local.p = $player[local.i]
			if (local.p && isAlive local.p && local.p.dmteam != "spectator")
			{
				local.totalActive++
				if (local.p.dmteam == local.team)
				{
					local.teamCount++
					local.team_players[local.teamCount] = local.p
				}
				else
				{
					local.enemyCount++
					local.enemy_players[local.enemyCount] = local.p
				}
			}
		}

		if (local.teamCount > 0 && local.enemyCount > 0)
		{
			local.randomPlayer = local.team_players[randomint(local.teamCount) + 1]

			if (local.randomPlayer && isAlive local.randomPlayer && local.randomPlayer.can_speak != 0)
			{
				for (local.i = 1; local.i <= local.enemyCount; local.i++)
				{
					local.enemy = local.enemy_players[local.i]
					if (local.enemy && isAlive local.enemy && local.randomPlayer cansee local.enemy 140 4000)
					{
						local.randomPlayer thread play_a_sound
						break
					}
				}
			}
		}
		
		//println("^4Random player thread for team " + local.team + ": totalActive=" + local.totalActive + " teamCount=" + local.teamCount + " enemyCount=" + local.enemyCount)

		// The more players, the shorter the wait
		if (local.totalActive < 3) {
			wait (randomint(21) + 200)
		} else if (local.totalActive < 5) {
			wait (randomint(11) + 50)
		} else if (local.totalActive < 7) {
			wait (randomint(6) + 15)
		} else {
			wait (randomint(6) + 5)
		}
	}

end

// Joue un son aléatoire différent selon la team et le skin du joueur
play_a_sound:

	//println ("[voices.scr::play_a_sound]: Player " + netname self + " playsound")

	if (self.dmteam == "allies")
	{
		switch (self.model)
		{
			case "models/player/american_army.tik":
				//println ("[voices.scr::play_a_sound]: Player " + netname self + " playsound allied_army_sighted")
				self playsound allied_army_sighted
				break

			case "models/player/allied_manon.tik":
				//println ("[voices.scr::play_a_sound]: Player " + netname self + " playsound allied_manon_sighted")
				self playsound allied_manon_sighted
				break

			case "models/player/allied_airborne.tik":
				//println ("[voices.scr::play_a_sound]: Player " + netname self + " playsound allied_airborne_sighted")
				self playsound allied_airborne_sighted
				break

			case "models/player/allied_pilot.tik":
			case "models/player/american_ranger.tik":
				//println ("[voices.scr::play_a_sound]: Player " + netname self + " playsound allied_pilot_sighted")
				self playsound allied_pilot_sighted
				break

			default:
				local.rand = randomint(level.alliedVoices.size) + 1
				//println ("[voices.scr::play_a_sound]: Player " + netname self + " playsound " + level.alliedVoices[local.rand][1])
				self playsound level.alliedVoices[local.rand][1]
		}
	}
	else if (self.dmteam == "axis")
	{
		switch (self.model)
		{
			case "models/player/german_worker.tik":
				//println ("[voices.scr::play_a_sound]: Player " + netname self + " playsound german_worker")
				local.rand = randomint(7)

				if (local.rand == 0 || local.rand == 1)
				{
					self playsound snd_den_laugh_generic_a
				}
				else if (local.rand == 2 || local.rand == 3)
				{
					self playsound snd_den_laugh_generic_c
				}
				else if (local.rand == 4 || local.rand == 5)
				{
					self playsound snd_den_laugh_generic_d
				}
				else if (local.rand == 6)
				{
					self playsound axis_sighted11
				}
				break

			default:
				local.rand = randomint(level.axisVoices.size) + 1
				//println ("[voices.scr::play_a_sound]: Player " + netname self + " playsound " + level.axisVoices[local.rand][1])
				self playsound level.axisVoices[local.rand][1]
		}
	}

end
