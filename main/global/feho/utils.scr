get_random_alive_player:

    local.players = waitthread get_alive_players
	local.p = local.players[randomint(local.players.size) + 1]

end local.p

get_alive_players:

	local.alive_players = NIL

    while (local.alive_players == NIL || local.alive_players.size == 0)
    {
        local.count = 0

        for (local.i = 1; local.i <= $player.size; local.i++)
        {
            local.p = $player[local.i]

            if (isalive local.p && local.p.dmteam != "spectator")
            {
                local.count++
                local.alive_players[local.count] = local.p
            }
        }

        if (local.alive_players.size <= 0) wait 5
    }

end local.alive_players

get_bots:

    local.bot_players = NIL
    local.count = 0

    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        local.p = $player[local.i]

        if (isBot local.p)
        {
            local.count++
            local.bot_players[local.count] = local.p
        }
    }

end local.bot_players

get_human_players:

    local.human_players = NIL
    local.count = 0

    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        local.p = $player[local.i]

        if (!isBot local.p)
        {
            local.count++
            local.human_players[local.count] = local.p
        }
    }

end local.human_players

count_human_players:

    local.count = 0

    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        local.p = $player[local.i]
        if (!isBot local.p) local.count++
    }

end local.count

get_weapon local.p:

	if (!local.p) end
    local.p weaponcommand dual targetname ("w" + local.p.entnum)
    local.weapon = $("w" + local.p.entnum )

    if(local.weapon != NULL)
    {
        local.model = local.weapon.model
        local.weapon targetname ""
    }
    else
    {
        local.model = "models/weapons/unarmed.tik"
    }
				
end local.model

get_weapon_class local.p:

    local.wpn_model = waitthread get_weapon local.p
    waitframe
    local.result = waitthread get_wpnclass local.wpn_model

end local.result

get_wpnclass local.wpn_model:

	switch(local.wpn_model)
	{
		case "models/weapons/m1_garand.tik":
		case "models/weapons/kar98.tik":
			local.result = rifle
		break
		case "models/weapons/kar98sniper.tik":
		case "models/weapons/springfield.tik":
			local.result = sniper
		break
		case "models/weapons/bar.tik":
		case "models/weapons/mp44.tik":
			local.result = mg
		break
		case "models/weapons/thompsonsmg.tik":
		case "models/weapons/mp40.tik":
			local.result = smg
		break
		case "models/weapons/bazooka.tik":
		case "models/weapons/panzerschreck.tik":
			local.result = heavy
		break
		case "models/weapons/shotgun.tik":
			local.result = shotgun
		break
		case "models/weapons/m2frag_grenade.tik":
		case "models/weapons/steilhandgranate.tik":
			local.result = grenade
		break
		case "models/weapons/colt45.tik":
		case "models/weapons/silencedpistol.tik":
		case "models/weapons/p38.tik":
			local.result = pistol
		break
		default:
			local.result = none
		break
	}

end local.result

// ============================================================================
// ARRAY UTILITIES - Higher-order functions using callbacks
// ============================================================================

/*
 * array_filter - Filter an array using a predicate callback
 *
 * Parameters:
 *   local.array     - The array to filter
 *   local.predicate - A function that takes an element and returns 1 (keep) or 0 (discard)
 *
 * Returns: A new array containing only elements where predicate returned 1
 *
 * Example:
 *   local.alive = waitthread global/feho/utils.scr::array_filter local.players is_alive
 */
array_filter local.array local.predicate:
    if (local.array == NIL || local.array.size == 0)
        end NIL

    local.result = NIL
    for (local.i = 1; local.i <= local.array.size; local.i++)
    {
        local.item = local.array[local.i]
        local.passes = waitthread local.predicate local.item
        if (local.passes)
        {
            if (local.result == NIL)
                local.result[1] = local.item
            else
                local.result[local.result.size + 1] = local.item
        }
    }
end local.result

/*
 * array_foreach - Apply a callback to each element in an array
 *
 * Parameters:
 *   local.array    - The array to iterate
 *   local.callback - A function to call with each element
 *
 * Example:
 *   thread global/feho/utils.scr::array_foreach local.players heal_player
 */
array_foreach local.array local.callback:
    if (local.array == NIL)
        end

    for (local.i = 1; local.i <= local.array.size; local.i++)
    {
        if (local.array[local.i] != NIL)
            thread local.callback local.array[local.i]
    }
end

/*
 * array_find - Find the first element matching a predicate
 *
 * Parameters:
 *   local.array     - The array to search
 *   local.predicate - A function that returns 1 when the desired element is found
 *
 * Returns: The first matching element, or NIL if not found
 *
 * Example:
 *   local.leader = waitthread global/feho/utils.scr::array_find local.members is_alive
 */
array_find local.array local.predicate:
    if (local.array == NIL)
        end NIL

    for (local.i = 1; local.i <= local.array.size; local.i++)
    {
        local.item = local.array[local.i]
        if (local.item != NIL && waitthread local.predicate local.item)
            end local.item
    }
end NIL

/*
 * array_remove - Remove a specific element from an array
 *
 * Parameters:
 *   local.array   - The array to modify
 *   local.element - The element to remove
 *
 * Returns: A new array without the specified element
 *
 * Example:
 *   local.new_list = waitthread global/feho/utils.scr::array_remove local.squad local.player
 */
array_remove local.array local.element:
    if (local.array == NIL)
        end NIL

    local.result = NIL
    for (local.i = 1; local.i <= local.array.size; local.i++)
    {
        if (local.array[local.i] != local.element)
        {
            if (local.result == NIL)
                local.result[1] = local.array[local.i]
            else
                local.result[local.result.size + 1] = local.array[local.i]
        }
    }
end local.result

/*
 * array_random - Get a random element from an array
 *
 * Parameters:
 *   local.array - The array to pick from
 *
 * Returns: A random element, or NIL if array is empty
 */
array_random local.array:
    if (local.array == NIL || local.array.size == 0)
        end NIL

    local.idx = randomint(local.array.size) + 1
end local.array[local.idx]

// ============================================================================
// COMMON PREDICATES - Reusable filter functions
// ============================================================================

/*
 * is_alive - Check if an entity is alive and actually in play.
 *
 * Two traps this avoids:
 *
 * 1. `isalive` alone is NOT enough while sv_team_spawn_interval is set (we run 8s
 *    in server.cfg). On death the engine forces the player into spectator and
 *    Player::Spectator() resets deadflag = DEAD_NO and health = max_health so the
 *    queued player isn't processed as a corpse. Script `isalive` is just
 *    `health > 0`, so everyone waiting out the respawn interval reads ALIVE.
 *    self.isSpectator (engine getter -> m_bSpectator || m_bTempSpectator) is the
 *    discriminator: true while queued/spectating, false for a real live player.
 *
 * 2. The old `.isAlive` PROPERTY read was squad.scr's self-labelled HACK
 *    bookkeeping flag (squad.scr:392-409), not engine state -- it is only set on a
 *    player's SECOND spawn and is never cleared for bots. Never read it; call the
 *    engine's `isalive` function instead.
 */
is_alive local.entity:
    if (local.entity == NIL || local.entity == NULL)
        end 0

end (isalive local.entity && !local.entity.isSpectator)

/*
 * is_living_human - Check if entity is alive (see is_alive) and not a bot
 */
is_living_human local.entity:
    if (local.entity == NIL || local.entity == NULL)
        end 0

end (isalive local.entity && !local.entity.isSpectator && !isBot local.entity)
