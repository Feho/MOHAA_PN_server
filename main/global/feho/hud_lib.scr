// Shared HUD helpers for feho mods.
// Builds modern panels and bars on top of ihuddraw_shader using the
// 1x1 black shader tinted via ihuddraw_color.

// Draw a filled rectangle at (x, y) with size (w, h) in player-relative coords.
// rgb is a vector (r g b), each 0..1. alpha is 0..1.
draw_rect local.player local.idx local.halign local.valign local.x local.y local.w local.h local.rgb local.alpha:
	if (local.player == NIL || local.player == NULL) end

	ihuddraw_shader local.player local.idx "textures/mohmenu/black.tga"
	ihuddraw_align local.player local.idx local.halign local.valign
	ihuddraw_rect local.player local.idx local.x local.y local.w local.h
	ihuddraw_color local.player local.idx local.rgb[0] local.rgb[1] local.rgb[2]
	ihuddraw_alpha local.player local.idx local.alpha
end

// Draw a filled rectangle in ANY color. Same signature as draw_rect, but backed
// by textures/common/white.tga (a pure-white 64x64 texel that ships in stock
// Pak2.pk3 on every client — no download required). ihuddraw_color is a multiply,
// so a white base tints cleanly to red/green/blue/etc., unlike black.tga which is
// (0,0,0) and multiplies any color back to black. Use this when you need real
// color; use draw_rect for dark translucent panels.
draw_rect_color local.player local.idx local.halign local.valign local.x local.y local.w local.h local.rgb local.alpha:
	if (local.player == NIL || local.player == NULL) end

	ihuddraw_shader local.player local.idx "textures/common/white.tga"
	ihuddraw_align local.player local.idx local.halign local.valign
	ihuddraw_rect local.player local.idx local.x local.y local.w local.h
	ihuddraw_color local.player local.idx local.rgb[0] local.rgb[1] local.rgb[2]
	ihuddraw_alpha local.player local.idx local.alpha
end

// Global (shared-for-everyone) variant of draw_rect_color. Uses the huddraw_*
// family, which writes ONE HUD seen by all clients — no per-player arg, no loop.
// Use this for HUDs that are identical for every player (e.g. team tickets); use
// the per-player draw_rect_color when content differs per client.
draw_rect_color_global local.idx local.halign local.valign local.x local.y local.w local.h local.rgb local.alpha:
	huddraw_shader local.idx "textures/common/white.tga"
	huddraw_align local.idx local.halign local.valign
	huddraw_rect local.idx local.x local.y local.w local.h
	huddraw_color local.idx local.rgb[0] local.rgb[1] local.rgb[2]
	huddraw_alpha local.idx local.alpha
end

// Hide a previously drawn HUD element.
hide local.player local.idx:
	if (local.player == NIL || local.player == NULL) end
	ihuddraw_alpha local.player local.idx 0.0
end

// Draw a horizontal bar with a translucent backdrop and a colored fill.
// (x, y) is interpreted in the alignment space passed by the caller, matching
// the convention used by surrounding HUD elements so the bar composes with them.
// fill_pct is 0..1. reverse=1 makes the bar drain from right to left.
// Uses two HUD indices: idx (backdrop) and idx+1 (fill).
draw_bar local.player local.idx local.halign local.valign local.x local.y local.w local.h local.fill_pct local.fill_rgb local.reverse:
	if (local.player == NIL || local.player == NULL) end

	if (local.fill_pct < 0) local.fill_pct = 0
	if (local.fill_pct > 1) local.fill_pct = 1

	local.fill_w = int(local.w * local.fill_pct)
	if (local.fill_w < 0) local.fill_w = 0
	if (local.fill_w > local.w) local.fill_w = local.w

	local.bg_rgb = ( 0.08 0.08 0.08 )
	waitthread draw_rect local.player local.idx local.halign local.valign local.x local.y local.w local.h local.bg_rgb 0.55

	if (local.fill_w <= 0)
	{
		ihuddraw_alpha local.player (local.idx + 1) 0.0
		end
	}

	if (local.reverse == 1)
		local.fill_x = local.x + (local.w - local.fill_w)
	else
		local.fill_x = local.x

	waitthread draw_rect local.player (local.idx + 1) local.halign local.valign local.fill_x local.y local.fill_w local.h local.fill_rgb 0.95
end

// Draw a panel (dark backdrop with a colored left-edge accent strip).
// Uses two HUD indices: idx (backdrop) and idx+1 (accent).
draw_panel local.player local.idx local.halign local.valign local.x local.y local.w local.h local.accent_rgb local.alpha:
	if (local.player == NIL || local.player == NULL) end

	local.accent_alpha = local.alpha + 0.3
	if (local.accent_alpha > 1.0) local.accent_alpha = 1.0

	local.bg_rgb = ( 0.05 0.05 0.05 )
	waitthread draw_rect local.player local.idx local.halign local.valign local.x local.y local.w local.h local.bg_rgb local.alpha
	waitthread draw_rect local.player (local.idx + 1) local.halign local.valign local.x local.y 3 local.h local.accent_rgb local.accent_alpha
end

// Estimated pixel width of a string in facfont-20 (the game's proportional HUD
// face), 640-virtual space. facfont-20 has no script-callable width function and
// per-glyph summing isn't practical in .scr, so this is an estimate: ~8 units/glyph
// (between the [A-Za-z] avg of 7.67 and the wider uppercase used in banners).
// Centering via iX = -(width)/2 is therefore approximate — drifts a few px on
// unusually wide/narrow strings. Verified glyph data: see facfont20 memory.
facfont20_width local.str:
	if (local.str == NIL) end 0
end (local.str.size * 8)

// Estimated pixel width of a string in handle-23 (a wider, blockier stock HUD
// face), 640-virtual space. Same estimate approach as facfont20_width. handle-23
// glyphs run ~11.6/ch over [A-Za-z]; uppercase banners ("ENEMY KILLED") average
// ~12, so 12 units/glyph keeps the centering tight on the banner while staying
// generous enough that mixed-case names aren't under-sized. Verified glyph data
// parsed from fonts/handle-23.RitualFont in Pak0.pk3.
handle23_width local.str:
	if (local.str == NIL) end 0
end (local.str.size * 12)

// First local.n characters of a string, for typewriter reveals. MOHAA has no
// substring built-in, but str[i] returns a single CHAR (engine: str(char) ctor
// yields a 1-char string, NOT the ASCII number), so we concatenate. Indexing at
// or past the length THROWS ("String index out of range"), so callers must keep
// local.n within bounds — this clamps defensively too. Returns "" for n <= 0.
substr_prefix local.str local.n:
	if (local.str == NIL) end ""
	if (local.n > local.str.size) local.n = local.str.size
	if (local.n <= 0) end ""

	local.out = ""
	for (local.i = 0; local.i < local.n; local.i++)
		local.out = local.out + local.str[local.i]
end local.out
