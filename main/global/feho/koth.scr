/*
King of the Hill — mid-match event (SKELETON: announce + countdown timer only).

This is build step 2: the activate body loads the per-map preset, announces, runs
a HUD countdown for the configured duration, then cleans up. There is NO capture
scoring or ticket swing yet — those are build steps 3 and 4.

Registers with event_manager.scr. The manager owns the trigger window and picks one
eligible event per round; KotH's eligibility is "this is a ticket map" only.

HUD index base 250 (reserves 250-255), chosen from a repo-wide audit — clear of
tickets (240-248), HVT (160-162), map scripts (<=237), notify/hitmarker (291-303).
*/

main:
    if (level.koth_initialized == 1)
        end
    level.koth_initialized = 1

    // HUD index reserve 250-255 (see header). Layout:
    //   250 bar backdrop, 251 label, 252 countdown, 253 axis fill,
    //   254 allies fill, 255 per-player capture status.
    level.koth_hud_base = 250
    level.koth_duration = 240   // 4 min (within the plan's 3-5 min); tune at playtest

    // --- Capture tuning knobs (see plan "Capture model"). Target: a ~3-body
    // advantage caps an empty zone (0 -> 100) in roughly the back half of the
    // window. 3 * 0.28 * 120s ~= 100. Cap keeps a zerg from instantly capping.
    level.koth_tick           = 0.5    // seconds per capture tick
    level.koth_rate_per_body  = 0.28   // progress %/sec per net body
    level.koth_rate_cap       = 1.4    // max progress %/sec (~5-body net)
    level.koth_draw_threshold = 5      // |progress| below this at end = draw, no swing
    level.koth_swing_pct      = 15     // loser loses this % of starting tickets (auto-scales)
    level.koth_bot_order_interval = 3  // seconds between retries for bots outside the hill

    waitthread global/feho/event_manager.scr::register_event "koth" global/feho/koth.scr::koth_eligible global/feho/koth.scr::koth_activate
end

/*
koth_eligible — pure predicate called by the event manager. NO side effects.
KotH needs a ticket map (g_gametype 4) AND a per-map zone preset. Without the
preset koth_activate bails immediately, which would silently burn the round's one
event slot (no re-roll) — so gate on a hardcoded allowlist of maps that have a
koth_presets/<mapname>.scr. Add a line here when you add a preset. The key matches
getcvar("mapname") (lowercase map id), same value koth_activate uses to load it.
*/
koth_eligible:
    if (int(getcvar "g_gametype") != 4)
        end 0

    local.map = getcvar "mapname"
    if (local.map == "m1l1") end 1
    if (local.map == "m2l2a") end 1
    if (local.map == "m2l2c") end 1
    if (local.map == "dm/mohdm2") end 1
    if (local.map == "dm/mohdm6") end 1
    if (local.map == "dm/mohdm7") end 1

    end 0

/*
koth_activate — the event body the manager waitthreads. Returns when the event
ends (the manager unlocks on return).
*/
koth_activate:
    // Clear any stale outcome from a prior event so an aborted run can't leave a
    // previous winner readable.
    level.koth_winner = NIL

    // 1. Load the per-map preset ONCE. This is the only place it is touched.
    //    Bail cleanly (via cleanup) if there is no preset for this map.
    local.preset = waitexec ("global/feho/koth_presets/" + getcvar("mapname") + ".scr")
    if (local.preset != 1)
    {
        println "[koth]: No preset for this map, skipping."
        waitthread koth_cleanup
        end
    }

    // 2. Spawn the zone marker (visual seam — swap flag/model here later).
    waitthread spawn_zone_marker

    // Give bots the same objective. The generation token prevents a stale loop
    // from a previous activation from issuing orders during a later event.
    if (level.koth_bot_generation == NIL)
        level.koth_bot_generation = 0
    level.koth_bot_generation++
    level.koth_active_bot_generation = level.koth_bot_generation
    level.koth_active = 1
    thread koth_bot_loop level.koth_active_bot_generation

    // 3. Announce loudly (design driver #2).
    waitthread global/feho/notify.scr::show ("KING OF THE HILL - capture " + level.koth_label + "!") "warning" 5.0

    // 4. Capture loop. Tug-of-war: progress in [-100,+100], negative=axis,
    //    positive=allies. Bail without a swing if the round ends mid-event.
    level.koth_progress = 0
    local.delta_cap = level.koth_rate_cap * level.koth_tick

    local.end_time = level.time + level.koth_duration
    while (level.time < local.end_time)
    {
        if (level.tickets_round_over == 1)
        {
            waitthread koth_cleanup
            end
        }

        // Count live, non-spectator bodies of each team inside the zone.
        local.allies_in = waitthread count_zone_bodies "allies"
        local.axis_in   = waitthread count_zone_bodies "axis"
        local.diff = local.allies_in - local.axis_in

        // diff == 0 (contested or empty) -> freeze, no movement (classic tug-of-war).
        if (local.diff != 0)
        {
            local.delta = local.diff * level.koth_rate_per_body * level.koth_tick
            if (local.delta > local.delta_cap)  local.delta = local.delta_cap
            if (local.delta < (0 - local.delta_cap)) local.delta = 0 - local.delta_cap

            level.koth_progress = level.koth_progress + local.delta
            if (level.koth_progress > 100)  level.koth_progress = 100
            if (level.koth_progress < -100) level.koth_progress = -100
        }

        local.remaining = int(local.end_time - level.time)
        waitthread update_koth_hud local.remaining local.allies_in local.axis_in

        wait level.koth_tick
    }

    // 5. End: decide the winner and announce. Ticket swing is wired in step 4.
    //    Re-check round-over here: it can flip between the last loop check and now,
    //    and we must not announce/swing into a round that has already ended.
    if (level.tickets_round_over == 1)
    {
        waitthread koth_cleanup
        end
    }
    waitthread koth_resolve
    waitthread koth_cleanup
end

/*
count_zone_bodies <team> — count live players of <team> standing inside the zone.
Spectators and dead players excluded; bots DO count (they fight too).
*/
count_zone_bodies local.team:
    local.count = 0
    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        local.player = $player[local.i]
        if (!local.player) continue
        if (!isalive local.player) continue
        if (local.player.dmteam != local.team) continue
        if (vector_within level.koth_origin local.player.origin level.koth_radius)
            local.count++
    }
end local.count

/*
koth_bot_loop <generation> — periodically direct live team bots into the inner
half of the hill. Bots already inside the capture radius keep their normal AI.
The retry handles respawns, failed paths, and bots that later leave the zone.
*/
koth_bot_loop local.generation:
    local.move_radius = level.koth_radius * 0.5

    while (level.koth_active == 1 && level.koth_active_bot_generation == local.generation)
    {
        for (local.i = 1; local.i <= $player.size; local.i++)
        {
            local.bot = $player[local.i]
            if (!local.bot) continue
            if (!isBot local.bot) continue
            if (!isalive local.bot) continue
            if (local.bot.dmteam != "allies" && local.bot.dmteam != "axis") continue
            if (vector_within level.koth_origin local.bot.origin level.koth_radius) continue

            local.bot.koth_bot_generation = local.generation
            local.bot bot_movenear level.koth_origin local.move_radius
        }

        wait level.koth_bot_order_interval
    }
end

/*
koth_resolve — at duration end, decide the winner against the draw band and
announce loudly (design driver #3). Stores the outcome for step 4's ticket swing.
  level.koth_winner: "allies" | "axis" | "draw"
*/
koth_resolve:
    // Announce the winner first (the win line plays before the ticket-loss line
    // since notify is FIFO-queued), then apply the loser-only ticket swing.
    // remove_team_tickets_percent self-no-ops if tickets aren't initialized or the
    // round is over, and announces the loss itself via notify (design driver #3).
    // The swing stays here inside koth_resolve — which only runs on a normal end,
    // never on the round-over bail — so level.koth_winner is always current.
    if (level.koth_progress >= level.koth_draw_threshold)
    {
        level.koth_winner = "allies"
        waitthread global/feho/notify.scr::show "ALLIES TOOK THE HILL!" "success" 4.0
        waitthread global/feho/tickets.scr::remove_team_tickets_percent "axis" level.koth_swing_pct "koth" "Lost King of the Hill -"
    }
    else if (level.koth_progress <= (0 - level.koth_draw_threshold))
    {
        level.koth_winner = "axis"
        waitthread global/feho/notify.scr::show "AXIS TOOK THE HILL!" "success" 4.0
        waitthread global/feho/tickets.scr::remove_team_tickets_percent "allies" level.koth_swing_pct "koth" "Lost King of the Hill -"
    }
    else
    {
        level.koth_winner = "draw"
        waitthread global/feho/notify.scr::show "KING OF THE HILL - contested, no winner" "info" 5.0
    }
end

/*
update_koth_hud — draw the shared timer + tug-of-war bar.

This HUD is identical for every player, so it uses the global huddraw_* family.
The old per-player redraw multiplied every command by the human player count and
could backlog HUD updates. Static properties are refreshed once per second so a
client joining during the event receives the complete HUD.

OpenMoHAA centers an element's declared rectangle, not the rendered text. Text
therefore needs a nonzero estimated width; width=0 placed its left edge at screen
center. The bar uses white.tga-backed rects so progress moves smoothly rather than
jumping between text glyphs.

Reads level.koth_progress directly. Index layout (base = 250):
  base+0 : bar backdrop (dark rect, full width)
  base+1 : "KING OF THE HILL" label
  base+2 : remaining-time readout
  base+3 : axis-side fill (red), grows rightward from center
  base+4 : allies-side fill (blue), grows leftward from center
  base+5 : per-player status while inside the zone
The two half-bars meet at screen center, so the filled side shows who is winning.
*/
update_koth_hud local.remaining local.allies_in local.axis_in:
    local.base = level.koth_hud_base
    local.bar_w = 220
    local.bar_h = 12
    local.bar_y = 110
    local.center_gap = 2
    local.half_w = (local.bar_w / 2) - local.center_gap

    // Re-send static state periodically for clients that join after the event starts.
    if (level.koth_hud_next_setup == NIL || level.time >= level.koth_hud_next_setup)
    {
        waitthread global/feho/hud_lib.scr::draw_rect_color_global local.base "center" "top" 0 local.bar_y local.bar_w local.bar_h ( 0.05 0.05 0.05 ) 0.7

        local.title = "KING OF THE HILL"
        local.title_w = waitthread global/feho/hud_lib.scr::facfont20_width local.title
        huddraw_font (local.base + 1) "facfont-20"
        huddraw_align (local.base + 1) "center" "top"
        huddraw_rect (local.base + 1) 0 70 local.title_w 20
        huddraw_color (local.base + 1) 0.95 0.85 0.3
        huddraw_string (local.base + 1) local.title
        huddraw_alpha (local.base + 1) 1.0

        huddraw_font (local.base + 2) "facfont-20"
        huddraw_align (local.base + 2) "center" "top"
        huddraw_color (local.base + 2) 0.95 0.95 0.95
        huddraw_alpha (local.base + 2) 1.0

        level.koth_hud_next_setup = level.time + 1
    }

    local.timer_text = ("" + local.remaining + "s")
    local.timer_w = waitthread global/feho/hud_lib.scr::facfont20_width local.timer_text
    huddraw_rect (local.base + 2) 0 92 local.timer_w 20
    huddraw_string (local.base + 2) local.timer_text

    // Multiply before dividing so progress maps smoothly to pixel width.
    local.allies_w = int((level.koth_progress * local.half_w) / 100)
    if (local.allies_w < 0) local.allies_w = 0
    if (local.allies_w > local.half_w) local.allies_w = local.half_w

    local.axis_w = int(((0 - level.koth_progress) * local.half_w) / 100)
    if (local.axis_w < 0) local.axis_w = 0
    if (local.axis_w > local.half_w) local.axis_w = local.half_w

    if (local.allies_w <= 0)
        huddraw_alpha (local.base + 4) 0.0
    else
    {
        local.allies_x = 0 - local.center_gap - (local.allies_w / 2)
        waitthread global/feho/hud_lib.scr::draw_rect_color_global (local.base + 4) "center" "top" local.allies_x local.bar_y local.allies_w local.bar_h ( 0.375 0.575 0.81 ) 1.0
    }

    if (local.axis_w <= 0)
        huddraw_alpha (local.base + 3) 0.0
    else
    {
        local.axis_x = local.center_gap + (local.axis_w / 2)
        waitthread global/feho/hud_lib.scr::draw_rect_color_global (local.base + 3) "center" "top" local.axis_x local.bar_y local.axis_w local.bar_h ( 0.81 0.34 0.27 ) 1.0
    }

    waitthread update_koth_status_hud local.allies_in local.axis_in
end

/*
update_koth_status_hud <allies_in> <axis_in> — show contextual feedback only
while a human player is alive inside the hill. The last status is cached on the
player so unchanged states do not resend HUD properties every capture tick.
*/
update_koth_status_hud local.allies_in local.axis_in:
    local.idx = level.koth_hud_base + 5

    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        local.player = $player[local.i]
        if (!local.player) continue
        if (isBot local.player) continue

        local.team = local.player.dmteam
        if (!isalive local.player || (local.team != "allies" && local.team != "axis"))
        {
            waitthread hide_koth_status local.player local.idx
            continue
        }

        if (!(vector_within level.koth_origin local.player.origin level.koth_radius))
        {
            waitthread hide_koth_status local.player local.idx
            continue
        }

        if (local.team == "allies")
        {
            local.own_in = local.allies_in
            local.enemy_in = local.axis_in
            local.team_progress = level.koth_progress
        }
        else
        {
            local.own_in = local.axis_in
            local.enemy_in = local.allies_in
            local.team_progress = 0 - level.koth_progress
        }

        if (local.own_in == local.enemy_in)
        {
            local.text = "CONTESTED"
            local.style = "contested"
            local.rgb = ( 1.0 0.75 0.25 )
        }
        else if (local.own_in < local.enemy_in)
        {
            local.text = "LOSING THE HILL"
            local.style = "losing"
            local.rgb = ( 1.0 0.35 0.25 )
        }
        else if (local.team_progress >= 100)
        {
            local.text = "DEFENDING"
            local.style = "defending"
            local.rgb = ( 0.5 1.0 0.5 )
        }
        else
        {
            local.text = "CAPTURING..."
            local.style = "capturing"
            if (local.team == "allies")
                local.rgb = ( 0.45 0.70 1.0 )
            else
                local.rgb = ( 1.0 0.38 0.28 )
        }

        local.key = local.style + ":" + local.team
        if (local.player.koth_status_key == local.key)
            continue

        local.width = waitthread global/feho/hud_lib.scr::facfont20_width local.text
        ihuddraw_font local.player local.idx "facfont-20"
        ihuddraw_align local.player local.idx "center" "top"
        ihuddraw_rect local.player local.idx 0 128 local.width 20
        ihuddraw_color local.player local.idx local.rgb[0] local.rgb[1] local.rgb[2]
        ihuddraw_string local.player local.idx local.text
        ihuddraw_alpha local.player local.idx 1.0
        local.player.koth_status_key = local.key
    }
end

hide_koth_status local.player local.idx:
    if (!local.player) end
    if (local.player.koth_status_key == NIL) end

    ihuddraw_alpha local.player local.idx 0.0
    local.player.koth_status_key = NIL
end

/*
koth_cleanup — single idempotent teardown. Called on EVERY return path of
koth_activate (normal end, round-end bail, missing-preset bail). Guards each
removal on existence so it is safe even before anything is allocated.
*/
koth_cleanup:
    level.koth_active = 0
    local.bot_generation = level.koth_active_bot_generation

    // Cancel only orders issued by this activation. Bots that were never sent
    // toward the hill may still be controlled by map-specific scripts.
    if (local.bot_generation != NIL)
    {
        for (local.i = 1; local.i <= $player.size; local.i++)
        {
            local.bot = $player[local.i]
            if (!local.bot) continue
            if (!isBot local.bot) continue
            if (local.bot.koth_bot_generation != local.bot_generation) continue

            local.bot bot_releasecontrol
            local.bot.koth_bot_generation = NIL
        }
    }
    level.koth_active_bot_generation = NIL

    waitthread remove_zone_marker

    // Hide the shared KotH HUD slots (250-254).
    for (local.i = 0; local.i <= 4; local.i++)
        huddraw_alpha (level.koth_hud_base + local.i) 0.0

    // Index 255 differs per player, so clear it individually.
    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        local.player = $player[local.i]
        if (!local.player) continue
        if (isBot local.player) continue
        ihuddraw_alpha local.player (level.koth_hud_base + 5) 0.0
        local.player.koth_status_key = NIL
    }

    level.koth_hud_next_setup = NIL
end

/*
spawn_zone_marker / remove_zone_marker — the visual-marker seam. Marker model is
TBD (flag/model); isolating it here makes swapping it a one-function change.
SKELETON: a simple vertical beam at the zone origin so the zone is visible in-world.
*/
spawn_zone_marker:
    if (level.koth_marker)
        end

    // Verb order mirrors hvt_event.scr set_avatar (the proven func_beam usage):
    // spawn -> color -> scale -> numsegments -> activate, then endpoint.
    local.marker = spawn func_beam
    local.marker.origin = level.koth_origin
    local.marker color ( 1.0 0.85 0.3 )
    local.marker scale 6
    local.marker numsegments 1
    local.marker activate
    local.marker endpoint (level.koth_origin + ( 0 0 128 ))

    level.koth_marker = local.marker
end

remove_zone_marker:
    if (level.koth_marker)
        level.koth_marker remove
    level.koth_marker = NIL
end
